export function guideText(locale : string, key : string) : string {
	if (locale == 'zh-Hans') return key
	const words = phrases.get(key)
	if (words == null) return key
	return locale == 'en' ? words[0] : words[1]
}

export function useGuideLanguage() {
	const locale = ref(getAppLocale())
	onShow(() => { locale.value = getAppLocale() })
	function g(key : string) : string { return guideText(locale.value, key) }
	return { locale, g }
}
