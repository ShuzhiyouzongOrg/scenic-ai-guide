export type VisitorSession = {
	id : string,
	createdAt : string
}

export type AuthUser = {
	id : string,
	username : string,
	displayName : string,
	role : string
}

export type AuthLoginResult = {
	token : string,
	user : AuthUser
}

export type AuthRegisterResult = {
	userId : string,
	userName : string,
	avatar : string,
	role : string
}

export type AuthProfile = {
	userId : string,
	userName : string,
	realName ?: string,
	nickname ?: string,
	avatar ?: string,
	email ?: string,
	phone ?: string,
	roles : string[]
}

export type ApiEnvelope<T> = {
	ok ?: boolean,
	data ?: T,
	error ?: UTSJSONObject
}

export type ScenicSpot = {
	id : string,
	sourcePointId ?: string,
	targetSpotId ?: string,
	name : string,
	aliases : string[],
	categoryId : string,
	categoryIds ?: string[],
	categoryName : string,
	kind : string,
	latitude : number,
	longitude : number,
	coordinateSystem : string,
	description ?: string,
	detail ?: string,
	media : UTSJSONObject,
	panoramaIds : string[],
	pointLevel ?: number,
	manualReview ?: boolean
}

export type GuideRouteNode = {
	id : string,
	order : number,
	spotId ?: string,
	name : string,
	latitude ?: number,
	longitude ?: number,
	coordinateSystem : string,
	sourcePointId ?: string,
	sourceRouteAnchor ?: MapPoint,
	stayMinutes ?: number,
	minutes ?: number,
	narrationText ?: string
}

export type MapPoint = {
	latitude : number,
	longitude : number,
	coordinateSystem ?: string
}

export type ScenicAreaId = 'lingshan' | 'nianhuawan'

export type MapCoordinateBounds = {
	southwest : MapPoint,
	northeast : MapPoint
}

export type HandDrawnTile = {
	id : string,
	index : number,
	row : number,
	column : number,
	url : string,
	width : number,
	height : number,
	sizeBytes : number,
	bounds : MapCoordinateBounds
}

export type HandDrawnLayerConfig = {
	enabled : boolean,
	rows : number,
	columns : number,
	concurrency : number,
	retries : number,
	bounds : MapCoordinateBounds,
	tiles : HandDrawnTile[]
}

export type MapGuideConfig = {
	center : MapPoint,
	visitorCenter : MapPoint,
	artworkBackgroundColor ?: string,
	rotationDegrees : number,
	minZoom : number,
	maxZoom : number,
	highDpiMaxZoom ?: number,
	initialZoom : number,
	tileLayer : HandDrawnLayerConfig
}

export type ScenicAreaSummary = {
	id : ScenicAreaId,
	name : string,
	shortName : string,
	sourceProject : string
}

export type GuideRoute = {
	id : string,
	name : string,
	description ?: string,
	recommendationReason ?: string,
	durationMinutes ?: number,
	distanceMeters ?: number,
	tags : string[],
	polyline : MapPoint[],
	nodes : GuideRouteNode[],
	isOfficial : boolean,
	isPreciseNavigation ?: boolean,
	geometryKind ?: string,
	source ?: string,
	baseRouteId ?: string
}

export type MapGuideBootstrap = {
	version : string,
	generatedAt : string,
	area : ScenicAreaSummary,
	config : MapGuideConfig,
	categories : UTSJSONObject[],
	spots : ScenicSpot[],
	routes : GuideRoute[],
	panoramas : UTSJSONObject[]
}

export type ChatSource = {
	documentName ?: string,
	sectionTitle ?: string,
	scenicSpotName ?: string
}

export type ChatAnswer = {
	answer : string,
	label ?: string,
	emotion ?: string,
	scenario ?: string,
	sources ?: ChatSource[],
	cached ?: boolean,
	digitalHuman ?: DigitalHumanState
}

export type DigitalHumanState = {
	expression : string,
	action : string,
	state : string,
	ttsEmotion ?: string
}

export type DigitalHumanConfig = {
	id : string,
	name : string,
	engine : string,
	avatarId : string,
	vcn : string,
	speechRate ?: number,
	modelId : string,
	characterAsset : string,
	welcomeText : string,
	emotionStyle : string,
	serviceStatus : string,
	enabled : boolean,
	assetAvailable : boolean
}

export type DigitalHumanWebSession = {
	token : string,
	configId : string,
	pageUrl : string,
	sessionUrl : string,
	bootstrapUrl : string,
	expiresAt : string,
}

export type ConversationMessage = {
	id : string,
	sessionId : string,
	role : string,
	content : string,
	intentLabel ?: string,
	emotionLabel ?: string,
	latencyMs ?: number,
	createdAt : string
}

export type TtsSegment = {
	id : string,
	text : string,
	audioUrl : string,
	mimeType : string,
	durationMs : number
}

export type TtsResult = {
	provider : string,
	voice : string,
	speed : number,
	segments : TtsSegment[],
	audioUrl ?: string,
	latencyMs : number
}

export type VoiceAskResult = {
	transcript : string,
	answer : ChatAnswer,
	tts : TtsResult,
	latency : UTSJSONObject
}

export type RouteRecommendation = {
	id : string,
	name : string,
	routeType : string,
	durationMinutes : number,
	tags : string[],
	suitableFor : string[],
	nodes : GuideRouteNode[],
	explanation : string
}

export type RouteRecommendResult = {
	preferences : UTSJSONObject,
	recommendation : RouteRecommendation,
	alternatives : RouteRecommendation[],
	message : string
}

export type SavedRouteSelection = {
	id : string,
	sessionId : string,
	routeId : string,
	routeName : string,
	routeType : string,
	durationMinutes : number,
	nodeIds : string[],
	tags : string[],
	preferences : UTSJSONObject,
	createdAt : string
}

export type RouteGraphNode = {
	id : string,
	name : string,
	spotId ?: string,
	order : number,
	minutes : number,
	tags : string[]
}

export type RouteGraph = {
	nodes : RouteGraphNode[],
	templates : UTSJSONObject[]
}

export type FeedbackRecord = {
	id : string,
	sessionId : string,
	messageId : string,
	rating ?: number,
	vote : string,
	emotion : string,
	comment : string,
	createdAt : string
}
