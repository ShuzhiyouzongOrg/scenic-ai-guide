export type RuntimeEnvironment = 'development' | 'production'

// 公网 API 已配置与 api.shuzhiyouzong.cn 匹配的 TLS 证书，并将 /api/*
// 反向代理到生产 Node 服务。评测构建统一走 HTTPS，真机不再依赖开发电脑局域网地址。
export const runtimeEnvironment : RuntimeEnvironment = 'production'
export const developmentApiBaseUrl = 'http://127.0.0.1:5178'
export const developmentDeviceApiBaseUrl = 'http://192.168.124.6:5178'
export const productionApiBaseUrl = 'https://api.shuzhiyouzong.cn'

export function getApiBaseUrl() : string {
	if (runtimeEnvironment == 'production') return productionApiBaseUrl
	// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
	return developmentDeviceApiBaseUrl
	// #endif
	return developmentApiBaseUrl
}
