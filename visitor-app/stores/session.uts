import { createVisitorSession } from '@/services/guide-api.uts'

const SESSION_KEY = 'scenic-visitor-session-id'
let pendingSession : Promise<string> | null = null

async function createAndStoreSession() : Promise<string> {
	try {
		const session = await createVisitorSession()
		uni.setStorageSync(SESSION_KEY, session.id)
		return session.id
	} finally { pendingSession = null }
}

export async function ensureVisitorSession() : Promise<string> {
	const cached = getCachedSessionId()
	if (cached.length > 0) return cached
	if (pendingSession == null) pendingSession = createAndStoreSession()
	return await pendingSession!
}

export function getCachedSessionId() : string {
	const value = uni.getStorageSync(SESSION_KEY)
	return value == null ? '' : value as string
}
