import type { RouteRecommendation } from '@/domain/types.uts'

const GUIDE_PROMPT_KEY = 'scenic-guide-pending-prompt'
const MAP_SPOT_KEY = 'scenic-map-pending-spot'
const ACTIVE_ROUTE_KEY = 'scenic-current-route'

function readString(key : string) : string {
	const value = uni.getStorageSync(key)
	return value == null ? '' : value as string
}

export function queueGuidePrompt(prompt : string, area : string = '', spotId : string = '', name : string = '') {
	uni.setStorageSync(GUIDE_PROMPT_KEY, prompt)
	uni.setStorageSync('scenic-guide-place-area', area)
	uni.setStorageSync('scenic-guide-place-id', spotId)
	uni.setStorageSync('scenic-guide-place-name', name)
}

export function currentGuidePlace(area : string) : string[] {
	if (readString('scenic-guide-place-area') != area) return ['', '']
	return [readString('scenic-guide-place-id'), readString('scenic-guide-place-name')]
}

export function openGuideHistory() {
	uni.setStorageSync('scenic-guide-open-history', 'yes')
	uni.switchTab({ url: '/pages/ai-guide/index' })
}

export function consumeHistoryIntent() : boolean {
	if (readString('scenic-guide-open-history') != 'yes') return false
	uni.removeStorageSync('scenic-guide-open-history')
	return true
}

export function consumeGuidePrompt() : string {
	const prompt = readString(GUIDE_PROMPT_KEY)
	if (prompt.length > 0) uni.removeStorageSync(GUIDE_PROMPT_KEY)
	return prompt
}

export function queueMapSpot(spotId : string) {
	uni.setStorageSync(MAP_SPOT_KEY, spotId)
}

export function consumeMapSpot() : string {
	const spotId = readString(MAP_SPOT_KEY)
	if (spotId.length > 0) uni.removeStorageSync(MAP_SPOT_KEY)
	return spotId
}

export function setActiveRoute(route : RouteRecommendation) {
	uni.setStorageSync(ACTIVE_ROUTE_KEY, JSON.stringify(route))
}

export function getActiveRoute() : RouteRecommendation | null {
	const raw = readString(ACTIVE_ROUTE_KEY)
	if (raw.length == 0) return null
	try {
		return JSON.parse<RouteRecommendation>(raw) as RouteRecommendation
	} catch (error) {
		console.error('parse active route failed', error)
		return null
	}
}
