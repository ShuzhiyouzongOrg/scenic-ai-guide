:host {
  display: block;
  width: 100%;
  height: 100%;
}

.scenic-live2d {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #ffffff;
}

.scenic-live2d__canvas {
  display: block;
  width: 100%;
  height: 100%;
  background: transparent;
}

.scenic-live2d__status {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  max-width: 92%;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(241, 246, 252, 0.94);
  transform: translateX(-50%);
}

.scenic-live2d__status--error {
  background: rgba(255, 240, 240, 0.96);
}

.scenic-live2d__status-text {
  display: block;
  overflow: hidden;
  color: #64758b;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  word-break: break-all;
  white-space: normal;
}

.scenic-live2d__status--error .scenic-live2d__status-text {
  color: #b84545;
}
