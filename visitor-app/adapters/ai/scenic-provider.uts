import {
	Chunk,
	CustomProviderAdapter,
	CustomProviderCallbacks,
	RequestAiCoMessage
} from '@/uni_modules/uni-ai-x/types.uts'
import { askQuestion } from '@/services/guide-api.uts'
import { ensureVisitorSession } from '@/stores/session.uts'

/**
 * uni-ai-x 官方自定义 Provider 适配器。
 *
 * 当前先复用现有 `/api/chat/ask` 非流式接口，以保证真实业务闭环可用；
 * 后续将 `/api/chat/stream` 的 SSE 解析接入 onChunkReceived 后，可直接
 * 把多次 onChunk 替换为真实 token 增量，不需要改动 uni-ai-x UI。
 */
export class ScenicGuideProvider extends CustomProviderAdapter {
	override supportsTitleUpdate : boolean = false

	override async request(
		messages : RequestAiCoMessage[],
		model : string,
		chatId : string,
		callbacks : CustomProviderCallbacks
	) : Promise<boolean> {
		try {
			const lastMessage = messages.length > 0 ? messages[messages.length - 1] : null
			if (lastMessage == null || typeof lastMessage.content != 'string') {
				callbacks.onError?.({ errCode: 'INVALID_MESSAGE', errMsg: '缺少可发送的文本消息' } as UTSJSONObject)
				return false
			}
			const sessionId = await ensureVisitorSession()
			const answer = await askQuestion(lastMessage.content as string, sessionId)
			callbacks.onChunk?.({
				choices: [{ delta: { content: answer.answer } }]
			} as Chunk)
			callbacks.onDone?.({ ok: true } as UTSJSONObject)
			return true
		} catch (error) {
			callbacks.onError?.({ errCode: 'SCENIC_API_ERROR', errMsg: '景区 AI 服务请求失败' } as UTSJSONObject)
			return false
		}
	}
}
