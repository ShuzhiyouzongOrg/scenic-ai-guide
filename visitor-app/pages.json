{
	"pages": [
		{
			"path": "pages/home/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "首页"
			}
		},
		{
			"path": "pages/map/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "景区地图",
				"disableScroll": true
			}
		},
		{
			"path": "pages/ai-guide/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "AI导游",
				// #ifdef MP-WEIXIN
				"usingComponents": {
					"scenic-live2d": "/wxcomponents/scenic-live2d/index"
				}
				// #endif
			}
		},
		{
			"path": "pages/trip/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "行程"
			}
		},
		{
			"path": "pages/profile/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "我的"
			}
		}
	],
	"subPackages": [
		{
			"root": "pages/spot",
			"pages": [
				{
					"path": "detail",
					"style": {
						"navigationBarTitleText": "景点详情"
					}
				}
			]
		},
		{
			"root": "pages/auth",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "游客账号"
					}
				}
			]
		},
		{
			"root": "pages/favorites",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "收藏与足迹"
					}
				}
			]
		},
		{
			"root": "pages/feedback",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "意见反馈"
					}
				}
			]
		},
		// #ifndef MP-WEIXIN
		{
			"root": "pages/digital-human",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "讯飞动态数字人"
					}
				}
			]
		}
		// #endif
	],
	"tabBar": {
		"color": "@tabMuted",
		"selectedColor": "@tabActive",
		"backgroundColor": "@surface",
		"borderStyle": "@tabBorder",
		"height": "54px",
		"list": [
			{
				"pagePath": "pages/home/index",
				"text": "首页",
				"iconPath": "@homeIcon",
				"selectedIconPath": "@homeSelected"
			},
			{
				"pagePath": "pages/map/index",
				"text": "地图",
				"iconPath": "@mapIcon",
				"selectedIconPath": "@mapSelected"
			},
			{
				"pagePath": "pages/ai-guide/index",
				"text": "AI导游",
				"iconPath": "@aiIcon",
				"selectedIconPath": "@aiSelected"
			},
			{
				"pagePath": "pages/trip/index",
				"text": "行程",
				"iconPath": "@tripIcon",
				"selectedIconPath": "@tripSelected"
			},
			{
				"pagePath": "pages/profile/index",
				"text": "我的",
				"iconPath": "@profileIcon",
				"selectedIconPath": "@profileSelected"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "@navText",
		"navigationBarTitleText": "数智游踪",
		"navigationBarBackgroundColor": "@surface",
		"backgroundColor": "@background",
		"enablePullDownRefresh": false
	},
	"uniIdRouter": {}
}
