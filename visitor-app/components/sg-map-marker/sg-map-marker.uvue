<template>
	<view class="target" :style="'transform:rotate(' + (-rotation) + 'deg);'" role="button" :aria-label="label" :aria-pressed="selected">
		<view class="pin" :class="selected ? 'pin-selected' : ''"><text v-if="order > 0" class="number">{{ order }}</text></view>
		<text v-if="selected" class="name">{{ label }}</text>
	</view>
</template>
<script setup lang="uts">
	defineProps<{ label : string, order : number, selected : boolean, rotation : number }>()
</script>
