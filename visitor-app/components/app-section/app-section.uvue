<template>
	<view class="section">
		<view class="section-header">
			<view class="section-heading">
				<view class="section-title-row">

					<text class="section-title">{{ title }}</text>
				</view>
				<text v-if="subtitle.length > 0" class="section-subtitle">{{ subtitle }}</text>
			</view>
			<view v-if="actionText.length > 0" class="action" hover-class="pressed" role="button" tabindex="0" data-sg-keyboard="activate" @click="emitAction"><text class="section-action">{{ actionText }}</text></view>
		</view>
		<slot />
	</view>
</template>

<script setup lang="uts">
	type AppSectionProps = {
		title : string,
		subtitle ?: string,
		actionText ?: string
	}

	const props = withDefaults(defineProps<AppSectionProps>(), {
		subtitle: '',
		actionText: ''
	})

	const emit = defineEmits<{
		action: []
	}>()

	function emitAction() {
		emit('action')
	}
</script>

<style lang="scss">
  .section { margin-top: $sg-space-6; }
  .section-header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: $sg-space-3; }
  .section-heading { flex: 1; }
  .section-title { font-size: $sg-type-section; font-weight: 700; color: $sg-text; }
  .section-subtitle { font-size: $sg-type-label; color: $sg-muted; margin-top: $sg-space-1; }
  .action { padding-left: $sg-space-3; min-height: $sg-touch; justify-content: center; }
  .section-action { font-size: $sg-type-label; color: $sg-primary; font-weight: 600; }
  .pressed { opacity: $sg-pressed-opacity; }
</style>
