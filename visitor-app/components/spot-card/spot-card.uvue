<template>
  <view class="spot" :class="pressFeedbackClass" role="button" tabindex="0" data-sg-keyboard="activate" :aria-label="spot.name" hover-class="pressed" :hover-start-time="feedbackDelay" :hover-stay-time="feedbackDelay" @click="openSpot">
    <view class="media">
      <image v-if="photo.length > 0 && !imageFailed" :src="photo" class="image" mode="aspectFill" @error="imageFailed = true" />
      <sg-icon v-else name="location" tone="primary" :size="22" />
    </view>
    <view class="copy">
      <text class="name">{{ spot.name }}</text>
      <text class="category">{{ detail.length > 0 ? detail : spot.categoryName }}</text>
    </view>
    <sg-icon name="right" tone="muted" :size="16" />
  </view>
</template>
<script setup lang="uts">
  import type { ScenicSpot } from '@/domain/types.uts'
  import { spotPhoto } from '@/design/scenic-media.uts'
  import { pressFeedbackClass } from '@/design/motion.uts'
  import { feedbackDelay } from '@/design/palette.uts'
  const props = withDefaults(defineProps<{ spot : ScenicSpot, area ?: string, detail ?: string }>(), { area: 'lingshan', detail: '' })
  const photo = computed<string>(() => spotPhoto(props.spot.id))
  const imageFailed = ref(false)
  function openSpot() {
    uni.navigateTo({url: '/pages/spot/detail?id=' + encodeURIComponent(props.spot.id) + '&area=' + props.area})
  }
</script>
<style lang="scss">
  @import '@/design/press.scss';
  .spot { flex-direction: row; align-items: center; padding: $sg-space-3; min-height: $sg-touch; background-color: $sg-surface; }
  .media { width: 64px; height: 52px; background-color: $sg-inset; overflow: hidden; border-radius: $sg-radius-sm; align-items: center; justify-content: center; }
  .image { width: 100%; height: 100%; }
  .copy { flex: 1; margin: 0 $sg-space-3; }
  .name { color: $sg-text; font-size: $sg-type-body; font-weight: 600; }
  .category { color: $sg-muted; font-size: $sg-type-label; margin-top: $sg-space-1; }
  @include sg-press-feedback;
</style>
