<template>
	<view class="digital-human" :class="compact ? 'digital-human-compact' : ''" @click="handleClick">
		<view class="avatar-shell" :class="compact ? 'avatar-shell-compact' : ''">

			<image class="avatar-image" :class="avatarImageClass" :src="avatarSource" mode="aspectFit" />
			<view v-if="state == 'speaking' && !reducedMotion" class="avatar-mouth" :class="mouthClass"><view class="avatar-mouth-core"></view></view>
			<view v-if="state == 'speaking' && !reducedMotion" class="voice-wave">
				<view class="voice-wave-bar voice-wave-bar-one"></view>
				<view class="voice-wave-bar voice-wave-bar-two"></view>
				<view class="voice-wave-bar voice-wave-bar-three"></view>
			</view>

		</view>
		<view class="digital-copy">
			<view class="digital-title-row">
				<text class="digital-name" :class="compact ? 'digital-name-compact' : ''">{{ title.length > 0 ? title : g('灵小游') }}</text>
				<text class="digital-badge">{{ engineBadge }}</text>
			</view>
			<text class="digital-status">{{ statusText }}</text>
			<text v-if="!compact" class="digital-message">{{ message.length > 0 ? message : g('我可以为你讲解景点、规划路线，也能跟随当前位置提供导览。') }}</text>
		</view>
		<view v-if="compact" class="digital-action"><text class="digital-action-text">{{ actionText.length > 0 ? actionText : g('动态形象') }}</text><text class="digital-action-arrow">›</text></view>
	</view>
</template>

<script setup lang="uts">
	import { guideText } from '@/design/guide-locale.uts'
	function g(key : string) : string { return guideText(props.locale, key) }
	import { reducedMotion } from '@/design/motion.uts'
	type DigitalHumanGuideProps = {
		locale ?: string,
		title ?: string,
		message ?: string,
		state ?: string,
		compact ?: boolean,
		engine ?: string,
		serviceStatus ?: string,
		actionText ?: string,
		avatarSource ?: string
	}
	const emit = defineEmits(['click'])
	const mouthOpen = ref<boolean>(false)
	let mouthTimer : number | null = null

	const props = withDefaults(defineProps<DigitalHumanGuideProps>(), {
		locale: 'zh-Hans',
		title: '',
		message: '',
		state: 'idle',
		compact: false,
		engine: 'xfyun',
		serviceStatus: 'online',
		actionText: '',
		avatarSource: '/static/digital-human/guide-haru-transparent.webp'
	})
	const avatarSource = computed<string>(() => props.avatarSource ?? '/static/digital-human/guide-haru-transparent.webp')

	const engineBadge = computed<string>(() => {
		if (props.engine == 'xfyun') return g('讯飞云')
		if (props.engine == 'local-xfyun') return g('讯飞音色')
		if (props.engine == 'live2d') return g('本地形象')
		return g('数字人')
	})

	const statusText = computed<string>(() => {
		const provider = props.engine == 'xfyun' ? g('讯飞数字人') : (props.engine == 'local-xfyun' ? g('本地动态形象') : g('本地数字人'))
		if (props.state == 'thinking') return provider + ' · ' + g('正在检索景区知识')
		if (props.state == 'speaking') return provider + ' · ' + g('正在为你讲解')
		if (props.state == 'guiding') return provider + ' · ' + g('正在进行景区导览')
		if (props.serviceStatus != 'online') return provider + ' · ' + g('当前使用降级模式')
		return provider + ' · ' + g('服务已接入')
	})

	const avatarImageClass = computed<string>(() => {
		let className = props.compact ? 'avatar-image-compact' : ''
		if (props.state == 'speaking') className += ' avatar-image-speaking'
		else className += ' avatar-image-breathing'
		return className.trim()
	})

	const mouthClass = computed<string>(() => {
		let className = props.compact ? 'avatar-mouth-compact' : ''
		if (mouthOpen.value) className += ' avatar-mouth-open'
		return className.trim()
	})

	function stopMouthAnimation() {
		if (mouthTimer != null) {
			clearInterval(mouthTimer!)
			mouthTimer = null
		}
		mouthOpen.value = false
	}

	watch(() : string => props.state, (state : string) => {
		stopMouthAnimation()
		if (state == 'speaking' && !reducedMotion.value) {
			mouthOpen.value = true
			mouthTimer = setInterval(() => { mouthOpen.value = !mouthOpen.value }, 170)
		}
	})

	watch(reducedMotion, (reduce : boolean) => { if (reduce) stopMouthAnimation() })

	onUnmounted(() => { stopMouthAnimation() })

	function handleClick() {
		emit('click')
	}
</script>

<style lang="scss">
	.digital-human { width: 100%; padding: $sg-space-4; flex-direction: row; align-items: center; overflow: hidden; border-radius: $sg-radius-lg; background-color: $sg-hero; }
	.digital-human-compact { padding: $sg-space-2; border-radius: $sg-radius-md; }
	.avatar-shell { position: relative; width: 88px; height: 104px; flex-shrink: 0; align-items: center; justify-content: center; overflow: hidden; }
	.avatar-shell-compact { width: $sg-touch; height: $sg-touch; }
	.avatar-image { width: 100%; height: 100%; }
	.avatar-mouth { position: absolute; left: 48%; top: 30%; width: 4px; height: 2px; background-color: $sg-accent; }
	.avatar-mouth-open { height: 4px; }
	.voice-wave { position: absolute; bottom: 0; height: 12px; flex-direction: row; align-items: center; }
	.voice-wave-bar { width: 3px; height: 6px; margin-right: 2px; background-color: $sg-on-hero; }
	.voice-wave-bar-two { height: 12px; }
	.voice-wave-bar-three { height: 8px; }
	.digital-copy { flex: 1; min-width: 0; margin-left: $sg-space-2; }
	.digital-title-row { flex-direction: row; align-items: center; flex-wrap: wrap; }
	.digital-name { font-size: $sg-type-card; font-weight: 700; color: $sg-on-hero; }
	.digital-name-compact { font-size: $sg-type-button; }
	.digital-badge, .digital-status, .digital-action-text { font-size: $sg-type-caption; color: $sg-on-hero; }
	.digital-badge { margin-left: $sg-space-2; }
	.digital-status, .digital-message { margin-top: $sg-space-1; color: $sg-on-hero; }
	.digital-message { font-size: $sg-type-label; }
	.digital-action { flex-direction: row; align-items: center; padding-left: $sg-space-2; }
	.digital-action-arrow { font-size: $sg-type-card; color: $sg-on-hero; margin-left: $sg-space-1; }
</style>
