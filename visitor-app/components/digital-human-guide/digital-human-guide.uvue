<template>
	<view class="digital-human" :class="compact ? 'digital-human-compact' : ''" @click="handleClick">
		<view class="avatar-shell" :class="compact ? 'avatar-shell-compact' : ''">
			<view class="avatar-glow" :class="state == 'speaking' ? 'avatar-glow-speaking' : ''"></view>
			<image class="avatar-image" :class="avatarImageClass" src="/static/digital-human/guide-haru-transparent.png" mode="aspectFit" />
			<view v-if="state == 'speaking'" class="avatar-mouth" :class="mouthClass"><view class="avatar-mouth-core"></view></view>
			<view v-if="state == 'speaking'" class="voice-wave">
				<view class="voice-wave-bar voice-wave-bar-one"></view>
				<view class="voice-wave-bar voice-wave-bar-two"></view>
				<view class="voice-wave-bar voice-wave-bar-three"></view>
			</view>
			<view class="avatar-online"></view>
		</view>
		<view class="digital-copy">
			<view class="digital-title-row">
				<text class="digital-name" :class="compact ? 'digital-name-compact' : ''">{{ title }}</text>
				<text class="digital-badge">{{ engineBadge }}</text>
			</view>
			<text class="digital-status">{{ statusText }}</text>
			<text v-if="!compact" class="digital-message">{{ message }}</text>
		</view>
		<view v-if="compact" class="digital-action"><text class="digital-action-text">{{ actionText }}</text><text class="digital-action-arrow">›</text></view>
	</view>
</template>

<script setup lang="uts">
	type DigitalHumanGuideProps = {
		title ?: string,
		message ?: string,
		state ?: string,
		compact ?: boolean,
		engine ?: string,
		serviceStatus ?: string,
		actionText ?: string
	}
	const emit = defineEmits(['click'])
	const mouthOpen = ref<boolean>(false)
	let mouthTimer : number | null = null

	const props = withDefaults(defineProps<DigitalHumanGuideProps>(), {
		title: '灵小游',
		message: '我可以为你讲解景点、规划路线，也能跟随当前位置提供导览。',
		state: 'idle',
		compact: false,
		engine: 'xfyun',
		serviceStatus: 'online',
		actionText: '动态形象'
	})

	const engineBadge = computed<string>(() => {
		if (props.engine == 'xfyun') return '讯飞云'
		if (props.engine == 'local-xfyun') return '讯飞音色'
		if (props.engine == 'live2d') return '本地形象'
		return '数字人'
	})

	const statusText = computed<string>(() => {
		const provider = props.engine == 'xfyun' ? '讯飞数字人' : (props.engine == 'local-xfyun' ? '本地动态形象' : '本地数字人')
		if (props.state == 'thinking') return provider + ' · 正在检索景区知识'
		if (props.state == 'speaking') return provider + ' · 正在为你讲解'
		if (props.state == 'guiding') return provider + ' · 正在进行景区导览'
		if (props.serviceStatus != 'online') return provider + ' · 当前使用降级模式'
		return provider + ' · 服务已接入'
	})

	const avatarImageClass = computed<string>(() => {
		let className = props.compact ? 'avatar-image-compact' : ''
		if (props.state == 'speaking') className += ' avatar-image-speaking'
		else className += ' avatar-image-breathing'
		return className.trim()
	})

	const mouthClass = computed<string>(() => {
		let className = props.compact ? 'avatar-mouth-compact' : ''
		if (mouthOpen.value) className += ' avatar-mouth-open'
		return className.trim()
	})

	function stopMouthAnimation() {
		if (mouthTimer != null) {
			clearInterval(mouthTimer!)
			mouthTimer = null
		}
		mouthOpen.value = false
	}

	watch(() : string => props.state, (state : string) => {
		stopMouthAnimation()
		if (state == 'speaking') {
			mouthOpen.value = true
			mouthTimer = setInterval(() => { mouthOpen.value = !mouthOpen.value }, 170)
		}
	})

	onUnmounted(() => { stopMouthAnimation() })

	function handleClick() {
		emit('click')
	}
</script>

<style>
	.digital-human { min-height: 154px; flex-direction: row; align-items: center; overflow: hidden; padding: 13px 15px 13px 8px; border-radius: 24px; background: linear-gradient(to bottom right, #083f82, #087eaa 62%, #12a8aa); border: 1px solid rgba(255,255,255,0.18); box-shadow: 0 12px 28px rgba(8,70,132,0.20); }
	.digital-human-compact { min-height: 76px; padding: 7px 11px 7px 5px; border-radius: 20px; background: linear-gradient(to right, rgba(5,54,110,0.97), rgba(7,128,159,0.97)); }
	.avatar-shell { position: relative; width: 116px; height: 132px; flex-shrink: 0; align-items: center; justify-content: flex-end; overflow: hidden; }
	.avatar-shell-compact { width: 62px; height: 62px; border-radius: 18px; background-color: rgba(255,255,255,0.10); }
	.avatar-glow { position: absolute; left: 8px; right: 8px; bottom: 0; height: 86px; border-radius: 48px; background-color: rgba(109,235,230,0.22); }
	.avatar-glow-speaking { background-color: rgba(255,205,105,0.34); }
	.avatar-image { position: absolute; width: 174px; height: 132px; bottom: -1px; }
	.avatar-image-compact { width: 92px; height: 70px; bottom: -7px; }
	.avatar-image-breathing { transform-origin: 50% 100%; }
	.avatar-image-speaking { transform-origin: 50% 100%; transform: translateY(-2px) scale(1.025); }
	.avatar-mouth { position: absolute; left: 54px; top: 28px; width: 10px; height: 6px; border-radius: 5px; align-items: center; justify-content: center; background-color: rgba(87,34,48,0.78); }
	.avatar-mouth-open { top: 26px; height: 10px; }
	.avatar-mouth-core { width: 5px; height: 2px; border-radius: 2px; background-color: #f3a7ad; }
	.avatar-mouth-compact { left: 27px; top: 14px; width: 7px; height: 4px; }
	.avatar-mouth-compact.avatar-mouth-open { top: 12px; height: 7px; }
	.avatar-online { position: absolute; right: 8px; bottom: 8px; width: 11px; height: 11px; border-radius: 6px; background-color: #50d999; border: 2px solid #ffffff; }
	.voice-wave { position: absolute; left: 8px; bottom: 8px; height: 22px; padding: 4px 6px; flex-direction: row; align-items: center; border-radius: 11px; background-color: rgba(4,44,92,0.78); }
	.voice-wave-bar { width: 3px; height: 8px; margin: 0 1px; border-radius: 2px; background-color: #ffd885; }
	.voice-wave-bar-two { height: 15px; }
	.voice-wave-bar-three { height: 11px; }
	.digital-copy { flex: 1; margin-left: 8px; }
	.digital-title-row { flex-direction: row; align-items: center; }
	.digital-name { font-size: 19px; font-weight: 800; color: #ffffff; }
	.digital-name-compact { font-size: 15px; }
	.digital-badge { font-size: 9px; color: #704900; padding: 4px 7px; border-radius: 9px; margin-left: 7px; background-color: #ffd885; }
	.digital-status { font-size: 10px; color: #bdeff2; margin-top: 5px; }
	.digital-message { font-size: 12px; line-height: 19px; color: #e8f7ff; margin-top: 9px; }
	.digital-action { flex-direction: row; align-items: center; margin-left: 8px; padding-left: 9px; border-left: 1px solid rgba(255,255,255,0.18); }
	.digital-action-text { font-size: 11px; color: #ffffff; font-weight: 700; }
	.digital-action-arrow { font-size: 19px; color: #ffd885; margin-left: 3px; }
	/* #ifdef MP-WEIXIN || WEB */
	.avatar-image-breathing { animation: avatar-breathe 2.8s ease-in-out infinite; }
	.avatar-image-speaking { animation: avatar-speak 0.62s ease-in-out infinite; }
	.voice-wave-bar { animation: voice-wave 0.72s ease-in-out infinite; }
	.voice-wave-bar-two { animation-delay: 0.16s; }
	.voice-wave-bar-three { animation-delay: 0.32s; }
	@keyframes avatar-breathe { 0%, 100% { transform: translateY(0) scale(1); } 50% { transform: translateY(-3px) scale(1.015); } }
	@keyframes avatar-speak { 0%, 100% { transform: translateY(0) scale(1); } 50% { transform: translateY(-2px) scale(1.025); } }
	@keyframes voice-wave { 0%, 100% { height: 6px; opacity: 0.65; } 50% { height: 15px; opacity: 1; } }
	/* #endif */
</style>
