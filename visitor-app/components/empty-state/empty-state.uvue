<template>
	<view class="empty-state">
    <image v-if="!imageFailed" class="illustration" :src="illustration" mode="aspectFit" aria-hidden="true" @error="imageFailed = true" />
		<view v-else class="empty-icon">
			<sg-icon :name="symbol" :size="24" />
		</view>
		<text class="empty-title">{{ title }}</text>
		<text class="empty-description">{{ description }}</text>
	</view>
</template>

<script setup lang="uts">
	type EmptyStateProps = {
		icon ?: string,
		title : string,
		description : string
	}

	const props = withDefaults(defineProps<EmptyStateProps>(), {
		icon: '◎'
	})
  const symbol = computed<string>(() => {
    if (props.icon == '☆' || props.icon == '♡') return 'star'
    if (props.icon == '⌖' || props.icon == '景') return 'location'
    if (props.icon == '↗') return 'calendar'
    return 'info'
  })
  const illustration = computed<string>(() => props.icon == '!' ? '/static/editorial/state-error.webp' : '/static/editorial/state-empty.webp')
  const imageFailed = ref(false)
  watch(illustration, () => { imageFailed.value = false })
</script>

<style lang="scss">
  .empty-state { align-items: center; padding: $sg-space-6 $sg-space-4; background-color: $sg-surface; border-radius: $sg-radius-md; border: 1px solid $sg-divider; }
  .empty-icon { width: $sg-touch; height: $sg-touch; border-radius: $sg-radius-pill; background-color: $sg-inset; align-items: center; justify-content: center; }
  .illustration { width: 108px; height: 72px; }
  .empty-title { font-size: $sg-type-card; font-weight: 600; color: $sg-text; margin-top: $sg-space-3; text-align: center; }
  .empty-description { font-size: $sg-type-label; color: $sg-muted; text-align: center; margin-top: $sg-space-1; }
</style>
