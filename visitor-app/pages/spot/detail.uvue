<template>
  <scroll-view class="page" :class="themeClass" direction="vertical" :show-scrollbar="false">
    <view class="content">
      <view v-if="loading"><sg-skeleton variant="card" /><text class="status" role="status">{{ t('正在载入景点…','Loading place…','正在載入景點…') }}</text></view>
      <view v-else-if="failed">
        <empty-state icon="!" :title="t('景点暂时无法载入','Couldn’t load this place','景點暫時無法載入')" :description="t('请检查网络后重试。','Check your connection and try again.','請檢查網路後重試。')" />
        <view class="action"><sg-button :label="t('重新载入','Try again','重新載入')" @action="loadSpot" /></view>
      </view>
      <view v-else-if="spot != null">
        <view v-if="coverUrl.length > 0 && !imageFailed" class="photo-frame"><image class="photo" :src="coverUrl" mode="aspectFit" :aria-label="spot!.name" @error="imageFailed = true" /></view>
        <view class="category"><sg-badge :label="guideText(locale, spot!.categoryName)" /></view>
        <sg-page-header :title="spot!.name" />
        <sg-button :label="t('听 AI 讲解','Ask the AI guide','聽 AI 講解')" @action="openGuide" />
        <view class="action"><sg-button kind="secondary" :label="t('在地图上查看','View on map','在地圖上查看')" @action="openMap" /></view>
        <view class="action"><sg-button kind="quiet" :label="favorite ? t('已收藏 · 取消收藏','Remove favorite','已收藏 · 取消收藏') : t('收藏此景点','Save to favorites','收藏此景點')" @action="toggleFavorite" /></view>
        <view class="action"><sg-button kind="quiet" :label="visited ? t('已到访 · 撤销标记','Remove visit','已到訪 · 撤銷標記') : t('标记我已到访','Mark as visited','標記我已到訪')" @action="toggleVisit" /></view>
        <app-section :title="t('景点介绍','About this place','景點介紹')">
          <view class="card"><text class="description">{{ spot!.detail ?? spot!.description ?? t('景区资料正在补充。','The park is preparing more information.','景區資料正在補充。') }}</text></view>
        </app-section>
      </view>
      <view v-else>
        <empty-state icon="⌖" :title="t('景点未找到','Place not found','找不到景點')" :description="t('请在地图中重新选择景点。','Choose another place on the map.','請在地圖中重新選擇景點。')" />
        <view class="action"><sg-button :label="t('打开地图','Open map','開啟地圖')" @action="openMap" /></view>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
  import type { ScenicAreaId, ScenicSpot } from '@/domain/types.uts'
  import { guideText } from '@/design/guide-locale.uts'
  import { fetchScenicSpots } from '@/services/guide-api.uts'
  import { spotPhoto } from '@/design/scenic-media.uts'
  import { getPreferredScenicArea, normalizeScenicAreaId, setPreferredScenicArea } from '@/stores/guide-preferences.uts'
  import { queueGuidePrompt, queueMapSpot } from '@/stores/navigation-context.uts'
  import { getVisitedSpotIds, isFavoriteSpot, recordSpotFootprint, toggleFavoriteSpot, toggleVisitedSpot } from '@/stores/visitor-activity.uts'
  import { getAppLocale, localize } from '@/stores/locale.uts'
  import { themeClass } from '@/design/theme.uts'
  const locale = ref<string>(getAppLocale())
  function t(zh : string, en : string, traditional : string) : string {
    return localize(locale.value, zh, en, traditional)
  }
  const spotId = ref<string>('')
  const area = ref<ScenicAreaId>('lingshan')
  const spot = ref<ScenicSpot | null>(null)
  const favorite = ref(false)
  const visited = ref(false)
  const loading = ref(false)
  const failed = ref(false)
  const imageFailed = ref(false)
  const coverUrl = computed<string>(() => spot.value == null ? '' : spotPhoto(spot.value!.id, true))

  async function loadSpot() {
    if (loading.value || spotId.value.length == 0) return
    loading.value = true
    failed.value = false
    try {
      const spots = await fetchScenicSpots(area.value)
      spot.value = spots.find((item : ScenicSpot) : boolean => item.id == spotId.value) ?? null
      if (spot.value != null) {
        favorite.value = isFavoriteSpot(spotId.value)
        visited.value = getVisitedSpotIds().includes(spotId.value)
        recordSpotFootprint(spotId.value)
      }
    } catch (error) { failed.value = true }
    finally { loading.value = false }
  }
  function toggleFavorite() {
    if (spot.value == null) return
    favorite.value = toggleFavoriteSpot(spotId.value)
    uni.showToast({title: favorite.value ? t('已收藏','Saved','已收藏') : t('已取消收藏','Removed','已取消收藏'), icon:'none'})
  }
  function toggleVisit() {
    if (spot.value != null) visited.value = toggleVisitedSpot(spotId.value)
  }
  function openGuide() {
    if (spot.value == null) return
    const name = spot.value!.name
    setPreferredScenicArea(area.value)
    queueGuidePrompt(t('请讲解' + name + '的历史、主要看点和游览建议。','Tell me about the history, highlights and visiting tips for ' + name + '.','請講解' + name + '的歷史、主要看點和遊覽建議。'), area.value, spotId.value, name)
    uni.switchTab({url:'/pages/ai-guide/index'})
  }
  function openMap() {
    setPreferredScenicArea(area.value)
    if (spot.value != null) queueMapSpot(spotId.value)
    uni.switchTab({url:'/pages/map/index'})
  }
  onLoad((options : OnLoadOptions) => {
    spotId.value = options['id'] ?? ''
    area.value = options['area'] == null ? (spotId.value.startsWith('nianhuawan-') ? 'nianhuawan' : getPreferredScenicArea()) : normalizeScenicAreaId(options['area']!)
    loadSpot()
  })
  onShow(() => {
    locale.value = getAppLocale()
    uni.setNavigationBarTitle({title:t('景点详情','Place details','景點詳情')})
    if (spot.value != null) {
      favorite.value = isFavoriteSpot(spotId.value)
      visited.value = getVisitedSpotIds().includes(spotId.value)
    }
  })
</script>

<style lang="scss">
  @include sg-themes;
  .page { flex: 1; background-color: $sg-background; }
  .content { padding: $sg-space-4 $sg-space-4 $sg-space-8; }
  .card { padding: $sg-space-4; border-radius: $sg-radius-lg; background-color: $sg-surface; border: 1px solid $sg-divider; }
  .action { margin-top: $sg-space-4; }
  .photo-frame { border-radius: $sg-radius-lg; overflow: hidden; background-color: $sg-inset; margin-bottom: $sg-space-4; }
  .photo { width: 100%; height: 184px; }
  .category { align-items: flex-start; }
  .description { color: $sg-text; font-size: $sg-type-body; }
  .status { color: $sg-muted; font-size: $sg-type-label; margin-top: $sg-space-2; }
</style>
