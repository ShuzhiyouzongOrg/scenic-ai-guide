<template>
  <scroll-view class="page" :class="themeClass" direction="vertical" :show-scrollbar="false">
    <view class="content">
      <sg-page-header :title="t('这次导览体验怎么样？','How was your visit?','這次導覽體驗怎麼樣？')" :subtitle="t('你的反馈将帮助景区改进路线说明和导览内容。','Your feedback helps improve the routes and guide content.','你的回饋將幫助景區改善路線說明和導覽內容。')" />
      <view class="card">
        <text class="field-label">{{ t('整体评分','Overall rating','整體評分') }}</text>
        <view class="choices rating-choices">
          <view v-for="value in ratings" :key="value" class="choice-wrap">
            <sg-choice :label="value.toString() + ' · ' + ratingLabel(value)" :selected="rating == value" @action="selectRating(value)" />
          </view>
        </view>
        <!-- #ifdef APP-ANDROID -->
        <view id="visitor-comment-native-label" :flatten="false">
        <!-- #endif -->
        <label id="visitor-comment-label" for="visitor-comment"><text class="field-label">{{ t('意见或建议','Comments','意見或建議') }}</text></label>
        <!-- #ifdef APP-ANDROID -->
        </view>
        <!-- #endif -->
        <textarea id="visitor-comment" class="field comment" v-model="comment" :aria-label="t('意见或建议','Comments','意見或建議')" :placeholder="t('哪些内容有帮助？哪里需要改进？','What worked well? What could be better?','哪些內容有幫助？哪裡需要改善？')" @input="clearError" :placeholder-style="placeholderStyle" :style="fieldStyle" :maxlength="500" :disabled="submitting" :adjust-position="true" />
        <text class="counter">{{ comment.length }}/500</text>
        <text v-if="errorText.length > 0" class="error" role="alert">{{ errorText }}</text>
        <view class="action"><sg-button :label="submitting ? t('正在提交…','Submitting…','正在提交…') : t('提交反馈','Send feedback','送出回饋')" :loading="submitting" @action="submit" /></view>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
  import { submitFeedback } from '@/services/guide-api.uts'
  import { ensureVisitorSession } from '@/stores/session.uts'
  import { themeColor } from '@/design/theme.uts'
  // #ifdef WEB
  import { nameWebField } from '@/design/keyboard.uts'
  onReady(() => { nameWebField('visitor-comment', t('意见或建议','Comments','意見或建議')) })
  // #endif
  // #ifdef APP-ANDROID
  import { bindFormLabel } from '@/uni_modules/scenic-form-label'
  onReady(() => { bindFormLabel('visitor-comment', t('意见或建议','Comments','意見或建議')) })
  // #endif
  import { getAppLocale, localize } from '@/stores/locale.uts'
  import { themeClass } from '@/design/theme.uts'
  const locale = ref<string>(getAppLocale())
  function t(zh : string, en : string, traditional : string) : string {
    return localize(locale.value, zh, en, traditional)
  }
  const ratings = [1, 2, 3, 4, 5]
  const rating = ref<number>(5)
  const comment = ref<string>('')
  const submitting = ref(false)
  const errorText = ref<string>('')
  const fieldStyle = computed<string>(() => 'color:' + themeColor('text'))
  const placeholderStyle = computed<string>(() => 'color:' + themeColor('muted'))
  function clearError() { errorText.value = '' }
  let returnTimer = 0
  let active = true

  function selectRating(value : number) {
    if (submitting.value) return
    rating.value = value
    errorText.value = ''
  }
  function ratingLabel(value : number) : string {
    if (value == 1) return t('很差','Very poor','很差')
    if (value == 2) return t('较差','Poor','較差')
    if (value == 3) return t('一般','Fair','普通')
    if (value == 4) return t('满意','Good','滿意')
    return t('很好','Excellent','很好')
  }
  async function submit() {
    if (submitting.value) return
    if (comment.value.trim().length == 0 && rating.value < 4) {
      errorText.value = t('请告诉我们哪里需要改进。','Tell us what could be improved.','請告訴我們哪裡需要改善。')
      return
    }
    submitting.value = true
    errorText.value = ''
    try {
      const sessionId = await ensureVisitorSession()
      await submitFeedback(sessionId, rating.value, comment.value.trim())
      if (!active) return
      uni.showToast({ title:t('感谢你的反馈','Feedback received','感謝你的回饋'), icon:'success' })
      comment.value = ''
      returnTimer = setTimeout(() => {
        uni.navigateBack({fail: () => uni.switchTab({url:'/pages/profile/index'})})
      }, 500)
    } catch (error) {
      submitting.value = false
      errorText.value = t('提交失败，意见已保留。请检查网络后重试。','Your feedback is still here. Check your connection and try again.','提交失敗，意見已保留。請檢查網路後重試。')
    }
  }
  onShow(() => {
    locale.value = getAppLocale()
    uni.setNavigationBarTitle({title: t('意见反馈','Feedback','意見回饋')})
  })
  onUnload(() => { active = false; clearTimeout(returnTimer) })
</script>

<style lang="scss">
  @include sg-themes;
  .page { flex: 1; background-color: $sg-background; }
  .content { padding: $sg-space-4 $sg-space-4 $sg-space-8; }
  .card { padding: $sg-space-4; border-radius: $sg-radius-lg; background-color: $sg-surface; border: 1px solid $sg-divider; }
  .action { margin-top: $sg-space-4; }
  .choices { flex-direction: row; flex-wrap: wrap; margin: 0 0 $sg-space-3; }
  .choice-wrap { margin: 0 $sg-space-2 $sg-space-2 0; }
  .field-label { color: $sg-text; font-size: $sg-type-body; font-weight: 600; }
  .field { margin-top: $sg-space-2; margin-bottom: $sg-space-4; min-height: $sg-touch; padding: $sg-space-2 $sg-space-3; border-radius: $sg-radius-md; border: 1px solid $sg-border; background-color: $sg-background; color: $sg-text; font-size: $sg-type-body; }
  .error { margin: $sg-space-2 0; color: $sg-error; font-size: $sg-type-label; }
  .rating-choices { margin-top: $sg-space-2; }
  .comment { width: auto; align-self: stretch; height: 128px; margin-bottom: $sg-space-1; }
  .counter { color: $sg-muted; font-size: $sg-type-caption; text-align: right; }
</style>
