</template>

<script setup lang="uts">
	import type { ScenicSpot } from '@/domain/types.uts'
	import { fetchScenicSpots } from '@/services/guide-api.uts'

	const loading = ref<boolean>(true)
	const spots = ref<ScenicSpot[]>([])

	async function loadSpots() {
		loading.value = true
		try {
			const data = await fetchScenicSpots()
			spots.value = data.filter((item : ScenicSpot) : boolean => item.kind == 'scenic').slice(0, 8)
		} catch (error) {
			console.error('load scenic spots failed', error)
			spots.value = []
		} finally {
			loading.value = false
		}
	}

	function openGuide() { uni.switchTab({ url: '/pages/ai-guide/index' }) }
	function openMap() { uni.switchTab({ url: '/pages/map/index' }) }
	function openTrip() { uni.switchTab({ url: '/pages/trip/index' }) }
	function openFavorites() { uni.navigateTo({ url: '/pages/favorites/index' }) }

	onLoad(() => { loadSpots() })
</script>

