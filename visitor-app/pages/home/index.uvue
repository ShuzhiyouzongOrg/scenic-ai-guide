				<view v-if="loading" class="loading-card">
					<rice-loading mode="circle" color="#0b68d0" />
					<text class="loading-text">正在加载景区数据</text>
				</view>
				<scroll-view v-else-if="spots.length > 0" class="spot-scroll" direction="horizontal" :show-scrollbar="false">
					<spot-card v-for="spot in spots" :key="spot.id" :spot="spot" />
				</scroll-view>
				<empty-state v-else icon="景" title="景点数据尚未连接" description="确认 Node 服务与当前设备网络连通后，重新进入页面即可载入真实景点。" />
