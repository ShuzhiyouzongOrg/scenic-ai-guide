<template>
  <scroll-view class="page" :class="themeClass" direction="vertical" :show-scrollbar="false">
    <view class="content">
      <view class="top" :style="headerStyle">
        <sg-page-header :title="t('发现无锡', 'Explore Wuxi', '發現無錫')" :subtitle="t('数智游踪 · 景区导览', 'Scenic AI Guide', '數智遊蹤 · 景區導覽')" />
      </view>
      <view class="areas">
        <view class="chip"><sg-choice :label="t('灵山胜境', 'Lingshan', '靈山勝境')" :selected="area == 'lingshan'" @action="selectArea('lingshan')" /></view>
        <sg-choice :label="t('拈花湾', 'Nianhua Bay', '拈花灣')" :selected="area == 'nianhuawan'" @action="selectArea('nianhuawan')" />
      </view>
      <view class="destination" :class="pressFeedbackClass" role="button" tabindex="0" data-sg-keyboard="activate" :aria-label="destinationName + ' ' + mapLabel" hover-class="pressed" :hover-start-time="feedbackDelay" :hover-stay-time="feedbackDelay" @click="openMap">
        <image class="hero-photo" :src="area == 'nianhuawan' ? '/static/destinations/nianhuawan.webp' : '/static/destinations/lingshan.webp'" mode="aspectFill" />
        <view class="destination-caption">
          <view class="destination-text">
            <text class="destination-title">{{ destinationName }}</text>
            <text class="destination-detail">{{ area == 'nianhuawan' ? t('小镇街巷与水岸漫步', 'Town lanes and waterside walks', '小鎮街巷與水岸漫步') : t('山麓间的佛像与寺院', 'Temples in the Lingshan foothills', '山麓間的佛像與寺院') }}</text>
          </view>
          <text class="destination-action">{{ mapLabel }}</text>
        </view>
      </view>
      <app-section :title="t('随行服务', 'Travel tools', '隨行服務')">
        <view class="features">
          <view class="feature first"><sg-editorial-card src="/static/editorial/guide.webp" :title="t('AI 导游', 'AI guide', 'AI 導遊')" @action="openGuide" /></view>
          <view class="feature"><sg-editorial-card src="/static/editorial/trip.webp" :title="t('规划行程', 'Plan a trip', '規劃行程')" @action="openTrip" /></view>
        </view>
      </app-section>
      <app-section :title="t('热门目的地', 'Destination highlights', '熱門目的地')" :subtitle="t('按景点入选景区官方路线的次数排列', 'Places featured most often on official routes', '按景點入選景區官方路線的次數排列')">
        <sg-skeleton v-if="loading || routesLoading" variant="row" />
        <view v-else-if="routesFailed || failed">
          <empty-state icon="!" :title="t('目的地暂时无法加载','Highlights could not load','目的地暫時無法載入')" :description="t('可重试或打开景区地图。','Try again or open the map.','可重試或打開景區地圖。')" />
          <sg-button kind="quiet" :label="t('重试','Try again','重試')" @action="retryHighlights" />
        </view>
        <view v-else-if="highlights.length > 0" class="group">
          <view v-for="(place,index) in highlights" :key="place.spot.id">
            <sg-divider v-if="index > 0" />
            <spot-card :spot="place.spot" :area="area" :detail="routeCountLabel(place.count)" />
          </view>
        </view>
        <empty-state v-else icon="景" :title="t('暂无路线推荐地点','No highlights on these routes yet','暫無路線推薦地點')" :description="t('仍可按景点浏览。','You can still browse individual places.','仍可按景點瀏覽。')" />
      </app-section>
      <app-section :title="t('景点推荐', 'Places to visit', '景點推薦')" :action-text="t('查看地图', 'View map', '查看地圖')" @action="openMap">
        <sg-skeleton v-if="loading" variant="row" />
        <view v-else-if="failed">
          <empty-state icon="!" :title="t('暂时无法加载景点', 'Places could not load', '暫時無法載入景點')" :description="t('检查网络后可以重试。', 'Check your connection and try again.', '檢查網路後可以重試。')" />
          <view class="retry"><sg-button :label="t('重新加载', 'Try again', '重新載入')" kind="secondary" @action="loadSpots" /></view>
        </view>
        <view v-else-if="recommendations.length > 0" class="group">
          <view v-for="(spot, index) in recommendations" :key="spot.id"><sg-divider v-if="index > 0" /><spot-card :spot="spot" :area="area" :detail="guideText(locale,spot.categoryName)" /></view>
        </view>
        <empty-state v-else icon="景" :title="t('暂无推荐景点', 'No featured places yet', '暫無推薦景點')" :description="t('可继续使用景区地图和 AI 导游。', 'The map and AI guide are available.', '可繼續使用景區地圖和 AI 導遊。')" />
      </app-section>
      <app-section v-if="services.length > 0" :title="t('特色旅游服务','Visitor services','特色旅遊服務')">
        <view class="group"><view v-for="(service,index) in services" :key="service.id">
          <sg-divider v-if="index > 0" />
          <sg-service-row icon="location" :title="service.name" :detail="guideText(locale, service.categoryName)" @action="openService(service)" />
        </view></view>
      </app-section>
      <view class="group favorites"><sg-service-row icon="star" :title="t('收藏与最近浏览', 'Saved and recently viewed', '收藏與最近瀏覽')" @action="openFavorites" /></view>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import type { GuideRoute, GuideRouteNode, ScenicAreaId, ScenicSpot } from '@/domain/types.uts'
  import { fetchScenicSpots, fetchGuideRoutes } from '@/services/guide-api.uts'
  import { getPreferredScenicArea, setPreferredScenicArea } from '@/stores/guide-preferences.uts'
  import { getAppLocale, localize } from '@/stores/locale.uts'
  import { themeClass } from '@/design/theme.uts'
  import { guideText } from '@/design/guide-locale.uts'
  import { spotPhoto } from '@/design/scenic-media.uts'
  import { useScenicInsets } from '@/design/layout.uts'
  import { feedbackDelay } from '@/design/palette.uts'
  import { pressFeedbackClass } from '@/design/motion.uts'
  const { headerStyle } = useScenicInsets()

  const locale = ref('zh-Hans')
  const area = ref<ScenicAreaId>('lingshan')
  const spots = ref<ScenicSpot[]>([])
  const routes = ref<GuideRoute[]>([])
  const services = ref<ScenicSpot[]>([])
  const routesLoading = ref(true)
  const routesFailed = ref(false)
  let routeRequest = 0
  const loading = ref(true)
  const failed = ref(false)
  let loadedArea = ''
  let requestNumber = 0
  function t(zh : string, en : string, hant : string) : string { return localize(locale.value, zh, en, hant) }
  const destinationName = computed<string>(() => area.value == 'nianhuawan' ? t('拈花湾', 'Nianhua Bay', '拈花灣') : t('灵山胜境', 'Lingshan', '靈山勝境'))
  const mapLabel = computed<string>(() => t('打开地图', 'Open map', '開啟地圖'))
  type Highlight = { spot : ScenicSpot, count : number }
  const highlights = computed<Highlight[]>(() => {
    const output : Highlight[] = []
    spots.value.forEach((spot : ScenicSpot) => {
      const count = routes.value.filter((route : GuideRoute) : boolean =>
        route.isOfficial && route.nodes.some((node : GuideRouteNode) : boolean =>
          node.spotId == spot.id || (spot.sourcePointId != null && node.sourcePointId == spot.sourcePointId)
        )
      ).length
      if (count > 0) output.push({ spot, count } as Highlight)
    })
    return output.sort((a : Highlight, b : Highlight) : number => {
      if (a.count != b.count) return b.count - a.count
      const hasA = spotPhoto(a.spot.id).length > 0
      const hasB = spotPhoto(b.spot.id).length > 0
      return hasA == hasB ? 0 : (hasA ? -1 : 1)
    }).slice(0,3)
  })
  const recommendations = computed<ScenicSpot[]>(() =>
    spots.value.filter((spot : ScenicSpot) : boolean => !highlights.value.some((item : Highlight) : boolean => item.spot.id == spot.id)).slice(0,8)
  )
  function routeCountLabel(count : number) : string {
    const n = count.toString()
    return t('入选 ' + n + ' 条官方路线', n + (count == 1 ? ' official route' : ' official routes'), '入選 ' + n + ' 條官方路線')
  }
  async function loadRoutes() {
    const current = ++routeRequest
    routesLoading.value = true
    routesFailed.value = false
    try {
      const result = await fetchGuideRoutes(area.value)
      if (current == routeRequest) routes.value = result
    } catch (error) {
      if (current == routeRequest) routesFailed.value = true
    } finally { if (current == routeRequest) routesLoading.value = false }
  }
  function retryHighlights() {
    if (failed.value) loadSpots()
    if (routesFailed.value) loadRoutes()
  }
  function loadArea() {
    routes.value = []
    spots.value = []
    services.value = []
    loadSpots()
    loadRoutes()
  }
  async function loadSpots() {
    const current = ++requestNumber
    const requestedArea = area.value
    loading.value = true
    failed.value = false
    try {
      const result = await fetchScenicSpots(requestedArea)
      if (current != requestNumber) return
      const scenic = result.filter((item : ScenicSpot) : boolean => item.kind == 'scenic')
      spots.value = scenic
      const ids = requestedArea == 'nianhuawan' ? ['nianhuawan-176','nianhuawan-182','nianhuawan-527'] : ['lingshan-806','lingshan-904']
      services.value = result.filter((spot : ScenicSpot) : boolean => spot.kind == 'facility' && ids.includes(spot.id))
      loadedArea = requestedArea
    } catch (error) {
      if (current != requestNumber) return
      failed.value = true
    } finally { if (current == requestNumber) loading.value = false }
  }
  function selectArea(next : ScenicAreaId) {
    if (next == area.value) return
    area.value = next
    setPreferredScenicArea(next)
    loadArea()
  }
  function openGuide() { uni.switchTab({ url: '/pages/ai-guide/index' }) }
  function openTrip() { uni.switchTab({ url: '/pages/trip/index' }) }
  function openMap() { uni.switchTab({ url: '/pages/map/index' }) }
  function openFavorites() { uni.navigateTo({ url: '/pages/favorites/index' }) }
  function openService(service : ScenicSpot) { uni.navigateTo({ url: '/pages/spot/detail?id=' + encodeURIComponent(service.id) + '&area=' + area.value }) }
  onShow(() => {
    locale.value = getAppLocale()
    const preferred = getPreferredScenicArea()
    const changed = preferred != area.value
    area.value = preferred
    if (changed || area.value != loadedArea) loadArea()
    else retryHighlights()
  })
</script>
<style lang="scss">
  @include sg-themes;
  .page { flex: 1; background-color: $sg-background; }
  .content { padding: 0 $sg-space-5 $sg-space-8; }
  .areas, .features, .destination-caption { flex-direction: row; align-items: center; }
  .areas { margin: $sg-space-3 0; }
  .chip, .first { margin-right: $sg-space-2; }
  .destination { border-radius: $sg-radius-lg; overflow: hidden; background-color: $sg-hero; }
  .hero-photo { width: 100%; height: 176px; }
  .destination-caption { padding: $sg-space-4; }
  .destination-text, .feature { flex: 1; }
  .destination-title { color: $sg-on-hero; font-size: $sg-type-section; font-weight: 700; }
  .destination-detail { color: $sg-on-hero; font-size: $sg-type-label; margin-top: $sg-space-1; }
  .destination-action { color: $sg-on-hero; font-size: $sg-type-label; font-weight: 600; margin-left: $sg-space-3; }
  .group { border: 1px solid $sg-divider; border-radius: $sg-radius-md; overflow: hidden; background-color: $sg-surface; }
  .favorites { margin-top: $sg-space-6; }
  .retry { margin-top: $sg-space-2; }
  @import '@/design/press.scss';
  @include sg-press-feedback;
</style>
