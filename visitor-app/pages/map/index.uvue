<template>
	<view class="page" :class="themeClass" :style="pageBackgroundStyle">
		<view class="map-header" :style="mapTopStyle">
			<view class="map-title-row">
				<view class="map-title-group"><text class="map-title">{{ activeAreaName }}</text><text class="map-meta">{{ mapMode == 'artwork' ? g('手绘导览') : g('导航地图') }} · {{ spotCountLabel }}</text></view>
				<sg-button :label="g('定位')" kind="quiet" @action="locateMe" />
				<sg-button :label="headerExpanded ? g('收起') : g('筛选')" kind="secondary" @action="toggleHeader" />
			</view>
			<scroll-view v-if="headerExpanded" class="map-filters" direction="vertical">
				<view class="filter-row">
					<sg-choice :label="g('灵山胜境')" :selected="activeAreaId == 'lingshan'" @action="switchScenicArea('lingshan')" />
					<sg-choice :label="g('拈花湾')" :selected="activeAreaId == 'nianhuawan'" @action="switchScenicArea('nianhuawan')" />
				</view>
				<rice-search :model-value="keyword" :placeholder="g('搜索景点或类别')" shape="round" @input="onSearchInput" @search="submitSearch" @clear="clearSearch" />
				<view v-if="keyword.trim().length > 0" class="search-results">
					<text v-if="visibleSpots.length == 0" class="map-meta">{{ g('没有匹配景点，试试别称或清空搜索') }}</text>
					<sg-button v-for="spot in visibleSpots" :key="spot.id" :label="spot.name" kind="quiet" @action="selectSearchSpot(spot)" />
				</view>
				<view class="filter-row">
					<sg-choice :label="g('手绘导览')" :selected="mapMode == 'artwork'" @action="setMapMode('artwork')" />
					<sg-choice :label="g('导航地图')" :selected="mapMode == 'native'" @action="setMapMode('native')" />
				</view>
				<view class="filter-row">
					<sg-choice v-for="route in routeOptions" :key="route.id" :label="route.name" :selected="activeGuideRoute?.id == route.id" @action="selectGuideRoute(route.id)" />
				</view>
			</scroll-view>
			<text v-if="activeGuideRoute != null" class="route-caption">{{ activeGuideRoute!.name }}{{ routeNote }}</text>
			<text v-if="loading" class="map-meta">{{ g('正在载入景区导览') }}</text>
			<view v-if="failedArea.length > 0" class="retry-row"><text class="map-meta">{{ g('景区数据载入失败') }}</text><sg-button :label="g('重试')" kind="quiet" @action="retryMap" /></view>
		</view>

		<map
			v-if="mapMode == 'native'"
			id="scenic-map"
			class="map-view"
			:latitude="centerLatitude"
			:longitude="centerLongitude"
			:scale="mapScale"
			:min-scale="mapMinScale"
			:max-scale="mapMaxScale"
			:markers="markers"
			:polyline="polylines"
			:show-location="true"
			:enable-zoom="true"
			:enable-scroll="true"
			:enable-rotate="false"
			:show-compass="true"
			@markertap="onMarkerTap"
		/>

		<!-- #ifndef APP -->
		<movable-area v-else class="artwork-area" :style="artworkBackgroundStyle" scale-area>
			<movable-view
				class="artwork-stage"
				:style="artworkMovableStageStyle"
				direction="all"
				:inertia="!reducedMotion"
				scale
				:scale-min="0.72"
				:scale-max="2.4"
				:scale-value="artworkScale"
				:x="artworkX"
				:y="artworkY"
				@change="onArtworkMovableChange"
				@scale="onArtworkMovableScale"
			>
				<view class="artwork-rotator" :style="artworkRotatorBaseStyle">
					<image class="artwork-image" :style="artworkImageBaseStyle" :src="activeArtworkSource" mode="scaleToFill" />
					<view v-for="segment in artworkRouteSegments" :key="segment.id" class="artwork-route-halo" :style="artworkSegmentStyle(segment, 1.0, true)"></view>
					<view v-for="segment in artworkRouteSegments" :key="segment.id + '-line'" class="artwork-route-line" :style="artworkSegmentStyle(segment, 1.0, false)"></view>
					<view
						v-for="marker in artworkMarkers"
						:key="marker.spotId"
						class="artwork-marker"
						:class="selectedSpot?.id == marker.spotId ? 'artwork-marker-active' : ''"
						:style="artworkMarkerStyle(marker, 1.0)"
						@click="selectArtworkSpot(marker.spotId)"
					>
						<sg-map-marker :rotation="artworkRotation" :label="marker.name" :order="marker.routeOrder" :selected="selectedSpot?.id == marker.spotId" />
					</view>
				</view>
			</movable-view>
		</movable-area>
		<!-- #endif -->

		<!-- #ifdef APP -->
		<view v-else class="artwork-app-area" :style="artworkBackgroundStyle">
			<view
				class="artwork-app-viewport"
				@touchstart.stop="onArtworkTouchStart"
				@touchmove.stop.prevent="onArtworkTouchMove"
				@touchend.stop="onArtworkTouchEnd"
				@touchcancel.stop="onArtworkTouchEnd"
			>
				<view class="artwork-stage artwork-app-stage" :style="artworkAppStageStyle">
						<view class="artwork-rotator" :style="artworkRotatorScaledStyle">
							<image class="artwork-image" :style="artworkImageScaledStyle" :src="activeArtworkSource" mode="scaleToFill" />
							<view v-for="segment in artworkRouteSegments" :key="segment.id" class="artwork-route-halo" :style="artworkSegmentStyle(segment, artworkScale, true)"></view>
							<view v-for="segment in artworkRouteSegments" :key="segment.id + '-line'" class="artwork-route-line" :style="artworkSegmentStyle(segment, artworkScale, false)"></view>
							<view
								v-for="marker in artworkMarkers"
								:key="marker.spotId"
								class="artwork-marker"
								:class="selectedSpot?.id == marker.spotId ? 'artwork-marker-active' : ''"
								:style="artworkMarkerStyle(marker, artworkScale)"
								@click="selectArtworkSpot(marker.spotId)"
							>
								<sg-map-marker :rotation="artworkRotation" :label="marker.name" :order="marker.routeOrder" :selected="selectedSpot?.id == marker.spotId" />
							</view>
						</view>
				</view>
			</view>
		</view>
		<!-- #endif -->

		<view v-if="!sheetExpanded && !headerExpanded" class="map-controls">
			<view class="map-control" role="button" tabindex="0" data-sg-keyboard="activate" :aria-label="g('放大地图')" hover-class="pressed" @click="zoomIn"><sg-icon name="plus" /></view>
			<view class="map-control" role="button" tabindex="0" data-sg-keyboard="activate" :aria-label="g('缩小地图')" hover-class="pressed" @click="zoomOut"><sg-icon name="minus" /></view>
		</view>

		<view v-if="!headerExpanded" class="spot-sheet">
			<view class="sheet-handle-area" role="button" tabindex="0" data-sg-keyboard="activate" :aria-expanded="sheetExpanded" @click="toggleSheet">
				<view class="sheet-handle-copy"><text class="sheet-title">{{ selectedSpot?.name ?? g('景点导览') }}</text><text v-if="selectedSpot != null" class="map-meta">{{ g(selectedSpot!.categoryName) }}</text></view>
				<text class="sheet-toggle-text">{{ sheetExpanded ? g('收起') : g('展开') }}</text>
			</view>
			<scroll-view v-if="sheetExpanded" class="sheet-body" direction="vertical">
				<view v-if="selectedSpot != null">
					<text class="sheet-copy">{{ selectedSpot!.description ?? selectedSpot!.detail ?? g('查看景点详情或听导游讲解。') }}</text>
					<text v-if="locale != 'zh-Hans'" class="map-meta">{{ g('图名和景点资料沿用景区原文。') }}</text>
					<view class="sheet-actions"><sg-button :label="g(selectedSpot!.kind == 'scenic' ? '景点详情' : '设施详情')" @action="openSpot" /><sg-button :label="g('问导游')" kind="quiet" @action="askGuide" /><sg-button :label="g('取消选点')" kind="quiet" @action="clearSelection" /></view>
				</view>
				<view v-else><text class="sheet-copy">{{ g('点击景点标记或在筛选中搜索名称。') }}</text><sg-button :label="g('请导游规划游览')" kind="quiet" @action="askGuide" /></view>
				<digital-human-guide :locale="locale" class="sheet-guide" compact :title="digitalHumanTitle" state="guiding" :engine="digitalHumanRenderEngine" :service-status="digitalHuman?.serviceStatus ?? 'online'" :action-text="digitalHumanActionText" :avatar-source="digitalHumanAvatarSource" @click="openLiveAvatar" />
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useGuideLanguage } from '@/design/guide-locale.uts'
	const { locale, g } = useGuideLanguage()
	import { useScenicInsets } from '@/design/layout.uts'
	import { themeClass, themeColor } from '@/design/theme.uts'
	import { reducedMotion } from '@/design/motion.uts'
	import type { DigitalHumanConfig, GuideRoute, GuideRouteNode, MapGuideBootstrap, MapPoint, ScenicAreaId, ScenicSpot } from '@/domain/types.uts'
	import { createDefaultDigitalHumanConfig, createDigitalHumanWebSession, fetchDigitalHumanConfig, fetchDigitalHumanConfigs, fetchMapGuideBootstrap } from '@/services/guide-api.uts'
	import { resolveAssetUrl } from '@/services/http.uts'
	import { consumeMapSpot, getActiveRoute, queueGuidePrompt } from '@/stores/navigation-context.uts'
	import { getDigitalHumanRenderMode, getPreferredScenicArea, getSelectedDigitalHumanId, setPreferredScenicArea } from '@/stores/guide-preferences.uts'

	type ArtworkMarkerItem = {
		spotId : string,
		name : string,
		kind : string,
		x : number,
		y : number,
		routeOrder : number
	}

	type ArtworkRouteSegment = {
		id : string,
		x : number,
		y : number,
		width : number,
		angle : number
	}

	type ArtworkLayout = {
		imageWidth : number,
		imageHeight : number,
		frameWidth : number,
		frameHeight : number,
		offsetX : number,
		offsetY : number,
		rotation : number
	}

	type MarkerSpotBinding = {
		markerId : number,
		spotId : string
	}

	const activeAreaId = ref<ScenicAreaId>(getPreferredScenicArea())
	const bootstrap = ref<MapGuideBootstrap | null>(null)
	const loading = ref<boolean>(false)
	const loadGeneration = ref<number>(0)
	const centerLatitude = ref<number>(31.426019)
	const centerLongitude = ref<number>(120.099528)
	const mapScale = ref<number>(15)
	const keyword = ref<string>('')
	const mapMode = ref<string>('artwork')
	const headerExpanded = ref<boolean>(false)
	const failedArea = ref<string>('')
	const tripLayer = ref<GuideRoute | null>(null)
	const headerOffset = ref<number>(0)
	const { mapTopStyle } = useScenicInsets()
	const artworkScale = ref<number>(1.0)
	const artworkX = ref<number>(-120)
	const artworkY = ref<number>(-72)
	const artworkViewportWidth = ref<number>(375)
	const artworkViewportHeight = ref<number>(720)
	const spots = ref<ScenicSpot[]>([])
	const visibleSpots = ref<ScenicSpot[]>([])
	const routes = ref<GuideRoute[]>([])
	const activeGuideRoute = ref<GuideRoute | null>(null)
	const routeOptions = computed<GuideRoute[]>(() => {
		const officialRoutes = routes.value.filter((route : GuideRoute) : boolean => route.source == 'official' || route.isOfficial)
		const result = officialRoutes.length > 0 ? officialRoutes.slice() : routes.value.slice()
		if (tripLayer.value != null && !result.some((route : GuideRoute) : boolean => route.id == tripLayer.value!.id)) result.unshift(tripLayer.value!)
		return result
	})
	const markers = ref<Marker[]>([])
	const markerBindings = ref<MarkerSpotBinding[]>([])
	const polylines = ref<Polyline[]>([])
	const selectedSpot = ref<ScenicSpot | null>(null)
	// A facility opened from its detail page is temporarily pinned alongside the
	// filtered attractions. Clearing it restores the normal inventory and count.
	const markerSpots = computed<ScenicSpot[]>(() => {
		const selected = selectedSpot.value
		if (selected != null && selected.kind != 'scenic') return visibleSpots.value.concat([selected])
		return visibleSpots.value
	})
	const sheetExpanded = ref<boolean>(false)
	const digitalHuman = ref<DigitalHumanConfig | null>(createDefaultDigitalHumanConfig())
	let artworkTouchMode = ''
	let artworkLastTouchX = 0
	let artworkLastTouchY = 0
	let artworkPinchDistance = 0
	let artworkPinchScale = 1.0
	let artworkPinchRatioX = 0.5
	let artworkPinchRatioY = 0.5
	let artworkTouchMoved = false
	let artworkLastDragAt = 0

	const activeAreaName = computed<string>(() => g(activeAreaId.value == 'nianhuawan' ? '拈花湾' : '灵山胜境'))
	const spotCountLabel = computed<string>(() => {
		const count = visibleSpots.value.length
		if (locale.value == 'en') return count.toString() + (count == 1 ? ' place' : ' places')
		return count.toString() + (locale.value == 'zh-Hant' ? ' 個景點' : ' 个景点')
	})
	const digitalHumanTitle = computed<string>(() => digitalHuman.value?.name ?? g('灵小游'))
	const digitalHumanAvatarSource = computed<string>(() => {
		if (getDigitalHumanRenderMode() == 'xfyun' || digitalHuman.value?.engine == 'xfyun') return '/static/digital-human/guide-xfyun.webp'
		return '/static/digital-human/guide-haru-transparent.webp'
	})
	const digitalHumanRenderEngine = computed<string>(() => {
		let engine = digitalHuman.value?.engine ?? 'xfyun'
		// #ifdef MP-WEIXIN
		engine = 'live2d'
		// #endif
		return engine
	})
	const digitalHumanActionText = computed<string>(() => {
		let text = '动态形象'
		// #ifdef MP-WEIXIN
		text = 'Live2D模型'
		// #endif
		return g(text)
	})
	const activeArtworkSource = computed<string>(() => activeAreaId.value == 'nianhuawan' ? '/static/map/nianhuawan-artwork.webp' : '/static/map/lingshan-artwork.webp')
	const artworkBackgroundColor = computed<string>(() => bootstrap.value?.config.artworkBackgroundColor ?? (activeAreaId.value == 'nianhuawan' ? '#90d070' : '#b0d8b8'))
	const artworkRotation = computed<number>(() => bootstrap.value?.config.rotationDegrees ?? (activeAreaId.value == 'nianhuawan' ? 0 : 30))
	const mapMinScale = computed<number>(() => bootstrap.value?.config.minZoom ?? 15)
	const mapMaxScale = computed<number>(() => bootstrap.value?.config.maxZoom ?? 19)
	const pageBackgroundStyle = computed<string>(() => 'background-color:' + artworkBackgroundColor.value + ';')
	const artworkBackgroundStyle = computed<string>(() => 'background-color:' + artworkBackgroundColor.value + ';')

	function imageWidthForArea() : number {
		return activeAreaId.value == 'nianhuawan' ? 500 : 620
	}

	function imageHeightForArea() : number {
		return activeAreaId.value == 'nianhuawan' ? 578 : 572
	}

	function buildArtworkLayout(scale : number) : ArtworkLayout {
		const width = imageWidthForArea() * scale
		const height = imageHeightForArea() * scale
		const radians = artworkRotation.value * Math.PI / 180
		const frameWidth = Math.ceil(Math.abs(width * Math.cos(radians)) + Math.abs(height * Math.sin(radians)))
		const frameHeight = Math.ceil(Math.abs(width * Math.sin(radians)) + Math.abs(height * Math.cos(radians)))
		return {
			imageWidth: width,
			imageHeight: height,
			frameWidth,
			frameHeight,
			offsetX: (frameWidth - width) / 2,
			offsetY: (frameHeight - height) / 2,
			rotation: artworkRotation.value
		} as ArtworkLayout
	}

	const artworkBaseLayout = computed<ArtworkLayout>(() => buildArtworkLayout(1.0))
	const artworkScaledLayout = computed<ArtworkLayout>(() => buildArtworkLayout(artworkScale.value))
	const artworkMovableStageStyle = computed<string>(() => {
		const layout = artworkBaseLayout.value
		// movable-view clamps to its own bounds. Allow southern POIs to scroll
		// above the expanded card, including at the bottom edge of the artwork.
		const sheetClearance = sheetExpanded.value ? 252 / artworkScale.value : 0
		return 'width:' + layout.frameWidth + 'px;height:' + (layout.frameHeight + sheetClearance) + 'px;'
	})
	const artworkAppStageStyle = computed<string>(() => {
		const layout = artworkScaledLayout.value
		return 'width:' + layout.frameWidth + 'px;height:' + layout.frameHeight + 'px;left:' + artworkX.value + 'px;top:' + artworkY.value + 'px;'
	})
	const artworkRotatorBaseStyle = computed<string>(() => rotatorStyle(artworkBaseLayout.value))
	const artworkRotatorScaledStyle = computed<string>(() => rotatorStyle(artworkScaledLayout.value))
	const artworkImageBaseStyle = computed<string>(() => 'width:' + artworkBaseLayout.value.imageWidth + 'px;height:' + artworkBaseLayout.value.imageHeight + 'px;')
	const artworkImageScaledStyle = computed<string>(() => 'width:' + artworkScaledLayout.value.imageWidth + 'px;height:' + artworkScaledLayout.value.imageHeight + 'px;')

	function rotatorStyle(layout : ArtworkLayout) : string {
		return 'left:' + layout.offsetX + 'px;top:' + layout.offsetY + 'px;width:' + layout.imageWidth + 'px;height:' + layout.imageHeight + 'px;transform:rotate(' + layout.rotation + 'deg);'
	}

	function artworkBounds() : number[] {
		const bounds = bootstrap.value?.config.tileLayer.bounds
		if (bounds != null) {
			return [bounds.southwest.longitude, bounds.northeast.longitude, bounds.southwest.latitude, bounds.northeast.latitude]
		}
		return activeAreaId.value == 'nianhuawan'
			? [120.063915, 120.088033, 31.407641, 31.431446]
			: [120.089882, 120.109759, 31.418236, 31.433837]
	}

	function mercatorY(latitude : number) : number {
		const safeLatitude = Math.max(-85.0511287798, Math.min(85.0511287798, latitude))
		const radians = safeLatitude * Math.PI / 180
		return (1.0 - Math.log(Math.tan(radians) + 1.0 / Math.cos(radians)) / Math.PI) / 2.0
	}

	function pointToArtwork(point : MapPoint) : number[] {
		const bounds = artworkBounds()
		const west = bounds[0]
		const east = bounds[1]
		const south = bounds[2]
		const north = bounds[3]
		const ratioX = Math.max(0, Math.min(1, (point.longitude - west) / (east - west)))
		const northY = mercatorY(north)
		const southY = mercatorY(south)
		const ratioY = Math.max(0, Math.min(1, (mercatorY(point.latitude) - northY) / (southY - northY)))
		return [ratioX * imageWidthForArea(), ratioY * imageHeightForArea()]
	}

	function resolveRouteNode(node : GuideRouteNode) : MapPoint | null {
		const matched = spots.value.find((spot : ScenicSpot) : boolean => {
			return ((node.spotId ?? '').length > 0 && spot.id == node.spotId) || ((node.sourcePointId ?? '').length > 0 && spot.sourcePointId == node.sourcePointId) || spot.name == node.name
		}) ?? null
		if (matched != null) return { latitude: matched.latitude, longitude: matched.longitude, coordinateSystem: matched.coordinateSystem } as MapPoint
		if (node.latitude != null && node.longitude != null) return { latitude: node.latitude!, longitude: node.longitude!, coordinateSystem: node.coordinateSystem } as MapPoint
		return node.sourceRouteAnchor ?? null
	}

	// A missing coordinate breaks a line. Never bridge across an unregistered waypoint.
	function routePaths(route : GuideRoute | null) : MapPoint[][] {
		if (route == null) return []
		const authored = route.polyline.filter((point : MapPoint) : boolean => Number.isFinite(point.latitude) && Number.isFinite(point.longitude))
		if (authored.length > 1) return [authored]
		const sections : MapPoint[][] = []
		let run : MapPoint[] = []
		route.nodes.forEach((node : GuideRouteNode) => {
			const point = resolveRouteNode(node)
			if (point != null) run.push(point)
			else {
				if (run.length > 1) sections.push(run)
				run = []
			}
		})
		if (run.length > 1) sections.push(run)
		return sections
	}

	const routeNote = computed<string>(() => {
		const route = activeGuideRoute.value
		if (route == null || route.geometryKind != 'visit-order') return ''
		const missing = route.nodes.some((node : GuideRouteNode) : boolean => resolveRouteNode(node) == null)
		return ' · ' + g(missing ? '顺序示意，部分站点暂无坐标' : '游览顺序示意')
	})

	const artworkMarkers = computed<ArtworkMarkerItem[]>(() => {
		const routeNodes = activeGuideRoute.value?.nodes ?? []
		return markerSpots.value.map<ArtworkMarkerItem>((spot : ScenicSpot) : ArtworkMarkerItem => {
			const routeIndex = routeNodes.findIndex((node : GuideRouteNode) : boolean => ((node.spotId ?? '').length > 0 && node.spotId == spot.id) || node.name == spot.name)
			const pixel = pointToArtwork({ latitude: spot.latitude, longitude: spot.longitude } as MapPoint)
			return { spotId: spot.id, name: spot.name, kind: spot.kind, x: pixel[0], y: pixel[1], routeOrder: routeIndex >= 0 ? routeIndex + 1 : 0 } as ArtworkMarkerItem
		})
	})

	const artworkRouteSegments = computed<ArtworkRouteSegment[]>(() => {
		const paths = routePaths(activeGuideRoute.value)
		const result : ArtworkRouteSegment[] = []
		paths.forEach((path : MapPoint[], section : number) => {
		for (let index = 1; index < path.length; index++) {
			const start = pointToArtwork(path[index - 1])
			const end = pointToArtwork(path[index])
			const deltaX = end[0] - start[0]
			const deltaY = end[1] - start[1]
			const width = Math.sqrt(deltaX * deltaX + deltaY * deltaY)
			if (width < 0.5) continue
			result.push({ id: 'route-' + section + '-' + index, x: start[0], y: start[1], width, angle: Math.atan2(deltaY, deltaX) * 180 / Math.PI } as ArtworkRouteSegment)
		}
		})
		return result
	})

	function artworkMarkerStyle(marker : ArtworkMarkerItem, scale : number) : string {
		return 'left:' + Math.round(marker.x * scale - 22) + 'px;top:' + Math.round(marker.y * scale - 22) + 'px;'
	}

	function artworkSegmentStyle(segment : ArtworkRouteSegment, scale : number, halo : boolean) : string {
		const height = halo ? 7 : 4
		return 'left:' + Math.round(segment.x * scale) + 'px;top:' + Math.round(segment.y * scale - height / 2) + 'px;width:' + Math.max(1, Math.round(segment.width * scale)) + 'px;height:' + height + 'px;transform:rotate(' + segment.angle + 'deg);'
	}

	function stableMarkerId(value : string) : number {
		let hash = 17
		for (let index = 0; index < value.length; index++) hash = (hash * 31 + value.charCodeAt(index)) % 900000000
		return hash + 1
	}

	function spotMatchesQuery(spot : ScenicSpot, query : string) : boolean {
		if (query.length == 0) return true
		const text = query.toLowerCase()
		if (spot.name.toLowerCase().includes(text) || spot.categoryName.includes(query) || g(spot.categoryName).toLowerCase().includes(text)) return true
		return spot.aliases.some((alias : string) : boolean => alias.toLowerCase().includes(text))
	}

	function refreshVisibleSpots() {
		const query = keyword.value.trim()
		visibleSpots.value = spots.value.filter((spot : ScenicSpot) : boolean => {
			// The visitor map intentionally focuses on attraction points. Facility
			// POIs are available from the detail/search APIs but should not crowd the
			// hand-drawn map at any zoom level.
			if (spot.kind != 'scenic') return false
			if (!spotMatchesQuery(spot, query)) return false
			// Keep every scenic point visible regardless of zoom. This makes the
			// official point inventory discoverable on both scenic areas and keeps
			// marker numbering stable while switching routes.
			return true
		})
		buildNativeMarkers()
	}

	function buildNativeMarkers() {
		const usedIds : number[] = []
		const bindings : MarkerSpotBinding[] = []
		markers.value = markerSpots.value.map<Marker>((spot : ScenicSpot) : Marker => {
			let markerId = stableMarkerId(activeAreaId.value + ':' + spot.id)
			while (usedIds.includes(markerId)) markerId = markerId >= 900000000 ? 1 : markerId + 1
			usedIds.push(markerId)
			bindings.push({ markerId, spotId: spot.id } as MarkerSpotBinding)
			const selected = selectedSpot.value?.id == spot.id
			const markerSize = selected ? 32 : 24
			const suffix = themeClass.value.startsWith('sg-dark') ? '-dark' : ''
			const order = activeGuideRoute.value?.nodes.findIndex((node : GuideRouteNode) : boolean => node.spotId == spot.id || node.name == spot.name) ?? -1
			return {
				id: markerId,
				latitude: spot.latitude,
				longitude: spot.longitude,
				title: spot.name,
				iconPath: '/static/map/map-point' + (selected ? '-active' : '') + suffix + '.png',
				width: markerSize,
				height: markerSize,
				anchor: { x: 0.5, y: 0.5 },
				callout: {
					content: order >= 0 ? (order + 1).toString() + '. ' + spot.name : spot.name,
					color: themeColor('text'),
					fontSize: 12,
					borderRadius: 8,
					bgColor: themeColor('surface'),
					padding: 6,
					display: selected ? 'ALWAYS' : 'BYCLICK'
				} as MapMarkerCallout
			} as Marker
		})
		markerBindings.value = bindings
	}

	function rebuildRoute() {
		polylines.value = routePaths(activeGuideRoute.value).map<Polyline>((points : MapPoint[]) : Polyline => ({
			points, color: themeColor('accent'), width: 4, arrowLine: true, borderColor: themeColor('surface'), borderWidth: 2
		} as Polyline))
	}

	function chooseGuideRoute() {
		const recommendation = getActiveRoute()
		tripLayer.value = null
		if (recommendation != null) {
			const base = routes.value.find((route : GuideRoute) : boolean => route.id == 'curated-' + recommendation.id || route.id == recommendation.id || route.baseRouteId == recommendation.id) ?? null
			if (base != null) {
				const nodes = recommendation.nodes
				const sameOrder = nodes.length == base.nodes.length && nodes.every((node : GuideRouteNode, index : number) : boolean => node.name == base.nodes[index].name || ((node.spotId ?? '').length > 0 && node.spotId == base.nodes[index].spotId))
				if (sameOrder && base.polyline.length > 1) tripLayer.value = base
				else if (nodes.length > 0) {
					const resolved = nodes.map<GuideRouteNode>((node : GuideRouteNode) : GuideRouteNode => base.nodes.find((entry : GuideRouteNode) : boolean => entry.name == node.name || ((node.spotId ?? '').length > 0 && entry.spotId == node.spotId)) ?? node)
					tripLayer.value = { id: 'trip-order-' + base.id, name: recommendation.name, tags: recommendation.tags, polyline: [], nodes: resolved, isOfficial: false, geometryKind: 'visit-order' } as GuideRoute
				}
			}
		}
		activeGuideRoute.value = tripLayer.value ?? routeOptions.value[0] ?? null
		rebuildRoute()
	}

	function selectGuideRoute(routeId : string) {
		const selected = routeOptions.value.find((route : GuideRoute) : boolean => route.id == routeId) ?? null
		if (selected == null || selected.id == activeGuideRoute.value?.id) return
		activeGuideRoute.value = selected
		rebuildRoute()
		refreshVisibleSpots()
	}

	async function loadMapData(areaId : ScenicAreaId) {
		const generation = loadGeneration.value + 1
		loadGeneration.value = generation
		loading.value = true
		failedArea.value = ''
		try {
			const data = await fetchMapGuideBootstrap(areaId)
			if (generation != loadGeneration.value) return
			bootstrap.value = data
			activeAreaId.value = data.area.id
			setPreferredScenicArea(data.area.id)
			spots.value = data.spots
			routes.value = data.routes
			centerLatitude.value = data.config.center.latitude
			centerLongitude.value = data.config.center.longitude
			mapScale.value = data.config.initialZoom
			keyword.value = ''
			selectedSpot.value = null
			sheetExpanded.value = false
			artworkScale.value = 1.0
			resetArtworkPan()
			chooseGuideRoute()
			refreshVisibleSpots()
			applyPendingSpot()
		} catch (error) {
			if (generation != loadGeneration.value) return
			console.error('load map bootstrap failed', error)
			failedArea.value = areaId
		} finally {
			if (generation == loadGeneration.value) loading.value = false
		}
	}

	async function loadDigitalHumanPreference() {
		try {
			const configs = await fetchDigitalHumanConfigs()
			const selectedId = getSelectedDigitalHumanId()
			const desiredEngine = getDigitalHumanRenderMode()
			const selected = configs.find((item : DigitalHumanConfig) : boolean => item.id == selectedId && item.engine == desiredEngine) ?? configs.find((item : DigitalHumanConfig) : boolean => item.engine == desiredEngine && item.assetAvailable) ?? null
			if (selected != null) digitalHuman.value = selected
			else digitalHuman.value = await fetchDigitalHumanConfig()
		} catch (error) {
			console.error('load digital human failed', error)
		}
	}

	function applyPendingSpot() {
		const spotId = consumeMapSpot()
		if (spotId.length == 0) return
		const target = spots.value.find((spot : ScenicSpot) : boolean => spot.id == spotId) ?? null
		if (target == null) return
		mapScale.value = 18
		selectSearchSpot(target)
	}

	function clearSelection() {
		selectedSpot.value = null
		sheetExpanded.value = false
		buildNativeMarkers()
		clampArtworkPan()
	}

	function centerArtworkOnSpot(spot : ScenicSpot) {
		if (mapMode.value != 'artwork') return
		const point = pointToArtwork({ latitude: spot.latitude, longitude: spot.longitude } as MapPoint)
		const layout = artworkScaledLayout.value
		const radians = layout.rotation * Math.PI / 180
		const dx = point[0] * artworkScale.value - layout.imageWidth / 2
		const dy = point[1] * artworkScale.value - layout.imageHeight / 2
		const markerX = layout.frameWidth / 2 + dx * Math.cos(radians) - dy * Math.sin(radians)
		const markerY = layout.frameHeight / 2 + dx * Math.sin(radians) + dy * Math.cos(radians)
		const visibleMidpoint = (headerOffset.value + 76 + artworkViewportHeight.value - 240) / 2
		artworkX.value = artworkViewportWidth.value / 2 - markerX
		artworkY.value = visibleMidpoint - markerY
		clampArtworkPan()
	}

	function selectSearchSpot(spot : ScenicSpot) {
		selectedSpot.value = spot
		centerLatitude.value = spot.latitude
		centerLongitude.value = spot.longitude
		headerExpanded.value = false
		sheetExpanded.value = true
		buildNativeMarkers()
		centerArtworkOnSpot(spot)
	}

	function onSearchInput(value : string) {
		keyword.value = value
		refreshVisibleSpots()
		if (selectedSpot.value != null && !visibleSpots.value.some((spot : ScenicSpot) : boolean => spot.id == selectedSpot.value!.id)) clearSelection()
	}

	function submitSearch(value : string) {
		onSearchInput(value)
		if (visibleSpots.value.length > 0) selectSearchSpot(visibleSpots.value[0])
	}

	function clearSearch() { onSearchInput('') }

	function switchScenicArea(areaId : ScenicAreaId) {
		if (areaId == activeAreaId.value && !loading.value && failedArea.value.length == 0) return
		loadMapData(areaId)
	}

	function retryMap() { loadMapData(failedArea.value == 'nianhuawan' ? 'nianhuawan' : 'lingshan') }

	function setMapMode(mode : string) {
		mapMode.value = mode
		headerExpanded.value = false
		if (mode == 'artwork') clampArtworkPan()
		refreshVisibleSpots()
	}

	function toggleHeader() {
		headerExpanded.value = !headerExpanded.value
		clampArtworkPan()
	}

	function updateArtworkViewport() {
		const info = uni.getWindowInfo()
		headerOffset.value = info.statusBarHeight + 8
		// #ifdef MP-WEIXIN
		headerOffset.value = uni.getMenuButtonBoundingClientRect().bottom + 4
		// #endif
		artworkViewportWidth.value = info.windowWidth
		artworkViewportHeight.value = info.windowHeight
	}

	function artworkVisibleTop() : number {
		let top = 0
		// #ifdef APP
		top = headerOffset.value + (headerExpanded.value ? 280 : 76)
		// #endif
		return top
	}

	function artworkVisibleBottom() : number {
		let bottom = artworkViewportHeight.value
		if (sheetExpanded.value) bottom -= 252
		// #ifdef APP
		else bottom -= 76
		// #endif
		return Math.max(artworkVisibleTop() + 1, bottom)
	}

	function clampArtworkAxis(value : number, viewportStart : number, viewportEnd : number, contentSize : number) : number {
		const viewportSize = viewportEnd - viewportStart
		if (contentSize <= viewportSize) return viewportStart + (viewportSize - contentSize) / 2
		return Math.max(viewportEnd - contentSize, Math.min(viewportStart, value))
	}

	function clampArtworkPan() {
		const layout = artworkScaledLayout.value
		artworkX.value = clampArtworkAxis(artworkX.value, 0, artworkViewportWidth.value, layout.frameWidth)
		artworkY.value = clampArtworkAxis(artworkY.value, artworkVisibleTop(), artworkVisibleBottom(), layout.frameHeight)
	}

	function resetArtworkPan() {
		const layout = artworkScaledLayout.value
		artworkX.value = (artworkViewportWidth.value - layout.frameWidth) / 2
		artworkY.value = (artworkVisibleTop() + artworkVisibleBottom() - layout.frameHeight) / 2
		clampArtworkPan()
	}

	function setArtworkScale(nextScale : number) {
		const oldLayout = artworkScaledLayout.value
		const anchorX = artworkViewportWidth.value / 2
		const anchorY = (artworkVisibleTop() + artworkVisibleBottom()) / 2
		const ratioX = oldLayout.frameWidth > 0 ? (anchorX - artworkX.value) / oldLayout.frameWidth : 0.5
		const ratioY = oldLayout.frameHeight > 0 ? (anchorY - artworkY.value) / oldLayout.frameHeight : 0.5
		artworkScale.value = Math.max(0.72, Math.min(2.4, nextScale))
		const nextLayout = artworkScaledLayout.value
		artworkX.value = anchorX - ratioX * nextLayout.frameWidth
		artworkY.value = anchorY - ratioY * nextLayout.frameHeight
		clampArtworkPan()
	}

	// #ifndef APP
	function syncArtworkMovablePosition(nextX : number, nextY : number) {
		if (!Number.isFinite(nextX) || !Number.isFinite(nextY)) return
		// movable-view also emits change after a bound value is updated. Keep a
		// small tolerance so that event -> state -> event does not become a loop.
		if (Math.abs(artworkX.value - nextX) > 0.5) artworkX.value = nextX
		if (Math.abs(artworkY.value - nextY) > 0.5) artworkY.value = nextY
	}

	const onArtworkMovableChange = (event) => {
		syncArtworkMovablePosition(event.detail.x, event.detail.y)
	}

	const onArtworkMovableScale = (event) => {
		const nextScale = Math.max(0.72, Math.min(2.4, event.detail.scale))
		syncArtworkMovablePosition(event.detail.x, event.detail.y)
		if (Math.abs(artworkScale.value - nextScale) > 0.001) artworkScale.value = nextScale
	}
	// #endif

	function artworkTouchDistance(event : UniTouchEvent) : number {
		if (event.touches.length < 2) return 0
		const deltaX = event.touches[1].clientX - event.touches[0].clientX
		const deltaY = event.touches[1].clientY - event.touches[0].clientY
		return Math.sqrt(deltaX * deltaX + deltaY * deltaY)
	}

	function onArtworkTouchStart(event : UniTouchEvent) {
		artworkTouchMoved = false
		if (event.touches.length >= 2) {
			artworkTouchMode = 'pinch'
			artworkPinchDistance = artworkTouchDistance(event)
			artworkPinchScale = artworkScale.value
			const anchorX = (event.touches[0].clientX + event.touches[1].clientX) / 2
			const anchorY = (event.touches[0].clientY + event.touches[1].clientY) / 2
			const layout = artworkScaledLayout.value
			artworkPinchRatioX = Math.max(0, Math.min(1, (anchorX - artworkX.value) / layout.frameWidth))
			artworkPinchRatioY = Math.max(0, Math.min(1, (anchorY - artworkY.value) / layout.frameHeight))
			return
		}
		if (event.touches.length == 0) return
		artworkTouchMode = 'pan'
		artworkLastTouchX = event.touches[0].clientX
		artworkLastTouchY = event.touches[0].clientY
	}

	function onArtworkTouchMove(event : UniTouchEvent) {
		if (event.touches.length >= 2) {
			const distance = artworkTouchDistance(event)
			if (artworkTouchMode != 'pinch' || artworkPinchDistance <= 0) {
				onArtworkTouchStart(event)
				return
			}
			const nextScale = Math.max(0.72, Math.min(2.4, artworkPinchScale * distance / artworkPinchDistance))
			const anchorX = (event.touches[0].clientX + event.touches[1].clientX) / 2
			const anchorY = (event.touches[0].clientY + event.touches[1].clientY) / 2
			const nextLayout = buildArtworkLayout(nextScale)
			artworkScale.value = nextScale
			artworkX.value = anchorX - artworkPinchRatioX * nextLayout.frameWidth
			artworkY.value = anchorY - artworkPinchRatioY * nextLayout.frameHeight
			artworkTouchMoved = true
			clampArtworkPan()
			return
		}
		if (event.touches.length == 0) return
		const clientX = event.touches[0].clientX
		const clientY = event.touches[0].clientY
		if (artworkTouchMode != 'pan') {
			artworkTouchMode = 'pan'
			artworkLastTouchX = clientX
			artworkLastTouchY = clientY
			return
		}
		const deltaX = clientX - artworkLastTouchX
		const deltaY = clientY - artworkLastTouchY
		if (Math.abs(deltaX) > 1 || Math.abs(deltaY) > 1) artworkTouchMoved = true
		artworkX.value += deltaX
		artworkY.value += deltaY
		artworkLastTouchX = clientX
		artworkLastTouchY = clientY
		clampArtworkPan()
	}

	function onArtworkTouchEnd(_event : UniTouchEvent) {
		if (artworkTouchMoved) artworkLastDragAt = Date.now()
		artworkTouchMode = ''
		artworkPinchDistance = 0
		refreshVisibleSpots()
	}

	function selectArtworkSpot(spotId : string) {
		if (Date.now() - artworkLastDragAt < 180) return
		const target = spots.value.find((spot : ScenicSpot) : boolean => spot.id == spotId) ?? null
		if (target == null) return
		if (selectedSpot.value?.id == spotId) { clearSelection(); return }
		selectSearchSpot(target)
	}

	function onMarkerTap(event : UniMapMarkerTapEvent) {
		const markerId = event.detail?.markerId
		if (markerId == null) return
		const binding = markerBindings.value.find((item : MarkerSpotBinding) : boolean => item.markerId == markerId) ?? null
		if (binding == null) return
		const target = spots.value.find((spot : ScenicSpot) : boolean => spot.id == binding.spotId) ?? null
		if (target == null) return
		if (selectedSpot.value?.id == target.id) { clearSelection(); return }
		selectSearchSpot(target)
	}

	function distanceMeters(left : MapPoint, right : MapPoint) : number {
		const radians = (value : number) : number => value * Math.PI / 180
		const latitudeDelta = radians(right.latitude - left.latitude)
		const longitudeDelta = radians(right.longitude - left.longitude)
		const leftLatitude = radians(left.latitude)
		const rightLatitude = radians(right.latitude)
		const value = Math.sin(latitudeDelta / 2) * Math.sin(latitudeDelta / 2) + Math.cos(leftLatitude) * Math.cos(rightLatitude) * Math.sin(longitudeDelta / 2) * Math.sin(longitudeDelta / 2)
		return 6371008.8 * 2 * Math.atan2(Math.sqrt(value), Math.sqrt(1 - value))
	}

	function locateMe() {
		uni.showLoading({ title: g('定位中') })
		uni.getLocation({
			type: 'gcj02',
			isHighAccuracy: true,
			success: (result) => {
				centerLatitude.value = result.latitude
				centerLongitude.value = result.longitude
				if (mapMode.value == 'artwork' && spots.value.length > 0) {
					const current = { latitude: result.latitude, longitude: result.longitude } as MapPoint
					let nearest = spots.value[0]
					let nearestDistance = distanceMeters(current, { latitude: nearest.latitude, longitude: nearest.longitude } as MapPoint)
					spots.value.forEach((spot : ScenicSpot) => {
						const distance = distanceMeters(current, { latitude: spot.latitude, longitude: spot.longitude } as MapPoint)
						if (distance < nearestDistance) { nearest = spot; nearestDistance = distance }
					})
					selectSearchSpot(nearest)
					uni.showToast({ title: g('已定位到附近点位'), icon: 'none' })
				}
			},
			fail: () => uni.showToast({ title: g('无法获取位置，请检查定位权限'), icon: 'none' }),
			complete: () => uni.hideLoading()
		})
	}

	function zoomIn() {
		if (mapMode.value == 'artwork') setArtworkScale(artworkScale.value + 0.2)
		else mapScale.value = Math.min(mapMaxScale.value, mapScale.value + 1)
		refreshVisibleSpots()
	}

	function zoomOut() {
		if (mapMode.value == 'artwork') setArtworkScale(artworkScale.value - 0.2)
		else mapScale.value = Math.max(mapMinScale.value, mapScale.value - 1)
		refreshVisibleSpots()
	}

	function toggleSheet() {
		sheetExpanded.value = !sheetExpanded.value
		clampArtworkPan()
	}

	function openSpot() {
		if (selectedSpot.value == null) return
		uni.navigateTo({ url: '/pages/spot/detail?id=' + encodeURIComponent(selectedSpot.value!.id) })
	}

	function askGuide() {
		const name = selectedSpot.value?.name ?? activeAreaName.value
		const withSpot = selectedSpot.value != null
		let question = withSpot ? '请作为数字人导游介绍' + name + '，并告诉我现在最值得看的内容。' : '请作为数字人导游介绍' + name + '，并推荐一条适合首次到访的游览路线。'
		if (locale.value == 'zh-Hant') question = withSpot ? '請介紹' + name + '，並告訴我有哪些值得看的地方。' : '請介紹' + name + '，並推薦一條適合初次來訪的遊覽路線。'
		if (locale.value == 'en') question = withSpot ? 'What should I see at ' + name + '?' : 'Please suggest a route for a first visit to ' + name + '.'
		queueGuidePrompt(question, activeAreaId.value, selectedSpot.value?.id ?? '', selectedSpot.value?.name ?? '')
		const targetUrl = '/pages/ai-guide/index'
		uni.switchTab({
			url: targetUrl,
			fail: (error) => {
				console.error('switch to ai guide failed', error)
				uni.reLaunch({ url: targetUrl })
			}
		})
	}

	async function openLiveAvatar() {
		// #ifdef MP-WEIXIN
		askGuide()
		// #endif
		// #ifndef MP-WEIXIN
		const config = digitalHuman.value
		if (config == null || config.engine != 'xfyun' || !config.assetAvailable) {
			uni.showToast({ title: g('当前数字人形象不支持云端动态渲染'), icon: 'none' })
			return
		}
		uni.showLoading({ title: g('创建动态会话') })
		try {
			const session = await createDigitalHumanWebSession(config.id)
			uni.navigateTo({ url: '/pages/digital-human/index?src=' + encodeURIComponent(resolveAssetUrl(session.pageUrl)) })
		} catch (error) {
			console.error('open digital human failed', error)
			uni.showToast({ title: g('动态数字人暂时不可用'), icon: 'none' })
		} finally {
			uni.hideLoading()
		}
		// #endif
	}

	watch(themeClass, () => { buildNativeMarkers(); rebuildRoute() })

	onLoad(() => {
		updateArtworkViewport()
		loadMapData(activeAreaId.value)
	})

	onShow(() => {
		updateArtworkViewport()
		clampArtworkPan()
		loadDigitalHumanPreference()
		const desiredArea = getPreferredScenicArea()
		if (desiredArea != activeAreaId.value) { loadMapData(desiredArea); return }
		if (spots.value.length > 0) {
			chooseGuideRoute()
			refreshVisibleSpots()
			applyPendingSpot()
		}
	})
</script>

<style lang="scss">
	@include sg-themes;
	.page { position: relative; flex: 1; width: 100%; height: 100%; overflow: hidden; }
	.map-header, .spot-sheet { position: absolute; left: $sg-space-3; right: $sg-space-3; z-index: 10; padding: $sg-space-3; background-color: $sg-surface; border: 1px solid $sg-border; border-radius: $sg-radius-lg; }
	.map-title-row, .filter-row, .sheet-handle-area, .sheet-actions, .retry-row { flex-direction: row; align-items: center; }
	.map-title-group, .sheet-handle-copy { flex: 1; min-width: 0; }
	.map-title, .sheet-title { color: $sg-text; font-size: $sg-type-card; font-weight: 700; }
	.map-meta, .route-caption { font-size: $sg-type-caption; color: $sg-muted; }
	.route-caption { margin-top: $sg-space-1; }
	.map-filters { height: 188px; margin-top: $sg-space-2; }
	.filter-row, .sheet-actions { flex-wrap: wrap; margin: $sg-space-1 0; }
	.map-view, .artwork-area, .artwork-app-area, .artwork-app-viewport { width: 100%; height: 100%; overflow: hidden; }
	.artwork-app-viewport, .artwork-stage { position: relative; }
	.artwork-stage { overflow: visible; }
	.artwork-app-stage, .artwork-rotator, .artwork-image, .artwork-marker { position: absolute; }
	.artwork-rotator { overflow: visible; transform-origin: center center; }
	.artwork-image { left: 0; top: 0; }
	.artwork-route-halo, .artwork-route-line { position: absolute; border-radius: $sg-radius-sm; transform-origin: left center; }
	.artwork-route-halo { z-index: 2; background-color: $sg-surface; }
	.artwork-route-line { z-index: 3; background-color: $sg-accent; }
	.artwork-marker { overflow: visible; width: $sg-touch; height: $sg-touch; align-items: center; justify-content: center; z-index: 4; }
	.artwork-marker-active { z-index: 8; }
	.map-controls { position: absolute; right: $sg-space-3; bottom: 96px; z-index: 8; background-color: $sg-surface; border: 1px solid $sg-border; border-radius: $sg-radius-md; overflow: hidden; }
	.map-control { width: $sg-touch; height: $sg-touch; align-items: center; justify-content: center; }
	.pressed { opacity: $sg-pressed-opacity; }
	.spot-sheet { bottom: $sg-space-3; padding-top: $sg-space-1; padding-bottom: $sg-space-1; }
	.sheet-handle-area { min-height: $sg-touch; }
	.sheet-toggle-text { font-size: $sg-type-label; color: $sg-primary; font-weight: 600; }
	.sheet-body { height: 182px; }
	.sheet-copy { color: $sg-text; font-size: $sg-type-label; }
	.sheet-guide { margin-top: $sg-space-2; }
</style>
