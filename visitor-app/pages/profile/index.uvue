<template>
  <scroll-view class="page" :class="themeClass" direction="vertical" :show-scrollbar="false">
    <view class="content">
      <view class="top" :style="headerStyle"><sg-page-header :title="t('我的', 'Profile', '我的')" /></view>
      <view class="account">
        <view class="identity">
          <view class="avatar" role="button" tabindex="0" data-sg-keyboard="activate" :aria-label="t('更换头像', 'Change avatar', '更換頭像')" @click="chooseProfileAvatar">
            <sg-avatar :src="profileAvatarSource" :label="displayName" />
            <view class="camera"><sg-icon name="camera" tone="inverse" :size="14" /></view>
          </view>
          <view class="ident-copy">
            <text class="name">{{ displayName }}</text>
            <text class="meta">{{ avatarUploading ? t('上传中', 'Uploading', '上傳中') : (authUser == null ? t('本设备游客会话', 'Guest on this device', '本裝置訪客工作階段') : t('游客账号已登录', 'Signed in', '訪客帳號已登入')) }}</text>
          </view>
        </view>
        <sg-button :label="authUser == null ? t('登录 / 注册', 'Sign in / Register', '登入 / 註冊') : t('退出登录', 'Sign out', '登出')" kind="secondary" @action="handleAuth" />
      </view>
      <view class="stats">
        <view class="stat" role="button" tabindex="0" data-sg-keyboard="activate" :aria-label="t('收藏景点', 'Favorites', '收藏景點')" @click="openFavorites"><text class="count">{{ favoriteCount }}</text><text class="meta">{{ t('收藏景点', 'Favorites', '收藏景點') }}</text></view>
        <view class="stat" role="button" tabindex="0" data-sg-keyboard="activate" :aria-label="t('保存行程', 'Saved trips', '儲存行程')" @click="openTrip"><text class="count">{{ savedRouteCount < 0 ? '—' : savedRouteCount.toString() }}</text><text class="meta">{{ t('保存行程', 'Saved trips', '儲存行程') }}</text></view>
        <view class="stat" role="button" tabindex="0" data-sg-keyboard="activate" :aria-label="t('游览足迹', 'Visits', '遊覽足跡')" @click="openFavorites"><text class="count">{{ visitedCount }}</text><text class="meta">{{ t('游览足迹', 'Visits', '遊覽足跡') }}</text></view>
      </view>
      <app-section :title="t('导览偏好', 'Guide preferences', '導覽偏好')">
        <view class="group">
            <sg-service-row icon="location" :title="t('当前景区', 'Scenic area', '目前景區')" :detail="scenicAreaName" @action="chooseScenicArea" />
            <sg-divider />
            <sg-service-row icon="voice" :title="t('数字人导游', 'Digital guide', '數位人導遊')" :detail="selectedDigitalHumanName + ' · ' + selectedDigitalHumanStatus" @action="chooseDigitalHuman" />
            <sg-divider />
            <sg-service-row icon="switch" :title="t('语言', 'Language', '語言')" :detail="currentLanguageName" @action="chooseLanguage" />
            <sg-divider />
            <sg-service-row icon="eyes" :title="t('大号字体', 'Larger text', '大號字體')" :detail="largeText ? t('已开启', 'On', '已開啟') : t('标准', 'Standard', '標準')" @action="toggleLargeText" />
            <sg-divider />
            <sg-service-row icon="pause" :title="t('减少动态效果', 'Reduce motion', '減少動態效果')" :detail="reduceMotionPreference ? t('已开启', 'On', '已開啟') : standardMotionLabel" @action="toggleMotion" />
        </view>
      </app-section>
      <app-section :title="t('我的服务', 'My services', '我的服務')">
        <view class="group">
            <sg-service-row icon="calendar" :title="t('我的行程', 'My trips', '我的行程')" @action="openTrip" />
            <sg-divider />
            <sg-service-row icon="star" :title="t('收藏、到访与最近浏览', 'Saved places and history', '收藏、到訪與最近瀏覽')" @action="openFavorites" />
            <sg-divider />
            <sg-service-row icon="chat" :title="t('对话记录', 'Chat history', '對話記錄')" @action="openGuide" />
            <sg-divider />
            <sg-service-row icon="comments" :title="t('意见反馈', 'Feedback', '意見回饋')" @action="openFeedback" />
        </view>
      </app-section>
      <app-section :title="t('设置', 'Settings', '設定')">
        <view class="group">
            <sg-service-row icon="info" :title="t('隐私与权限', 'Privacy and permissions', '隱私與權限')" @action="showPrivacy" />
            <sg-divider />
            <sg-service-row icon="photo" :title="t('照片署名', 'Photo credits', '照片署名')" @action="showPhotoCredits" />
            <sg-divider />
            <sg-service-row icon="help" :title="t('关于应用', 'About', '關於應用程式')" @action="showAbout" />
        </view>
      </app-section>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { openGuideHistory } from '@/stores/navigation-context.uts'
	import { largeText, themeClass, toggleLargeText } from '@/design/theme.uts'
  import { useScenicInsets } from '@/design/layout.uts'
  import { setReduceMotionPreference, reduceMotionPreference } from '@/design/motion.uts'
  import { showPhotoCredits } from '@/design/scenic-media.uts'
  import type { AuthUser, DigitalHumanConfig } from '@/domain/types.uts'
	import { createDefaultDigitalHumanConfig, fetchAuthProfile, fetchDigitalHumanConfig, fetchDigitalHumanConfigs, fetchSavedRoutes, uploadProfileAvatar } from '@/services/guide-api.uts'
	import { resolveAssetUrl } from '@/services/http.uts'
	import { clearAuthSession, getAuthToken, getCachedAuthUser, updateCachedAuthProfile } from '@/stores/auth.uts'
	import { getPreferredScenicArea, getSelectedDigitalHumanId, setDigitalHumanRenderMode, setPreferredScenicArea, setSelectedDigitalHumanId } from '@/stores/guide-preferences.uts'
	import { getAppLanguageName, getAppLocale, localize, setAppLocale } from '@/stores/locale.uts'
	import { ensureVisitorSession } from '@/stores/session.uts'
	import { getFavoriteSpotIds, getVisitedSpotIds } from '@/stores/visitor-activity.uts'
  const { headerStyle } = useScenicInsets()

	const savedRouteCount = ref<number>(-1)
	const favoriteCount = ref<number>(0)
	const visitedCount = ref<number>(0)
	const authUser = ref<AuthUser | null>(null)
	const avatarUploading = ref<boolean>(false)
	// Native storage may return null for a key that has not been written yet.
	// Keep the first render synchronous and use a guarded read in onShow so a
	// fresh Android/Harmony install cannot abort the profile page before mount.
	const currentLocale = ref<string>('zh-Hans')
	const scenicArea = ref<string>('lingshan')
	const initialDigitalHuman = createProfileDefaultDigitalHuman()
	const digitalHumans = ref<DigitalHumanConfig[]>([initialDigitalHuman])
	const selectedDigitalHuman = ref<DigitalHumanConfig | null>(initialDigitalHuman)
	const displayName = computed<string>(() => authUser.value?.displayName ?? t('游客', 'Guest', '訪客'))
	const currentLanguageName = computed<string>(() => getAppLanguageName(currentLocale.value))
	const profileAvatarSource = computed<string>(() => {
		const avatar = authUser.value?.avatar ?? ''
		return avatar.length > 0 ? resolveAssetUrl(avatar) : '/static/logo.png'
	})
	const scenicAreaName = computed<string>(() => scenicArea.value == 'nianhuawan' ? t('拈花湾','Nianhua Bay','拈花灣') : t('灵山胜境','Lingshan','靈山勝境'))
	const selectedDigitalHumanName = computed<string>(() => selectedDigitalHuman.value?.name ?? '云觉·大佛文化使（女）')
	const selectedDigitalHumanStatus = computed<string>(() => selectedDigitalHuman.value?.engine == 'xfyun' ? t('讯飞云音色', 'iFLYTEK cloud voice', '訊飛雲端音色') : t('Live2D 模型模式', 'Live2D model', 'Live2D 模型模式'))

	function t(simplified : string, english : string, traditional : string) : string {
		return localize(currentLocale.value, simplified, english, traditional)
	}

	function safeAppLocale() : string {
		try {
			return getAppLocale()
		} catch (error) {
			console.warn('read app locale failed, using simplified Chinese', error)
			return 'zh-Hans'
		}
	}

	function safeCachedAuthUser() : AuthUser | null {
		try {
			return getCachedAuthUser()
		} catch (error) {
			console.warn('read cached auth user failed', error)
			return null
		}
	}

	function safeFavoriteCount() : number {
		try {
			return getFavoriteSpotIds().length
		} catch (error) {
			console.warn('read local activity failed', error)
			return 0
		}
	}

	function safeVisitedCount() : number {
		try {
			return getVisitedSpotIds().length
		} catch (error) {
			console.warn('read local activity failed', error)
			return 0
		}
	}

	function safeAuthToken() : string {
		try {
			return getAuthToken()
		} catch (error) {
			return ''
		}
	}

	function createProfileDefaultDigitalHuman() : DigitalHumanConfig {
		const config = createDefaultDigitalHumanConfig()
		// #ifdef MP-WEIXIN
		config.id = 'dh_l2d_haru'
		config.name = '春和·九龙灵使（女）'
		config.engine = 'live2d'
		config.avatarId = ''
		config.modelId = 'Haru'
		config.characterAsset = '/live2d/characters/Haru/Haru.model3.json'
		// #endif
		return config
	}

	async function refreshGuidePreferences() {
		scenicArea.value = getPreferredScenicArea()
		try {
			let configs = await fetchDigitalHumanConfigs()
			configs = configs.filter((item : DigitalHumanConfig) : boolean => item.assetAvailable && item.serviceStatus == 'online')
			// #ifdef MP-WEIXIN
			configs = configs.filter((item : DigitalHumanConfig) : boolean => item.engine == 'live2d')
			setDigitalHumanRenderMode('live2d')
			// #endif
			if (configs.length == 0) {
				// #ifdef MP-WEIXIN
				configs = [createProfileDefaultDigitalHuman()]
				// #endif
				// #ifndef MP-WEIXIN
				configs = [await fetchDigitalHumanConfig()]
				// #endif
			}
			digitalHumans.value = configs
			const selectedId = getSelectedDigitalHumanId()
			selectedDigitalHuman.value = configs.find((item : DigitalHumanConfig) : boolean => item.id == selectedId) ?? configs[0]
		} catch (error) {
			console.error('load guide preferences failed', error)
			const fallback = createProfileDefaultDigitalHuman()
			digitalHumans.value = [fallback]
			selectedDigitalHuman.value = fallback
		}
	}

	async function refreshProfileState() {
		refreshGuidePreferences()
		authUser.value = safeCachedAuthUser()
		favoriteCount.value = safeFavoriteCount()
		visitedCount.value = safeVisitedCount()
		try {
			const sessionId = await ensureVisitorSession()
			const routes = await fetchSavedRoutes(sessionId)
			savedRouteCount.value = routes.length
		} catch (error) {
			// Keep the previous successful count, or the unknown marker on first load.
		}
		const token = safeAuthToken()
		if (token.length > 0) {
			try {
				const profile = await fetchAuthProfile()
				if (token != safeAuthToken()) return
				updateCachedAuthProfile(profile)
				authUser.value = safeCachedAuthUser()
			} catch (error) {
				console.error('refresh auth profile failed', error)
			}
		}
	}

	function chooseScenicArea() {
		uni.showActionSheet({
			itemList: [t('灵山胜境','Lingshan','靈山勝境'), t('拈花湾','Nianhua Bay','拈花灣')],
			success: (result) => {
				const nextArea = result.tapIndex == 1 ? 'nianhuawan' : 'lingshan'
				setPreferredScenicArea(nextArea)
				scenicArea.value = nextArea
				uni.showToast({ title: t('已切换到','Switched to ','已切換到') + scenicAreaName.value, icon: 'none' })
			}
		})
	}

	function chooseDigitalHuman() {
		if (digitalHumans.value.length == 0) {
			uni.showToast({ title: t('数字人配置暂未载入','Guide settings are unavailable','數位人設定暫未載入'), icon: 'none' })
			return
		}
		uni.showActionSheet({
			itemList: digitalHumans.value.map<string>((item : DigitalHumanConfig) : string => item.name),
				success: (result) => {
					const selected = digitalHumans.value[result.tapIndex]
					selectedDigitalHuman.value = selected
					setSelectedDigitalHumanId(selected.id)
					setDigitalHumanRenderMode(selected.engine == 'xfyun' ? 'xfyun' : 'live2d')
					uni.showToast({ title: t('已切换为','Selected ','已切換為') + selected.name, icon: 'none' })
				}
			})
	}

	function chooseLanguage() {
		uni.showActionSheet({
			itemList: ['简体中文', 'English', '繁體中文'],
			success: (result) => {
				const locale = result.tapIndex == 1 ? 'en' : (result.tapIndex == 2 ? 'zh-Hant' : 'zh-Hans')
				// Update the page-local reactive state first. Native `uni.setLocale`
				// and tab-bar updates are platform services and must not be allowed
				// to abort the visible language change if a host rejects one call.
				currentLocale.value = locale
				setAppLocale(locale)
				uni.showToast({ title: t('语言已切换', 'Language updated', '語言已切換'), icon: 'none' })
			}
		})
	}

	function handleAuth() {
		if (authUser.value == null) {
			uni.navigateTo({ url: '/pages/auth/index' })
			return
		}
		uni.showModal({
			title: t('退出登录','Sign out','登出'),
			content: t('退出后本设备的行程、收藏、足迹和对话记录仍会保留。','Your trips, favorites, visits and conversations will stay on this device.','登出後本裝置的行程、收藏、足跡與對話紀錄仍會保留。'),
			success: (result) => {
				if (!result.confirm) return
				clearAuthSession()
				authUser.value = null
				uni.showToast({ title: t('已退出登录','Signed out','已登出'), icon: 'none' })
			}
		})
	}

	function chooseProfileAvatar() {
		if (avatarUploading.value) return
		if (authUser.value == null || getAuthToken().length == 0) {
			uni.showModal({
				title: t('登录后设置头像','Sign in to change your avatar','登入後設定頭像'),
				content: t('头像将保存到你的游客账号，可在各端登录后同步显示。','Your avatar is saved to your visitor account and appears wherever you sign in.','頭像將儲存到你的訪客帳號，可於各端登入後同步顯示。'),
				confirmText: t('去登录','Sign in','去登入'),
				success: (result) => {
					if (result.confirm) uni.navigateTo({ url: '/pages/auth/index' })
				}
			})
			return
		}
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (result) => {
				if (result.tempFiles.length == 0) return
				const file = result.tempFiles[0]
				handleProfileAvatarUpload(file.path, file.size)
			},
			fail: (error) => {
				if (!error.errMsg.includes('cancel')) uni.showToast({ title: t('未能读取所选图片','Could not open the image','未能讀取所選圖片'), icon: 'none' })
			}
		})
	}

	async function handleProfileAvatarUpload(filePath : string, fileSize : number) {
		if (fileSize > 5 * 1024 * 1024) {
			uni.showToast({ title: t('请选择不超过 5 MB 的图片','Choose an image up to 5 MB','請選擇不超過 5 MB 的圖片'), icon: 'none' })
			return
		}
		avatarUploading.value = true
		uni.showLoading({ title: t('正在上传','Uploading','正在上傳'), mask: true })
		try {
			const profile = await uploadProfileAvatar(filePath)
			updateCachedAuthProfile(profile)
			authUser.value = getCachedAuthUser()
			uni.showToast({ title: t('头像已更新','Avatar updated','頭像已更新'), icon: 'success' })
		} catch (error) {
			console.error('upload profile avatar failed', error)
			uni.showToast({ title: t('头像上传失败，请稍后重试','Upload failed. Please try again.','頭像上傳失敗，請稍後重試'), icon: 'none' })
		} finally {
			uni.hideLoading()
			avatarUploading.value = false
		}
	}

	function showPrivacy() { uni.showModal({ title: t('隐私与权限','Privacy and permissions','隱私與權限'), content: t('地图使用定位显示当前位置。只有发起语音提问或更换头像时才会使用麦克风、相机或相册。账号、反馈和导览数据提交到项目服务。','Location is used on the map. The microphone, camera and photo library are accessed when you ask a voice question or update your avatar. Account, feedback and guide data go to the project service.','地圖使用定位顯示目前位置。只有發起語音提問或更換頭像時才會使用麥克風、相機或相簿。帳號、回饋與導覽資料提交到專案服務。'), showCancel: false }) }
	function showAbout() { uni.showModal({ title: '数智游踪', content: t('基于 uni-app x Vapor 构建的多端游客应用。','A cross-platform visitor guide built with uni-app x Vapor.','以 uni-app x Vapor 建構的多端訪客應用程式。'), showCancel: false }) }
	function openTrip() { uni.switchTab({ url: '/pages/trip/index' }) }
	function openGuide() { openGuideHistory() }
	function openFavorites() { uni.navigateTo({ url: '/pages/favorites/index' }) }
	function openFeedback() { uni.navigateTo({ url: '/pages/feedback/index' }) }

	onShow(() => {
		currentLocale.value = safeAppLocale()
		refreshProfileState()
	})

  const standardMotionLabel = computed<string>(() => {
    // #ifdef WEB || APP-ANDROID
    return t('跟随系统', 'Follow system', '跟隨系統')
    // #endif
    // #ifndef WEB || APP-ANDROID
    return t('标准', 'Standard', '標準')
    // #endif
  })
  function toggleMotion() { setReduceMotionPreference(!reduceMotionPreference.value) }
</script>
<style lang="scss">
  @include sg-themes;
  .page { flex: 1; background-color: $sg-background; }
  .content { padding: 0 $sg-space-5 $sg-space-8; }
  .top { margin-bottom: $sg-space-4; }
  .account, .group { border: 1px solid $sg-divider; background-color: $sg-surface; border-radius: $sg-radius-md; overflow: hidden; }
  .account { padding: $sg-space-4; }
  .identity, .stats { flex-direction: row; align-items: center; }
  .identity { margin-bottom: $sg-space-4; }
  .avatar { width: 64px; height: 64px; position: relative; }
  .camera { position: absolute; right: 0; bottom: 0; width: $sg-space-6; height: $sg-space-6; border-radius: $sg-radius-pill; background-color: $sg-primary; align-items: center; justify-content: center; }
  .ident-copy { flex: 1; margin-left: $sg-space-4; }
  .name { font-size: $sg-type-section; color: $sg-text; font-weight: 700; }
  .meta { font-size: $sg-type-label; color: $sg-muted; margin-top: $sg-space-1; }
  .stats { padding: $sg-space-3 0; margin-top: $sg-space-3; border-radius: $sg-radius-md; background-color: $sg-inset; }
  .stat { flex: 1; align-items: center; justify-content: center; min-height: $sg-touch; }
  .count { font-size: $sg-type-section; color: $sg-primary; font-weight: 700; }
</style>
