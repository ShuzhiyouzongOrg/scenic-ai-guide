<template>
	<view class="page">
		<view class="guide-header">
			<view class="guide-avatar">
				<image class="guide-avatar-image" src="/static/logo.png" mode="aspectFit" />
				<view class="online-dot"></view>
			</view>
			<view class="guide-heading">
				<view class="guide-title-row">
					<text class="guide-title">灵小游</text>
					<text class="guide-mode">AI 导游</text>
				</view>
				<text class="guide-status">在线 · 景区知识与路线已接入</text>
			</view>
			<view class="voice-toggle" @click="toggleNarration">
				<rice-icon :name="autoNarration ? 'volume-up-fill' : 'volume-mute-fill'" size="19" color="#0b68d0" />
			</view>
		</view>

		<scroll-view class="message-scroll" direction="vertical" :show-scrollbar="false" :scroll-into-view="scrollTarget">
			<view class="message-list">
				<view class="welcome-card">
					<view class="welcome-top">
						<text class="welcome-kicker">SMART GUIDE</text>
						<text class="welcome-capability">知识库增强</text>
					</view>
					<text class="welcome-title">今天想怎么玩？</text>
					<text class="welcome-copy">我可以介绍景点、查询开放信息、推荐路线，也能结合当前位置陪伴讲解。</text>
					<view class="suggestion-row">
						<rice-tag v-for="item in suggestions" :key="item" :text="item" type="primary" round plain-fill @click="useSuggestion(item)" />
					</view>
				</view>

				<view v-for="item in messages" :key="item.id" :id="'message-' + item.id" class="message-item" :class="item.role == 'user' ? 'message-item-user' : 'message-item-assistant'">
					<view v-if="item.role == 'assistant'" class="message-mini-avatar"><image class="message-mini-avatar-image" src="/static/logo.png" mode="aspectFit" /></view>
					<view class="message-bubble" :class="item.role == 'user' ? 'message-bubble-user' : 'message-bubble-assistant'">
						<text class="message-text" :class="item.role == 'user' ? 'message-text-user' : ''">{{ item.content }}</text>
						<view v-if="item.sources.length > 0" class="source-list">
							<text v-for="source in item.sources" :key="source" class="source-chip">资料 · {{ source }}</text>
						</view>
					</view>
				</view>
				<view v-if="sending" class="thinking-row">
					<rice-loading mode="circle" color="#0b68d0" size="20" />
					<text class="thinking-text">正在检索景区知识...</text>
				</view>
				<view id="message-bottom" class="message-bottom"></view>
			</view>
		</scroll-view>

		<view class="composer">
			<view class="composer-main">
				<textarea class="composer-input" v-model="input" :auto-height="true" :adjust-position="false" placeholder="问问景区、路线或服务信息" maxlength="500" />
				<view class="record-button" :class="recording ? 'record-button-active' : ''" @click="toggleRecording">
					<rice-icon :name="recording ? 'pause-fill' : 'voice'" size="19" color="#ffffff" />
				</view>
				<view class="send-button" :class="input.trim().length > 0 ? 'send-button-active' : ''" @click="sendMessage">
					<rice-icon name="arrow-up" size="18" color="#ffffff" />
				</view>
			</view>
			<text class="composer-tip">AI 内容仅供游览参考，请以景区现场公告为准</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import type { ConversationMessage, TtsSegment } from '@/domain/types.uts'
	import { askQuestion, askVoice, fetchChatHistory, synthesizeSpeech } from '@/services/guide-api.uts'
	import { resolveAssetUrl } from '@/services/http.uts'
	import { consumeGuidePrompt } from '@/stores/navigation-context.uts'
	import { ensureVisitorSession } from '@/stores/session.uts'

	type ChatMessageItem = {
		id : number,
		role : string,
		content : string,
		sources : string[]
	}

	const input = ref<string>('')
	const sending = ref<boolean>(false)
	const recording = ref<boolean>(false)
	const autoNarration = ref<boolean>(true)
	const initialized = ref<boolean>(false)
	const scrollTarget = ref<string>('message-bottom')
	const sessionId = ref<string>('')
	const recorderManager = ref<RecorderManager | null>(null)
	const audioContext = ref<InnerAudioContext | null>(null)
	const ttsQueue = ref<TtsSegment[]>([])
	const ttsQueueIndex = ref<number>(0)
	const messages = ref<ChatMessageItem[]>([])
	const suggestions = ref<string[]>(['第一次来怎么玩', '大佛有什么故事', '推荐亲子路线'])

	function scrollToBottom() {
		scrollTarget.value = ''
		nextTick(() => { scrollTarget.value = 'message-bottom' })
	}

	function useSuggestion(value : string) {
		input.value = value
		sendMessage()
	}

	async function sendMessage() {
		const question = input.value.trim()
		if (question.length == 0 || sending.value) return
		input.value = ''
		messages.value.push({ id: Date.now(), role: 'user', content: question, sources: [] })
		sending.value = true
		scrollToBottom()
		try {
			if (sessionId.value.length == 0) sessionId.value = await ensureVisitorSession()
			const result = await askQuestion(question, sessionId.value)
			const sources = (result.sources ?? []).map<string>((source) : string => source.scenicSpotName ?? source.sectionTitle ?? source.documentName ?? '景区知识库')
			messages.value.push({ id: Date.now() + 1, role: 'assistant', content: result.answer, sources })
			if (autoNarration.value) requestTts(result.answer)
		} catch (error) {
			messages.value.push({ id: Date.now() + 1, role: 'assistant', content: '暂时无法连接导游服务，请确认本地 Node 服务与 API 地址配置。', sources: [] })
			console.error('ask guide failed', error)
		} finally {
			sending.value = false
			scrollToBottom()
		}
	}

	async function requestTts(text : string) {
		try {
			const result = await synthesizeSpeech(text)
			ttsQueue.value = result.segments
			ttsQueueIndex.value = 0
			playNextTtsSegment()
		} catch (error) {
			console.error('tts request failed', error)
		}
	}

	async function submitRecordedVoice(filePath : string) {
		if (filePath.length == 0 || sending.value) return
		sending.value = true
		uni.showLoading({ title: '识别并思考中' })
		try {
			if (sessionId.value.length == 0) sessionId.value = await ensureVisitorSession()
			const result = await askVoice(filePath, sessionId.value)
			messages.value.push({ id: Date.now(), role: 'user', content: result.transcript, sources: [] })
			const sources = (result.answer.sources ?? []).map<string>((source) : string => source.scenicSpotName ?? source.sectionTitle ?? source.documentName ?? '景区知识库')
			messages.value.push({ id: Date.now() + 1, role: 'assistant', content: result.answer.answer, sources })
			if (autoNarration.value) {
				ttsQueue.value = result.tts.segments
				ttsQueueIndex.value = 0
				playNextTtsSegment()
			}
		} catch (error) {
			console.error('voice ask failed', error)
			uni.showToast({ title: '语音提问失败，请改用文字输入', icon: 'none' })
		} finally {
			sending.value = false
			uni.hideLoading()
			scrollToBottom()
		}
	}

	function playNextTtsSegment() {
		if (!autoNarration.value || audioContext.value == null || ttsQueueIndex.value >= ttsQueue.value.length) return
		const segment = ttsQueue.value[ttsQueueIndex.value]
		audioContext.value!.src = resolveAssetUrl(segment.audioUrl)
		audioContext.value!.play()
	}

	async function restoreHistory() {
		if (sessionId.value.length == 0) sessionId.value = await ensureVisitorSession()
		const history = await fetchChatHistory(sessionId.value)
		messages.value = history.map<ChatMessageItem>((item : ConversationMessage, index : number) : ChatMessageItem => ({
			id: Date.now() + index,
			role: item.role,
			content: item.content,
			sources: []
		}))
		scrollToBottom()
	}

	function applyPendingPrompt() {
		const prompt = consumeGuidePrompt()
		if (prompt.length == 0) return
		input.value = prompt
		sendMessage()
	}

	function toggleNarration() {
		autoNarration.value = !autoNarration.value
		if (!autoNarration.value) {
			audioContext.value?.stop()
			ttsQueue.value = []
			ttsQueueIndex.value = 0
		}
	}

	function toggleRecording() {
		// #ifdef WEB
		uni.showToast({ title: 'Web 端语音将使用 MediaRecorder 适配器', icon: 'none' })
		return
		// #endif
		// #ifndef WEB
		if (recording.value) recorderManager.value?.stop()
		else recorderManager.value?.start({ format: 'mp3', sampleRate: 16000, numberOfChannels: 1, encodeBitRate: 48000 })
		// #endif
	}

	onLoad(async () => {
		try { await restoreHistory() } catch (error) { console.error('restore chat history failed', error) }
		// #ifndef WEB
		recorderManager.value = uni.getRecorderManager()
		recorderManager.value?.onStart(() => { recording.value = true })
		recorderManager.value?.onStop((result) => {
			recording.value = false
			submitRecordedVoice(result.tempFilePath)
		})
		recorderManager.value?.onError((error) => {
			recording.value = false
			uni.showToast({ title: error.errMsg, icon: 'none' })
		})
		// #endif
		audioContext.value = uni.createInnerAudioContext()
		audioContext.value?.onEnded(() => {
			ttsQueueIndex.value += 1
			playNextTtsSegment()
		})
		audioContext.value?.onError((error) => console.error('audio failed', error))
		initialized.value = true
		applyPendingPrompt()
	})

	onShow(() => {
		if (initialized.value) applyPendingPrompt()
	})

	onUnload(() => {
		recorderManager.value?.stop()
		audioContext.value?.destroy()
	})
</script>

<style>
	.page { flex: 1; background-color: #f3f6fb; }
	.guide-header { padding: 48px 16px 14px; flex-direction: row; align-items: center; background-color: #ffffff; border-bottom: 1px solid #e2e8f2; }
	.guide-avatar { position: relative; width: 48px; height: 48px; border-radius: 16px; overflow: hidden; background: linear-gradient(to bottom right, #0656ae, #10afc1); align-items: center; justify-content: center; box-shadow: 0 7px 18px rgba(11,104,208,0.22); }
	.guide-avatar-image { width: 46px; height: 46px; }
	.online-dot { position: absolute; right: -2px; bottom: -2px; width: 12px; height: 12px; border-radius: 6px; background-color: #49b583; border: 2px solid #ffffff; }
	.guide-heading { flex: 1; margin-left: 11px; }
	.guide-title-row { flex-direction: row; align-items: center; }
	.guide-title { font-size: 18px; font-weight: 800; color: #172741; }
	.guide-mode { font-size: 9px; color: #d17d00; background-color: #fff2d8; padding: 4px 7px; border-radius: 9px; margin-left: 8px; }
	.guide-status { font-size: 11px; color: #738198; margin-top: 4px; }
	.voice-toggle { width: 40px; height: 40px; border-radius: 14px; background-color: #e7f1ff; align-items: center; justify-content: center; }
	.message-scroll { flex: 1; }
	.message-list { padding: 17px 14px 28px; }
	.welcome-card { padding: 19px; border-radius: 24px; background: linear-gradient(to bottom right, #e5f1ff, #e7fbfa 58%, #fff5e4); border: 1px solid #dce8f6; margin-bottom: 22px; }
	.welcome-top { flex-direction: row; align-items: center; justify-content: space-between; }
	.welcome-kicker { font-size: 8px; color: #d17d00; font-weight: 700; letter-spacing: 1px; }
	.welcome-capability { font-size: 9px; color: #0b68d0; background-color: rgba(255,255,255,0.78); padding: 5px 8px; border-radius: 10px; }
	.welcome-title { font-size: 21px; font-weight: 800; color: #174a7e; margin-top: 12px; }
	.welcome-copy { font-size: 13px; line-height: 20px; color: #5d718c; margin-top: 7px; }
	.suggestion-row { flex-direction: row; flex-wrap: wrap; margin-top: 14px; }
	.message-item { flex-direction: row; margin-bottom: 14px; align-items: flex-start; }
	.message-item-user { justify-content: flex-end; }
	.message-item-assistant { justify-content: flex-start; }
	.message-mini-avatar { width: 31px; height: 31px; border-radius: 11px; overflow: hidden; background-color: #0b68d0; align-items: center; justify-content: center; margin-right: 8px; }
	.message-mini-avatar-image { width: 30px; height: 30px; }
	.message-bubble { max-width: 270px; padding: 13px 15px; border-radius: 19px; }
	.message-bubble-user { background: linear-gradient(to bottom right, #0b68d0, #087fb4); border-bottom-right-radius: 6px; box-shadow: 0 7px 18px rgba(11,104,208,0.18); }
	.message-bubble-assistant { background-color: #ffffff; border: 1px solid #e1e8f2; border-bottom-left-radius: 6px; box-shadow: 0 5px 14px rgba(30,65,110,0.04); }
	.message-text { font-size: 14px; line-height: 22px; color: #26364f; }
	.message-text-user { color: #ffffff; }
	.source-list { flex-direction: row; flex-wrap: wrap; margin-top: 9px; }
	.source-chip { font-size: 10px; color: #41698d; background-color: #edf5fc; padding: 5px 7px; margin-right: 5px; margin-bottom: 5px; border-radius: 9px; }
	.thinking-row { flex-direction: row; align-items: center; padding: 10px 0 16px 36px; }
	.thinking-text { font-size: 12px; color: #77849a; margin-left: 8px; }
	.message-bottom { height: 4px; }
	.composer { background-color: #ffffff; padding: 10px 12px 12px; border-top: 1px solid #e2e8f2; }
	.composer-main { flex-direction: row; align-items: flex-end; }
	.composer-input { flex: 1; min-height: 44px; max-height: 112px; padding: 11px 13px; border-radius: 17px; background-color: #f0f4fa; border: 1px solid #e0e7f1; font-size: 14px; }
	.record-button, .send-button { width: 42px; height: 42px; margin-left: 8px; border-radius: 15px; align-items: center; justify-content: center; background-color: #c8d3e1; }
	.record-button-active { background-color: #c45750; }
	.send-button-active { background: linear-gradient(to bottom right, #0b68d0, #099fbd); }
	.composer-tip { font-size: 10px; color: #99a4b4; text-align: center; margin-top: 7px; }
</style>
