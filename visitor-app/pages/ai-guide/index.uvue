<template>
  <view class="page" :class="themeClass">
    <view class="guide-header" :style="headerStyle">
      <view class="guide-heading">
        <view class="location" role="button" tabindex="0" data-sg-keyboard="activate" :aria-label="areaLabel + ' · ' + g('打开地图')" @click="openContextMap">
          <sg-icon name="location" :size="14" /><text class="location-label">{{ locationLabel }}</text><sg-icon name="right" :size="12" />
        </view>
        <text class="guide-title">{{ g('AI 导游') }}</text>
      </view>
      <view class="round-action" role="button" tabindex="0" data-sg-keyboard="activate" :aria-label="g('对话记录')" @click="openPanel('history')"><sg-icon name="comments" :size="22" /></view>
      <view class="round-action" role="button" tabindex="0" data-sg-keyboard="activate" :aria-label="g('导游设置')" @click="openPanel('settings')"><sg-icon name="set" :size="23" /></view>
    </view>

    <!-- #ifdef MP-WEIXIN -->
    <view class="wechat-live2d-overlay" :class="wechatLive2dVisible && !reducedMotion && panel.length == 0 ? '' : 'wechat-live2d-overlay-hidden'" :style="wechatLive2dOverlayStyle">
      <scenic-live2d class="wechat-live2d-overlay-canvas" model="Haru"
        :loading-label="g('正在加载 Live2D 模型')" :error-label="g('Live2D 模型暂不可用')"
        :stage-width="wechatLive2dWidth" :stage-height="wechatLive2dHeight"
        :speaking="digitalHumanState == 'speaking'" :level="amplitudeSource == 'playback' ? amplitude : -1"
        :visible="wechatLive2dVisible && !reducedMotion && panel.length == 0" @modelready="onWechatModelReady" @modelerror="onWechatModelError" />
    </view>
    <!-- #endif -->

    <scroll-view ref="messageScrollRef" class="scene-scroll" direction="vertical" :show-scrollbar="false" @scroll="onSceneScroll">
      <view id="guide-welcome" class="scene-body">
        <view class="stage-frame">
          <sg-guide-stage :height="stageHeight" :photo="scenePhoto" :blend="0.20">
            <view class="stage-layout">
              <view class="stage-identity">
                <view class="orb-space"><sg-ai-ambient-orb :state="interactionState" :level="amplitude" :size="orbDiameter" :active="orbPageActive && panel.length == 0 && stageInView" :reduced-motion="reducedMotion" /></view>
                <text class="stage-kicker">{{ g('随行导游') }}</text>
                <text class="guide-name">{{ stageName }}</text>
                <view class="state-line"><view class="state-dot"></view><text class="state-label" role="status">{{ stateLabel }}</text><text v-if="recording" class="record-clock">{{ recordingClock }}</text></view>
                <guide-level-meter v-if="interactionState == 'LISTENING' || interactionState == 'SPEAKING'" :level="amplitude" :sample-count="sampleCount" :label="g('声音电平')" />
                <text v-if="(interactionState == 'LISTENING' || interactionState == 'SPEAKING') && amplitude < 0" class="meter-note">{{ g('未提供音量') }}</text>
              </view>
              <view id="wechat-live2d-slot" ref="wechatLive2dSlotRef" class="renderer" :class="panel.length > 0 ? 'renderer-covered' : ''">
                <!-- #ifdef MP-WEIXIN -->
                <image v-if="reducedMotion || !wechatLive2dVisible || !wechatLive2dReady" class="haru-portrait" :src="digitalHumanAvatarSource" mode="aspectFit" />
                <!-- #endif -->
                <!-- #ifndef MP-WEIXIN -->
                <web-view v-if="!reducedMotion && digitalHumanMode == 'xfyun' && embeddedAvatarUrl.length > 0 && !embeddedAvatarFailed" id="ai-avatar-webview" class="embedded-avatar-webview"
                  :src="embeddedAvatarUrl" :ios-allows-inline-media-playback="true" @load="handleEmbeddedAvatarLoad" @error="handleEmbeddedAvatarError" @message="handleEmbeddedAvatarMessage" />
                <web-view v-if="hasLive2dSurface" id="live2d-avatar-webview" class="embedded-avatar-webview"
                  :src="live2dAvatarUrl" :ios-allows-inline-media-playback="true" @load="handleLive2dAvatarLoad" @error="handleLive2dAvatarError" @message="handleLive2dAvatarMessage" />
                <image v-if="showStagePortrait"
                  :class="digitalHumanMode == 'live2d' ? 'haru-portrait' : 'cloud-portrait'" :src="digitalHumanAvatarSource" :mode="digitalHumanMode == 'live2d' ? 'aspectFit' : 'aspectFill'" />
                <!-- #endif -->
              </view>
            </view>
          </sg-guide-stage>
        </view>
        <view class="story">
          <guide-subtitle-panel :label="subtitleLabel" :text="displaySubtitle" :question="pendingQuestion" :welcome="isWelcome" :active="orbPageActive && panel.length == 0" :has-more="showFullAnswer" :more-label="g('查看完整回答')" :text-label="g('文字提问')" :short-text-label="g('打字')" @text="openPanel('text')" @history="openPanel('history')" />
          <view v-if="recording || capturePending || finishingRecording || sending || playbackState != 'IDLE'" class="guide-tools">
            <sg-button v-if="recording || capturePending || finishingRecording" :label="g('取消录音')" kind="quiet" @action="cancelRecording" />
            <sg-button v-if="playbackOwner == 'host' && (playbackState == 'PLAYING' || playbackState == 'PAUSED')" :label="g(playbackState == 'PAUSED' ? '继续' : '暂停')" kind="quiet" @action="togglePlayback" />
            <sg-button v-if="sending || playbackState == 'RESPONDING' || playbackState == 'PLAYING' || playbackState == 'PAUSED'" :label="g('停止')" kind="quiet" @action="interruptTurn" />
          </view>
          <voice-action-button v-if="guideBarFailed" :state="interactionState" :locale="locale" :level="amplitude" :elapsed="recordingClock" :pending="capturePending" :finishing="finishingRecording" :host="playbackOwner == 'host'" :disabled="!initialized || clearingHistory" :active="voiceButtonActive"
            @record="toggleRecording" @finishhold="finishHeldRecording" @cancel="cancelRecording" @interrupt="interruptTurn" @resume="togglePlayback" @holdchange="setHolding" />
          <view v-if="voiceError.length > 0" class="error-panel" role="alert">
            <text class="error-text">{{ g(voiceError) }}</text><sg-button :label="g('文字提问')" kind="quiet" @action="openPanel('text')" />
          </view>
          <view v-if="isWelcome" class="ideas">
            <view v-for="(item,index) in suggestions" :key="item" class="idea" role="button" tabindex="0" data-sg-keyboard="activate" @click="useSuggestion(g(item))">
              <view class="idea-content"><sg-icon :name="index == 0 ? 'location' : (index == 1 ? 'headset' : (index == 2 ? 'peoples' : 'camera'))" :size="18" /><text class="idea-label">{{ g(largeText && item == '大佛有什么故事' ? '大佛的故事' : item) }}</text></view><sg-icon name="right" :size="14" />
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <guide-bottom-navigation v-if="guideBarReady" :locale="locale" :label="g('主导航')" :bottom-inset="bottomInset" @leaving="onNavigationLeave" @restored="leavingGuide = false">
      <voice-action-button :state="interactionState" :locale="locale" :level="amplitude" :elapsed="recordingClock" :pending="capturePending" :finishing="finishingRecording" :host="playbackOwner == 'host'" :disabled="!initialized || clearingHistory" :active="voiceButtonActive"
        @record="toggleRecording" @finishhold="finishHeldRecording" @cancel="cancelRecording" @interrupt="interruptTurn" @resume="togglePlayback" @holdchange="setHolding" />
    </guide-bottom-navigation>

    <!-- #ifdef APP -->
    <view v-if="sheetPresent" class="sheet-host" :style="nativeSheetStyle">
    <!-- #endif -->
    <!-- #ifndef APP -->
    <view v-if="sheetPresent" class="sheet-host">
    <!-- #endif -->
    <guide-sheet class="sheet-component" :open="panel.length > 0" :title="panelTitle" :close-label="g('关闭')" :bottom-inset="bottomInset" @close="closePanel" @closed="releaseSheet">
      <view v-if="panelBody == 'history'" class="sheet-content">
        <text v-if="messages.length == 0" class="sheet-note">{{ g('这里会保留你的提问和导游讲解。') }}</text>
        <guide-message-card v-for="item in messages" :key="item.id" :locale="locale" :kind="item.kind ?? ''" :user="item.role == 'user'" :content="item.content" :sources="item.sources" :busy="recording || sending || capturePending" @read="readFromHistory(item.content)" />
        <sg-button v-if="messages.length > 0" :label="g('清除记录')" kind="secondary" :disabled="!canClearHistory" @action="requestClearHistory" />
      </view>
      <view v-if="panelBody == 'text'" class="sheet-content">
        <textarea id="guide-question" class="question-input" v-model="input" :focus="focusQuestion" :adjust-position="true"
          :style="questionTextStyle" :placeholder-style="questionPlaceholderStyle" :placeholder="g('问景点、路线或服务')" :aria-label="g('文字提问')" :maxlength="500" />
        <sg-button :label="g('发送')" :disabled="input.trim().length == 0 || conversationBusy || !initialized" @action="sendFromSheet" />
      </view>
      <view v-if="panelBody == 'settings'" class="sheet-content">
        <text class="setting-title">{{ digitalHumanTitle }}</text>
        <text class="sheet-note">{{ digitalHumanProviderStatus }}</text>
        <sg-choice :label="g('自动播报')" :selected="autoNarration" @action="toggleNarration" />
        <view class="motion-setting">
          <sg-choice v-if="!systemRequiresReducedMotion" :label="g('减少动态效果')" :selected="reduceMotionPreference" @action="toggleGuideMotion" />
          <text v-else class="sheet-note">{{ g('系统已开启减少动态效果') }}</text>
        </view>
        <!-- #ifndef MP-WEIXIN -->
        <text class="setting-title separated">{{ g('导游形象') }}</text>
        <view class="choices"><sg-choice :label="g('讯飞')" :selected="digitalHumanMode == 'xfyun'" @action="selectDigitalHumanMode('xfyun')" /><sg-choice :label="g('Live2D模型')" :selected="digitalHumanMode == 'live2d'" @action="selectDigitalHumanMode('live2d')" /></view>
        <sg-button v-if="embeddedAvatarFailed && digitalHumanMode == 'xfyun' && !reducedMotion" :label="g('重新连接云端形象')" kind="quiet" @action="initializeEmbeddedAvatar(true)" />
        <sg-button v-if="live2dAvatarFailed && digitalHumanMode == 'live2d' && !reducedMotion" :label="g('重试')" kind="quiet" @action="initializeLive2dAvatar(true)" />
        <!-- #endif -->
        <text class="sheet-note separated">{{ g('当前录音使用普通话识别，播报使用已配置的导游音色。') }}</text>
        <text class="sheet-note">{{ g('游览信息请以景区现场公告为准') }}</text>
      </view>
    </guide-sheet>
    </view>
  </view>
</template>

<script setup lang="uts">
	import { stageUrl } from '@/design/stage-presentation.uts'
	import { useGuideLanguage } from '@/design/guide-locale.uts'
	const { locale, g } = useGuideLanguage()
	let stageLocale = locale.value
	import { useScenicInsets } from '@/design/layout.uts'
	import { themeClass, themeColor, largeText } from '@/design/theme.uts'
	import { reducedMotion, reduceMotionPreference, setReduceMotionPreference, systemRequiresReducedMotion } from '@/design/motion.uts'
	import { GuideRequestScope, useGuideAudio } from '@/stores/guide-audio.uts'
	// #ifdef MP-WEIXIN
	import { createWechatRecorder, measureWechatSegment } from '@/services/wechat-audio.js'
	let pcmCapture = true
	let stopSegmentAnalysis : (() => void) | null = null
	// #endif
	// #ifdef WEB
	import { createWebRecording } from '@/services/web-recording.js'
	import { createWebNarrationPlayer } from '@/services/web-narration.js'
	// #endif
	import type { ConversationMessage, DigitalHumanConfig, TtsSegment } from '@/domain/types.uts'
	import { askQuestion, askVoice, clearChatHistory, createDefaultDigitalHumanConfig, createDigitalHumanWebSession, fetchChatHistory, fetchDigitalHumanConfig, fetchDigitalHumanConfigs, synthesizeSpeech } from '@/services/guide-api.uts'
	import { resolveAssetUrl } from '@/services/http.uts'
	import { getDigitalHumanRenderMode, getSelectedDigitalHumanId, setDigitalHumanRenderMode } from '@/stores/guide-preferences.uts'
	import { consumeGuidePrompt } from '@/stores/navigation-context.uts'
	import { ensureVisitorSession } from '@/stores/session.uts'

	type ChatMessageItem = {
		id : number,
		role : string,
		content : string,
		kind ?: string,
		sources : string[]
	}

	const { headerStyle, guideBarReady, guideBarFailed, bottomInset } = useScenicInsets(true)
	const viewportWidth = ref(uni.getWindowInfo().windowWidth)
	onResize(() => {
		viewportWidth.value = uni.getWindowInfo().windowWidth
		syncWeChatLive2dOverlay(true)
	})
	const input = ref<string>('')
	const guideAudio = useGuideAudio()
	const { sending, recording, capturePending, finishingRecording, voiceError, playbackState, playbackOwner, interactionState, amplitude, amplitudeSource, sampleCount, activeSubtitle, orbPageActive } = guideAudio
	const clearingHistory = ref<boolean>(false)
	const recordedSeconds = ref(0)
	let clockTimer : number | null = null
	const recordingClock = computed<string>(() => {
		const seconds = recordedSeconds.value % 60
		return Math.floor(recordedSeconds.value / 60).toString() + ':' + (seconds < 10 ? '0' : '') + seconds.toString()
	})
	function syncRecordingClock(active : boolean) {
		if (clockTimer != null) clearInterval(clockTimer!)
		clockTimer = null
		recordedSeconds.value = 0
		if (!active) return
		const startedAt = Date.now()
		clockTimer = setInterval(() => { recordedSeconds.value = Math.floor((Date.now() - startedAt) / 1000) }, 1000)
	}
	watch(recording, (active : boolean) => { syncRecordingClock(active) })
	let captureCancelled = false
	let captureRevision = 0
	const questionRequest = new GuideRequestScope()
	let meterTimer : number | null = null
	let cloudProtocol = 0
	let localProtocol = 0
	let pageVisible = true
	const speechRequest = new GuideRequestScope()
	let destroyed = false
	// #ifdef WEB
	let browserRecording : ReturnType<typeof createWebRecording> | null = null
	// #endif
	const autoNarration = ref<boolean>(true)
	const initialized = ref<boolean>(false)
	const digitalHuman = ref<DigitalHumanConfig | null>(createDefaultDigitalHumanConfig())
	const digitalHumanConfigs = ref<DigitalHumanConfig[]>([])
	const digitalHumanMode = ref<string>(getDigitalHumanRenderMode())
	const digitalHumanState = ref<string>('idle')
	const embeddedAvatarUrl = ref<string>('')
	const embeddedAvatarLoaded = ref<boolean>(false)
	const embeddedAvatarPageLoaded = ref<boolean>(false)
	const embeddedAvatarFailed = ref<boolean>(false)
	const embeddedAvatarCreating = ref<boolean>(false)
	const embeddedAvatarRuntimeStatus = ref<string>('正在连接讯飞动态形象')
	const live2dAvatarUrl = ref<string>('')
	const live2dAvatarLoaded = ref<boolean>(false)
	const live2dAvatarPageLoaded = ref<boolean>(false)
	const live2dAvatarFailed = ref<boolean>(false)
	const live2dAvatarCreating = ref<boolean>(false)
	const live2dAvatarRuntimeStatus = ref<string>('正在加载 Live2D 模型')
	// #ifdef APP-ANDROID
	const androidStageReady = ref<boolean>(false)
	let androidStageTimer : number | null = null
	let androidAttachTimer : number | null = null
	let androidPageLaidOut = false
	let androidStageRetried = false
	// #endif
	const messageScrollRef = shallowRef<UniElement | null>(null)
	const wechatLive2dSlotRef = shallowRef<UniElement | null>(null)
	const wechatLive2dVisible = ref<boolean>(false)
	const wechatLive2dReady = ref(false)
	const wechatLive2dFailed = ref(false)
	const wechatLive2dLeft = ref<number>(0)
	const wechatLive2dTop = ref<number>(0)
	const wechatLive2dWidth = ref<number>(0)
	const wechatLive2dHeight = ref<number>(0)
	let wechatLayoutRevision = 0
	const sessionId = ref<string>('')
	const recorderManager = shallowRef<RecorderManager | null>(null)
	const audioContext = shallowRef<InnerAudioContext | null>(null)
	const ttsQueue = ref<TtsSegment[]>([])
	const pendingLive2dSpeechUrls = ref<string[]>([])
	let live2dSpeechSegments : TtsSegment[] = []
	const ttsQueueIndex = ref<number>(0)
	const messages = ref<ChatMessageItem[]>([])
	const currentInstance = getCurrentInstance()
	let avatarWebViewContext = null as WebviewContext | null
	let live2dWebViewContext = null as WebviewContext | null
	let embeddedSpeechResetTimer : number | null = null
	let embeddedAvatarRevealTimer : number | null = null
	let wechatLive2dSettleTimer : number | null = null
	let pendingEmbeddedSpeech = ''
	let activeEmbeddedSpeech = ''
	let embeddedAvatarGeneration = 0
	const digitalHumanTitle = computed<string>(() => digitalHuman.value?.name ?? g('灵小游'))
	const digitalHumanAvatarSource = computed<string>(() => digitalHumanMode.value == 'xfyun' ? '/static/digital-human/guide-xfyun.webp' : '/static/digital-human/guide-haru-transparent.webp')
	const wechatLive2dOverlayStyle = computed<Map<string, string>>(() => {
		const style = new Map<string, string>()
		style.set('left', `${wechatLive2dLeft.value}px`)
		style.set('top', `${wechatLive2dTop.value}px`)
		style.set('width', `${wechatLive2dWidth.value}px`)
		style.set('height', `${wechatLive2dHeight.value}px`)
		return style
	})
	const voiceState = computed<string>(() => {
		if (recording.value) return 'RECORDING'
		if (sending.value || capturePending.value || finishingRecording.value) return 'PROCESSING'
		if (voiceError.value.length > 0) return 'ERROR'
		return playbackState.value
	})
	const voiceStatusText = computed<string>(() => {
		if (voiceState.value == 'ERROR') return g(voiceError.value)
		if (capturePending.value) return g('正在等待麦克风')
		if (voiceState.value == 'RECORDING') return g('正在录音 · 发送或取消')
		if (voiceState.value == 'PROCESSING') return g('正在处理提问')
		if (voiceState.value == 'RESPONDING') return g('正在准备播报')
		if (voiceState.value == 'PLAYING') return g('正在播报')
		if (voiceState.value == 'PAUSED') return g('播报已暂停')
		return g('可以打字或录音提问')
	})
	const canClearHistory = computed<boolean>(() => messages.value.length > 0 && !sending.value && !clearingHistory.value && !recording.value && !capturePending.value && !finishingRecording.value)
	const hasLive2dSurface = computed<boolean>(() => {
		// #ifdef APP-ANDROID
		if (!androidStageReady.value) return false
		// #endif
		return !reducedMotion.value && digitalHumanMode.value == 'live2d' &&
			live2dAvatarUrl.value.length > 0 && !live2dAvatarFailed.value
	})
	const showStagePortrait = computed<boolean>(() => {
		if (digitalHumanMode.value != 'live2d') return reducedMotion.value || embeddedAvatarFailed.value || !embeddedAvatarLoaded.value
		// The Android WebView paints independently of its model-ready message.
		// Its document owns loading as well as the first rendered character.
		// #ifdef APP-ANDROID
		return !hasLive2dSurface.value
		// #endif
		// #ifndef APP-ANDROID
		return !hasLive2dSurface.value || !live2dAvatarLoaded.value
		// #endif
	})
	const digitalHumanProviderStatus = computed<string>(() => {
		if (reducedMotion.value) return g('静态形象 · 可使用语音朗读')
		if (digitalHuman.value == null) return g('正在载入数字人配置')
		if (digitalHuman.value!.serviceStatus != 'online') return g('数字人服务降级 · 文字问答仍可使用')
		const voice = digitalHuman.value!.vcn.length > 0 ? g('专属音色已接入') : g('默认音色')
		// #ifdef MP-WEIXIN
		if (wechatLive2dFailed.value) return g('Live2D 模型暂不可用') + ' · ' + voice
		return g(wechatLive2dReady.value ? 'Live2D 模型在线' : '正在加载 Live2D 模型') + ' · ' + voice
		// #endif
		if (digitalHumanMode.value == 'xfyun') return g(embeddedAvatarRuntimeStatus.value) + ' · ' + voice
		// #ifndef MP-WEIXIN
		return g(live2dAvatarRuntimeStatus.value) + ' · ' + voice
		// #endif
		return g('Live2D 模型') + ' · ' + voice
	})

	async function loadDigitalHumanPreference() {
		try {
			const configs = await fetchDigitalHumanConfigs()
			digitalHumanConfigs.value = configs
			applyDigitalHumanConfigForMode()
			return
		} catch (error) {
			console.error('load digital human list failed', error)
		}
		try { digitalHuman.value = await fetchDigitalHumanConfig() } catch (error) { console.error('load digital human failed', error) }
	}

	function applyDigitalHumanConfigForMode() {
		const configs = digitalHumanConfigs.value
		if (configs.length == 0) return
		const selectedId = getSelectedDigitalHumanId()
		const desiredEngine = digitalHumanMode.value
		let selected = configs.find((item : DigitalHumanConfig) : boolean => item.id == selectedId && item.engine == desiredEngine) ?? null
		if (selected == null) {
			const preferredId = desiredEngine == 'xfyun' ? 'dh_xf_daolan_female_a' : 'dh_l2d_haru'
			selected = configs.find((item : DigitalHumanConfig) : boolean => item.id == preferredId) ?? null
		}
		if (selected == null) selected = configs.find((item : DigitalHumanConfig) : boolean => item.engine == desiredEngine && item.serviceStatus == 'online') ?? null
		if (selected != null) digitalHuman.value = selected
	}

	async function syncWeChatLive2dOverlay(showWhenVisible : boolean) {
		// #ifdef MP-WEIXIN
		const revision = ++wechatLayoutRevision
		await nextTick()
		if (!pageVisible || wechatLive2dSlotRef.value == null || messageScrollRef.value == null) return
		const slotRect = await wechatLive2dSlotRef.value!.getBoundingClientRectAsync()
		const scrollRect = await messageScrollRef.value!.getBoundingClientRectAsync()
		if (!pageVisible || revision != wechatLayoutRevision || slotRect == null || scrollRect == null) return
		if (slotRect.width < 16 || slotRect.height < 16) { wechatLive2dVisible.value = false; return }
		wechatLive2dLeft.value = slotRect.left
		wechatLive2dTop.value = slotRect.top
		wechatLive2dWidth.value = slotRect.width
		wechatLive2dHeight.value = slotRect.height
		wechatLive2dVisible.value = showWhenVisible &&
			slotRect.top >= scrollRect.top &&
			slotRect.bottom <= scrollRect.bottom
		// #endif
	}

	function onWechatModelReady() { wechatLive2dReady.value = true; wechatLive2dFailed.value = false }
	function onWechatModelError() { wechatLive2dReady.value = false; wechatLive2dFailed.value = true }

	function handleMessageScroll(_event : UniScrollEvent) {
		// #ifdef MP-WEIXIN
		wechatLayoutRevision++
		wechatLive2dVisible.value = false
		if (wechatLive2dSettleTimer != null) clearTimeout(wechatLive2dSettleTimer!)
		wechatLive2dSettleTimer = setTimeout(() => {
			wechatLive2dSettleTimer = null
			syncWeChatLive2dOverlay(true)
		}, 160)
		// #endif
	}

	function useSuggestion(value : string) {
		if (sending.value || recording.value || capturePending.value || finishingRecording.value || clearingHistory.value) return
		input.value = value
		sendMessage()
	}

	async function selectDigitalHumanMode(mode : string) {
		let nextMode = mode == 'live2d' ? 'live2d' : 'xfyun'
		// #ifdef MP-WEIXIN
		// 个人版小程序不能使用讯飞动态数字人 WebView，只保留本地 Live2D 模式。
		nextMode = 'live2d'
		// #endif
		if (digitalHumanMode.value != nextMode) {
			stopNarration()
			// Stop any local TTS before changing renderer. This prevents a queued
			// segment from speaking underneath the newly mounted WebView.
			audioContext.value?.stop()
			ttsQueue.value = []
			ttsQueueIndex.value = 0
			if (digitalHumanMode.value == 'xfyun') resetEmbeddedAvatar()
			else resetLive2dAvatar()
			digitalHumanMode.value = nextMode
			setDigitalHumanRenderMode(nextMode)
			applyDigitalHumanConfigForMode()
		}
		if (nextMode == 'xfyun') await initializeEmbeddedAvatar(false)
		else await initializeLive2dAvatar(false)
	}

	function clearEmbeddedAvatarRevealTimer() {
		if (embeddedAvatarRevealTimer != null) {
			clearTimeout(embeddedAvatarRevealTimer!)
			embeddedAvatarRevealTimer = null
		}
	}

	function scheduleEmbeddedAvatarRevealFallback() {
		clearEmbeddedAvatarRevealTimer()
		embeddedAvatarRevealTimer = setTimeout(() => {
			embeddedAvatarRevealTimer = null
			if (digitalHumanMode.value != 'xfyun' || embeddedAvatarFailed.value || !embeddedAvatarPageLoaded.value) return

			embeddedAvatarLoaded.value = true
			embeddedAvatarRuntimeStatus.value = '舞台页面已载入，等待形象就绪'
			flushPendingEmbeddedSpeech()
		}, 9000)
	}

	function resetEmbeddedAvatar(stopHost : boolean = true) {
		cloudProtocol = 0
		guideAudio.reconnecting.value = false

		clearEmbeddedAvatarRevealTimer()
		embeddedAvatarGeneration += 1
		disposeEmbeddedAvatar()
		if (embeddedSpeechResetTimer != null) clearTimeout(embeddedSpeechResetTimer!)
		embeddedSpeechResetTimer = null
		if (stopHost) {
			audioContext.value?.stop()
			ttsQueue.value = []
			ttsQueueIndex.value = 0
			digitalHumanState.value = 'idle'
		}
		embeddedAvatarUrl.value = ''
		embeddedAvatarLoaded.value = false
		embeddedAvatarPageLoaded.value = false
		embeddedAvatarFailed.value = false
		embeddedAvatarCreating.value = false
		embeddedAvatarRuntimeStatus.value = '正在连接讯飞动态形象'
		avatarWebViewContext = null
	}

	function resetLive2dAvatar() {
		// #ifdef APP-ANDROID
		clearAndroidStageTimer()
		androidStageRetried = false
		// #endif
		localProtocol = 0
		interruptLive2dAvatar()
		live2dAvatarUrl.value = ''
		live2dAvatarLoaded.value = false
		live2dAvatarPageLoaded.value = false
		live2dAvatarFailed.value = false
		live2dAvatarCreating.value = false
		live2dAvatarRuntimeStatus.value = '正在加载 Live2D 模型'
		live2dWebViewContext = null
	}

	async function initializeLive2dAvatar(force : boolean) {
		// #ifdef MP-WEIXIN
		return
		// #endif
		// #ifndef MP-WEIXIN
		if (reducedMotion.value || digitalHumanMode.value != 'live2d' || live2dAvatarCreating.value) return
		if (!force && live2dAvatarUrl.value.length > 0) return
		live2dAvatarCreating.value = true
		if (force) {
			resetLive2dAvatar()
			live2dAvatarCreating.value = true
		}
		live2dAvatarFailed.value = false
		live2dAvatarRuntimeStatus.value = '正在创建 Live2D 模型舞台'
		try {
			const modelId = digitalHuman.value?.modelId ?? 'Haru'
			live2dAvatarUrl.value = stageUrl(resolveAssetUrl('/live2d/?model=' + encodeURIComponent(modelId) + '&embed=1'), locale.value)
			live2dAvatarRuntimeStatus.value = 'Live2D 模型正在启动'
		} catch (error) {
			live2dAvatarFailed.value = true
			live2dAvatarRuntimeStatus.value = 'Live2D 模型暂不可用'
			console.error('create live2d avatar failed', error)
		} finally {
			live2dAvatarCreating.value = false
		}
		// #endif
	}

	async function initializeEmbeddedAvatar(force : boolean) {
		// #ifdef MP-WEIXIN
		return
		// #endif
		// #ifndef MP-WEIXIN
		if (reducedMotion.value || digitalHumanMode.value != 'xfyun' || embeddedAvatarCreating.value) return
		if (!force && embeddedAvatarUrl.value.length > 0) return
		const config = digitalHuman.value
		if (config == null || config.engine != 'xfyun' || !config.assetAvailable) {
			embeddedAvatarFailed.value = true
			return
		}
		embeddedAvatarCreating.value = true

		if (force) {
			embeddedAvatarGeneration += 1
			disposeEmbeddedAvatar()
			embeddedAvatarUrl.value = ''
			embeddedAvatarLoaded.value = false
			embeddedAvatarPageLoaded.value = false
			avatarWebViewContext = null
		}
		const generation = embeddedAvatarGeneration
		embeddedAvatarFailed.value = false
		embeddedAvatarRuntimeStatus.value = '正在创建讯飞安全会话'
		try {
			const session = await createDigitalHumanWebSession(config.id)
			if (generation != embeddedAvatarGeneration || digitalHumanMode.value != 'xfyun') return
			const pageUrl = resolveAssetUrl(session.pageUrl)
			const separator = pageUrl.indexOf('?') >= 0 ? '&' : '?'
			embeddedAvatarUrl.value = stageUrl(pageUrl + separator + 'embed=1&autostart=1&welcome=0', locale.value)
		} catch (error) {
			if (generation != embeddedAvatarGeneration || digitalHumanMode.value != 'xfyun') return

			embeddedAvatarFailed.value = true
			embeddedAvatarRuntimeStatus.value = '讯飞动态形象暂不可用'
			fallbackEmbeddedSpeech()
			console.error('create embedded digital human failed', error)
		} finally {
			if (generation == embeddedAvatarGeneration) embeddedAvatarCreating.value = false
		}
		// #endif
	}

	function handleEmbeddedAvatarLoad() {
		embeddedAvatarPageLoaded.value = true
		embeddedAvatarFailed.value = false
		embeddedAvatarRuntimeStatus.value = '讯飞页面已载入，正在启动形象'
		// #ifdef APP
		avatarWebViewContext = uni.createWebViewContext('ai-avatar-webview', currentInstance?.proxy)
		// The current uni-app x bridge exposes uni.webView.postMessage, while the
		// controlled runtime still accepts the legacy uni.postMessage alias. Wait
		// for the official bridge, install a narrow compatibility forwarder, and
		// immediately request the current SDK state so an already-ready avatar can
		// replace the skeleton without waiting for another runtime transition.
		avatarWebViewContext?.evalJS('(function installScenicHostBridge(attempt){if(window.uni&&window.uni.webView&&typeof window.uni.webView.postMessage==="function"){window.uni.postMessage=function(payload){window.uni.webView.postMessage(payload)};if(window.scenicAvatarPing)window.scenicAvatarPing();return}if(attempt<100)setTimeout(function(){installScenicHostBridge(attempt+1)},100)})(0)')
		flushPendingEmbeddedSpeech()
		// #endif
		scheduleEmbeddedAvatarRevealFallback()
	}

	function handleEmbeddedAvatarError(event : WebViewErrorEvent) {
		console.warn('embedded digital human resource warning', event.detail.errCode, event.detail.errMsg, event.detail.fullUrl)
		// ArkWeb also reports recoverable SDK sub-resource warnings through this
		// event. Only a failure of the top-level document should replace the stage.
		if (!embeddedAvatarPageLoaded.value && event.detail.url == embeddedAvatarUrl.value) {

			embeddedAvatarFailed.value = true
			embeddedAvatarRuntimeStatus.value = '讯飞页面载入失败'
			fallbackEmbeddedSpeech()
		}
	}

	function handleEmbeddedAvatarMessage(event : UniWebViewMessageEvent) {
		const packets = event.detail.data
		packets.forEach((packet : UTSJSONObject) => {
			if (packet.getString('source', '') != 'scenic-digital-human') return
			const type = packet.getString('type', '')
			cloudProtocol = packet.getNumber('speechProtocol', 0)
			if ((type == 'speaking' || type == 'idle' || type == 'subtitle' || type == 'speech-timeout' || type == 'speech-dispatched' || type == 'speech-accepted') && packet.getNumber('requestId', -1) != speechRequest.id) return
			if (type == 'subtitle' && playbackOwner.value == 'cloud' && pageVisible) {
				const start = packet.getNumber('start', -1)
				const length = packet.getNumber('length', 0)
				if (start >= 0 && length > 0 && start + length <= activeEmbeddedSpeech.length) activeSubtitle.value = activeEmbeddedSpeech.substring(start, start + length)
				return
			}
			if (type == 'page-loaded') {
				embeddedAvatarPageLoaded.value = true
				embeddedAvatarRuntimeStatus.value = '讯飞页面已载入，正在启动形象'
				flushPendingEmbeddedSpeech()
				return
			}
			if (type == 'starting' || type == 'connected') {
				embeddedAvatarLoaded.value = false
				embeddedAvatarRuntimeStatus.value = type == 'connected' ? '讯飞已连接，正在加载画面' : '讯飞动态形象正在启动'
				return
			}
			if (type == 'ready' || (type == 'runtime-state' && packet.getBoolean('ready', false))) {
				clearEmbeddedAvatarRevealTimer()

				embeddedAvatarLoaded.value = true
				guideAudio.reconnecting.value = false
				embeddedAvatarFailed.value = false
				embeddedAvatarRuntimeStatus.value = '讯飞云动态形象在线'
				flushPendingEmbeddedSpeech()
				return
			}
			if (type == 'speech-accepted' || type == 'speech-dispatched') {
				embeddedAvatarRuntimeStatus.value = '回答已送达讯飞，等待播报'
				return
			}
			if (type == 'speaking') {
				if (playbackOwner.value != 'cloud' || !pageVisible) return
				playbackState.value = 'PLAYING'
				digitalHumanState.value = 'speaking'
				embeddedAvatarRuntimeStatus.value = '讯飞数字人正在讲解'
				return
			}
			if (type == 'idle') {
				if (playbackOwner.value != 'cloud' || packet.getString('reason', '') == 'interrupted') return
				finishPlayback()
				if (embeddedSpeechResetTimer != null) clearTimeout(embeddedSpeechResetTimer!)
				embeddedSpeechResetTimer = null
				digitalHumanState.value = 'idle'
				activeEmbeddedSpeech = ''
				embeddedAvatarRuntimeStatus.value = '讯飞云动态形象在线'
				return
			}
			if (type == 'disconnected') {
				embeddedAvatarLoaded.value = false
				const retrying = packet.getBoolean('retrying', false)
				guideAudio.reconnecting.value = retrying
				guideAudio.resetMeter()
				embeddedAvatarRuntimeStatus.value = retrying ? '讯飞连接中断，正在自动重连' : '讯飞连接已中断'
				if (!retrying) failEmbeddedAvatar()
				return
			}
			if (type == 'error' || type == 'fatal') {
				guideAudio.reconnecting.value = false
				embeddedAvatarRuntimeStatus.value = '讯飞动态形象暂不可用'
				failEmbeddedAvatar()
			}
			if (type == 'speech-timeout' && playbackOwner.value == 'cloud') {
				stopNarration()
				voiceError.value = '语音暂不可用，可阅读回答或稍后重试'
			}
		})
	}

	function handleLive2dAvatarLoad() {
		if (!hasLive2dSurface.value || destroyed) return
		// #ifdef APP-ANDROID
		clearAndroidStageTimer()
		// #endif
		live2dAvatarPageLoaded.value = true
		if (!live2dAvatarLoaded.value) live2dAvatarRuntimeStatus.value = 'Live2D 页面已加载，正在启动模型'
		// #ifdef APP
		live2dWebViewContext = uni.createWebViewContext('live2d-avatar-webview', currentInstance?.proxy)
		live2dWebViewContext?.evalJS('window.scenicLive2dPing && window.scenicLive2dPing()')
		flushPendingLive2dSpeech()
		// #endif
	}

	function handleLive2dAvatarError(event : WebViewErrorEvent) {
		console.warn('live2d resource warning', event.detail.errCode, event.detail.errMsg, event.detail.fullUrl)
		if (!live2dAvatarPageLoaded.value && event.detail.url == live2dAvatarUrl.value) {
			live2dAvatarFailed.value = true
			live2dAvatarRuntimeStatus.value = 'Live2D 页面加载失败'
			fallbackLive2dSpeech()
		}
	}

	function handleLive2dAvatarMessage(event : UniWebViewMessageEvent) {
		if (!hasLive2dSurface.value || destroyed) return
		const packets = event.detail.data
		packets.forEach((packet : UTSJSONObject) => {
			// Android Vapor delivers JSON fields without UTSJSONObject instance methods.
			if (packet['source'] != 'scenic-live2d') return
			// #ifdef APP-ANDROID
			clearAndroidStageTimer()
			// #endif
			const type = packet['type'] as string | null
			localProtocol = (packet['speechProtocol'] as number | null) ?? 0
			if ((type == 'speaking' || type == 'idle' || type == 'level' || type == 'audio-blocked') && packet['requestId'] != speechRequest.id) return
			if (type == 'level') {
				if (playbackOwner.value != 'live2d' || !pageVisible) return
				guideAudio.sample('playback', (packet['level'] as number | null) ?? -1)
				const index = (packet['segment'] as number | null) ?? -1
				if (index >= 0 && index < live2dSpeechSegments.length) activeSubtitle.value = live2dSpeechSegments[index].text
				return
			}
			if (type == 'page-loaded') {
				live2dAvatarPageLoaded.value = true
				if (!live2dAvatarLoaded.value) live2dAvatarRuntimeStatus.value = 'Live2D 页面已加载，正在启动模型'
				flushPendingLive2dSpeech()
				return
			}
			if (type == 'ready' || (type == 'runtime-state' && packet['ready'] == true)) {
				live2dAvatarLoaded.value = true
				live2dAvatarFailed.value = false
				live2dAvatarRuntimeStatus.value = 'Live2D 模型在线'
				flushPendingLive2dSpeech()
				return
			}
			if (type == 'speaking') {
				if (playbackOwner.value != 'live2d' || !pageVisible) return
				playbackState.value = 'PLAYING'
				digitalHumanState.value = 'speaking'
				live2dAvatarRuntimeStatus.value = 'Live2D 正在同步口型'
				return
			}
			if (type == 'idle') {
				if (playbackOwner.value != 'live2d' || packet['interrupted'] == true) return
				finishPlayback()
				digitalHumanState.value = 'idle'
				live2dAvatarRuntimeStatus.value = 'Live2D 模型在线'
				return
			}
			if (type == 'error' || type == 'audio-blocked') {
				live2dAvatarRuntimeStatus.value = 'Live2D 模型暂不可用'
				live2dAvatarFailed.value = type == 'error'
				fallbackLive2dSpeech()
			}
		})
	}

	function speakThroughEmbeddedAvatar(text : string) : boolean {
		if (reducedMotion.value || digitalHumanMode.value != 'xfyun' || embeddedAvatarFailed.value) return false
		if (cloudProtocol < 2) return false
		const speechText = text.length > 1200 ? text.slice(0, 1200) : text
		if (speechText.length == 0) return false
		// A duplicated answer can be delivered by both the WebView ready event
		// and the host flush path. Keep one pending/active utterance only.
		if (pendingEmbeddedSpeech == speechText || activeEmbeddedSpeech == speechText) return true
		if (activeEmbeddedSpeech.length > 0) interruptEmbeddedAvatar()
		// Switching from local TTS to the cloud avatar must also stop the local
		// audio queue, otherwise both renderers speak at the same time.
		audioContext.value?.stop()
		ttsQueue.value = []
		ttsQueueIndex.value = 0
		pendingEmbeddedSpeech = speechText
		activeEmbeddedSpeech = pendingEmbeddedSpeech
		let delegated = false
		// #ifdef APP
		delegated = embeddedAvatarUrl.value.length > 0 || embeddedAvatarCreating.value
		if (embeddedAvatarPageLoaded.value && avatarWebViewContext != null) {
			flushPendingEmbeddedSpeech()
			delegated = true
		}
		if (!delegated) {
			initializeEmbeddedAvatar(false)
			delegated = !embeddedAvatarFailed.value
		}
		// #endif
		// #ifndef APP
		pendingEmbeddedSpeech = ''
		activeEmbeddedSpeech = ''
		return false
		// #endif
		if (!delegated) {
			pendingEmbeddedSpeech = ''
			activeEmbeddedSpeech = ''
		}
		if (delegated) {
			playbackOwner.value = 'cloud'
			scheduleEmbeddedSpeechReset(text)
		}
		return delegated
	}

	function speakThroughLive2d(segments : TtsSegment[]) : boolean {
		// #ifndef APP
		return false
		// #endif
		// #ifdef APP
		if (reducedMotion.value || digitalHumanMode.value != 'live2d' || live2dAvatarFailed.value || segments.length == 0 || localProtocol < 2) return false
		live2dSpeechSegments = segments
		const audioUrls = segments.map<string>((segment : TtsSegment) : string => resolveAssetUrl(segment.audioUrl))
		playbackOwner.value = 'live2d'
		if (live2dAvatarPageLoaded.value && live2dWebViewContext != null) {
			const payload = JSON.stringify(audioUrls) as string
			live2dWebViewContext!.evalJS('window.scenicLive2dSpeak && window.scenicLive2dSpeak(' + payload + ',' + speechRequest.id.toString() + ')')
			return true
		}
		// Keep one bounded batch until the model's page-loaded event arrives.
		pendingLive2dSpeechUrls.value = audioUrls
		initializeLive2dAvatar(false)
		return true
		// #endif
	}

	function flushPendingLive2dSpeech() {
		// #ifdef APP
		if (!live2dAvatarPageLoaded.value || live2dWebViewContext == null || pendingLive2dSpeechUrls.value.length == 0) return
		const payload = JSON.stringify(pendingLive2dSpeechUrls.value) as string
		live2dWebViewContext!.evalJS('window.scenicLive2dSpeak && window.scenicLive2dSpeak(' + payload + ',' + speechRequest.id.toString() + ')')
		pendingLive2dSpeechUrls.value = []
		// #endif
	}

	function fallbackLive2dSpeech() {
		const segments = live2dSpeechSegments
		live2dSpeechSegments = []
		pendingLive2dSpeechUrls.value = []
		if (segments.length == 0 || playbackOwner.value != 'live2d' || !pageVisible) return
		interruptLive2dAvatar()
		playbackOwner.value = 'host'
		// The URLs are already synthesized; play them through the normal host
		// queue only when the real model cannot start.
		startHostQueue(segments)
	}

	function flushPendingEmbeddedSpeech() {
		// #ifdef APP
		if (!embeddedAvatarPageLoaded.value || avatarWebViewContext == null || pendingEmbeddedSpeech.length == 0) return
		const payload = JSON.stringify(pendingEmbeddedSpeech) as string
		avatarWebViewContext!.evalJS('window.scenicAvatarSpeak && window.scenicAvatarSpeak(' + payload + ',' + speechRequest.id.toString() + ')')
		pendingEmbeddedSpeech = ''
		// #endif
	}

	function interruptEmbeddedAvatar() {
		// #ifdef APP
		avatarWebViewContext?.evalJS('window.scenicAvatarInterrupt && window.scenicAvatarInterrupt()')
		// #endif
		activeEmbeddedSpeech = ''
		pendingEmbeddedSpeech = ''
	}

	function disposeEmbeddedAvatar() {
		interruptEmbeddedAvatar()
		// #ifdef APP
		avatarWebViewContext?.evalJS('window.scenicAvatarDispose && window.scenicAvatarDispose()')
		// #endif
	}

	function interruptLive2dAvatar() {
		// #ifdef APP
		live2dWebViewContext?.evalJS('window.scenicLive2dInterrupt && window.scenicLive2dInterrupt()')
		// #endif
		pendingLive2dSpeechUrls.value = []
	}

	function failEmbeddedAvatar() {
		clearEmbeddedAvatarRevealTimer()

		fallbackEmbeddedSpeech()
		interruptEmbeddedAvatar()
		embeddedAvatarLoaded.value = false
		embeddedAvatarFailed.value = true
	}

	function fallbackEmbeddedSpeech() {
		const text = activeEmbeddedSpeech.length > 0 ? activeEmbeddedSpeech : pendingEmbeddedSpeech
		activeEmbeddedSpeech = ''
		pendingEmbeddedSpeech = ''
		if (text.length > 0 && autoNarration.value && pageVisible) {
			playbackOwner.value = ''
			requestTts(text, speechRequest.id, true)
		}
	}

	function scheduleEmbeddedSpeechReset(text : string) {
		if (embeddedSpeechResetTimer != null) clearTimeout(embeddedSpeechResetTimer!)
		embeddedSpeechResetTimer = setTimeout(() => {
			embeddedSpeechResetTimer = null
			if (playbackOwner.value != 'cloud' || playbackState.value != 'RESPONDING') return
			interruptEmbeddedAvatar()
			playbackOwner.value = ''
			requestTts(text, speechRequest.id, true)
		}, 18000)
	}

	watch(reducedMotion, (reduce : boolean) => {
		// #ifdef MP-WEIXIN
		// Keep the loaded Cubism context. The native component pauses its RAF
		// while invisible and first mounts only after a visible measurement.
		if (!reduce) syncWeChatLive2dOverlay(true)
		// #endif
		if (reduce) {
			// A running renderer has no speech-position transfer. Stop its utterance
			// once; later answers can use host audio, including pause and resume.
			if (playbackOwner.value == 'cloud' || playbackOwner.value == 'live2d') stopNarration()
			resetEmbeddedAvatar(false)
			resetLive2dAvatar()
		} else if (pageVisible && initialized.value) {
			if (digitalHumanMode.value == 'xfyun') initializeEmbeddedAvatar(false)
			else initializeLive2dAvatar(false)
		}
	})

	function finishPlayback() {
		// #ifdef MP-WEIXIN
		stopSegmentAnalysis?.()
		stopSegmentAnalysis = null
		// #endif
		guideAudio.resetMeter()
		activeSubtitle.value = ''
		if (meterTimer != null) clearInterval(meterTimer!)
		meterTimer = null
		live2dSpeechSegments = []
		playbackOwner.value = ''
		playbackState.value = 'IDLE'
		digitalHumanState.value = 'idle'
		pendingLive2dSpeechUrls.value = []
	}

	function stopNarration() {
		speechRequest.begin()
		const owner = playbackOwner.value
		finishPlayback()
		if (owner == 'cloud') interruptEmbeddedAvatar()
		if (owner == 'live2d') interruptLive2dAvatar()
		if (embeddedSpeechResetTimer != null) clearTimeout(embeddedSpeechResetTimer!)
		embeddedSpeechResetTimer = null
		const player = audioContext.value
		audioContext.value = null
		player?.destroy()
		ttsQueue.value = []
		ttsQueueIndex.value = 0
	}

	function startHostQueue(segments : TtsSegment[]) {
		const generation = speechRequest.id
		if (segments.length == 0) { finishPlayback(); voiceError.value = '暂无可播放的音频'; return }
		playbackOwner.value = 'host'
		playbackState.value = 'RESPONDING'
		ttsQueue.value = segments
		ttsQueueIndex.value = 0
		// #ifdef WEB
		const player = createWebNarrationPlayer((level : number) => { if (generation == speechRequest.id) guideAudio.sample('playback', level) }) as InnerAudioContext
		// #endif
		// #ifndef WEB
		const player = uni.createInnerAudioContext()
		// #endif
		audioContext.value = player
		player.onPlay(() => {
			if (generation != speechRequest.id) return
			playbackState.value = 'PLAYING'
			digitalHumanState.value = 'speaking'
			if (ttsQueueIndex.value < ttsQueue.value.length) activeSubtitle.value = ttsQueue.value[ttsQueueIndex.value].text
			startSegmentMeter(player, generation)
		})
		player.onPause(() => {
			if (generation != speechRequest.id) return
			playbackState.value = 'PAUSED'
			digitalHumanState.value = 'idle'
			guideAudio.resetMeter()
			if (meterTimer != null) clearInterval(meterTimer!)
			meterTimer = null
		})
		player.onEnded(() => {
			if (generation != speechRequest.id) return
			ttsQueueIndex.value += 1
			playNextTtsSegment()
		})
		player.onError(() => {
			if (generation != speechRequest.id) return
			stopNarration()
			voiceError.value = '音频无法播放，可重试语音朗读'
		})
		playNextTtsSegment()
	}

	function startSegmentMeter(player : InnerAudioContext, generation : number) {
		// #ifndef WEB
		if (meterTimer != null) clearInterval(meterTimer!)
		const index = ttsQueueIndex.value
		if (index >= ttsQueue.value.length) return
		const segment = ttsQueue.value[index]
		let levels = segment.levels80ms ?? [] as number[]
		// #ifdef MP-WEIXIN
		stopSegmentAnalysis?.()
		stopSegmentAnalysis = null
		if (levels.length == 0) stopSegmentAnalysis = measureWechatSegment(resolveAssetUrl(segment.audioUrl), (found : number[]) => { levels = found })
		// #endif
		meterTimer = setInterval(() => {
			if (speechRequest.id != generation || index != ttsQueueIndex.value || levels.length == 0) return
			const frame = Math.floor(player.currentTime * 1000 / 80)
			if (frame >= 0 && frame < levels.length) guideAudio.sample('playback', levels[frame])
		}, 80)
		// #endif
	}

	function interruptTurn() {
		if (recording.value || capturePending.value || finishingRecording.value) { cancelRecording(); return }
		questionRequest.begin()
		sending.value = false
		stopNarration()
		guideAudio.cancelled.value = true
	}

	function playNextTtsSegment() {
		if (audioContext.value == null || ttsQueueIndex.value >= ttsQueue.value.length) {
			stopNarration()
			return
		}
		guideAudio.resetMeter()
		activeSubtitle.value = ''
		playbackState.value = 'RESPONDING'
		audioContext.value!.src = resolveAssetUrl(ttsQueue.value[ttsQueueIndex.value].audioUrl)
		audioContext.value!.play()
	}

	function togglePlayback() {
		if (playbackOwner.value != 'host') return
		if (playbackState.value == 'PAUSED') audioContext.value?.play()
		else if (playbackState.value == 'PLAYING') audioContext.value?.pause()
	}

	function readAloud(text : string) {
		if (!pageVisible || sending.value || recording.value || capturePending.value || finishingRecording.value) return
		stopNarration()
		guideAudio.beginAction()
		requestTts(text, speechRequest.id, true)
	}

	async function requestTts(text : string, generation : number, hostOnly : boolean) {
		if (generation != speechRequest.id || !pageVisible) return
		playbackState.value = 'RESPONDING'
		try {
			const result = await synthesizeSpeech(text, digitalHuman.value?.vcn ?? 'x6_jingqudaolannvsheng_mini', digitalHuman.value?.speechRate ?? 1, (abort : () => void) => { speechRequest.attach(generation, abort) })
			if (generation != speechRequest.id || !pageVisible) return
			speechRequest.complete(generation)
			if (!hostOnly && speakThroughLive2d(result.segments)) return
			startHostQueue(result.segments)
		} catch (error) {
			if (generation != speechRequest.id) return
			stopNarration()
			voiceError.value = '语音暂不可用，可阅读回答或稍后重试'
		}
	}

	function narrateAnswer(answer : string, generation : number, segments : TtsSegment[]) {
		if (!autoNarration.value || generation != speechRequest.id || !pageVisible) return
		playbackState.value = 'RESPONDING'
		if (speakThroughEmbeddedAvatar(answer)) return
		if (segments.length == 0) { requestTts(answer, generation, false); return }
		if (!speakThroughLive2d(segments)) startHostQueue(segments)
	}

	const conversationBusy = computed<boolean>(() => sending.value || recording.value || capturePending.value || finishingRecording.value || clearingHistory.value)

	function sendMessage() {
		submitQuestion(input.value.trim(), true)
	}

	async function submitQuestion(question : string, fromComposer : boolean) {
		if (question.length == 0 || !pageVisible || destroyed || conversationBusy.value) return
		const answerLocale = locale.value
		stopNarration()
		const generation = speechRequest.id
		const request = questionRequest.begin()
		guideAudio.beginAction()
		if (fromComposer) input.value = ''
		messages.value.push({ id: Date.now(), role: 'user', content: question, sources: [] })
		sending.value = true
		try {
			if (sessionId.value.length == 0) sessionId.value = await ensureVisitorSession()
			if (!pageVisible || request != questionRequest.id || destroyed) return
			const result = await askQuestion(question, sessionId.value, answerLocale, (abort : () => void) => { questionRequest.attach(request, abort) })
			if (!pageVisible || destroyed || request != questionRequest.id) return
			const sources = (result.sources ?? []).map<string>((source) : string => source.scenicSpotName ?? source.sectionTitle ?? source.documentName ?? '')
			messages.value.push({ id: Date.now() + 1, role: 'assistant', content: result.answer, kind: result.label ?? result.scenario ?? '', sources })
			narrateAnswer(result.answer, generation, [])
		} catch (error) {
			if (!pageVisible || destroyed || request != questionRequest.id) return
			voiceError.value = '暂时无法连接导游，检查网络后可重新发送'
			if (input.value.length == 0) input.value = question
		} finally {
			if (request == questionRequest.id) { questionRequest.complete(request); sending.value = false }
		}
	}

	async function submitRecordedVoice(filePath : string) {
		finishingRecording.value = false
		if (filePath.length == 0 || sending.value || !pageVisible || captureCancelled) return
		const answerLocale = locale.value
		const generation = speechRequest.id
		const request = questionRequest.begin()
		sending.value = true
		voiceError.value = ''
		try {
			if (sessionId.value.length == 0) sessionId.value = await ensureVisitorSession()
			if (captureCancelled || !pageVisible || request != questionRequest.id) return
			const result = await askVoice(filePath, sessionId.value, answerLocale, (abort : () => void) => { questionRequest.attach(request, abort) })
			if (!pageVisible || destroyed || request != questionRequest.id) return
			messages.value.push({ id: Date.now(), role: 'user', content: result.transcript, sources: [] })
			const sources = (result.answer.sources ?? []).map<string>((source) : string => source.scenicSpotName ?? source.sectionTitle ?? source.documentName ?? '')
			messages.value.push({ id: Date.now() + 1, role: 'assistant', content: result.answer.answer, kind: result.answer.label ?? result.answer.scenario ?? '', sources })
			const preferredVoice = digitalHuman.value?.vcn ?? ''
			narrateAnswer(result.answer.answer, generation, preferredVoice.length == 0 || result.tts.voice == preferredVoice ? result.tts.segments : [])
		} catch (error) {
			if (pageVisible && !destroyed && request == questionRequest.id) voiceError.value = '语音提问失败，可重新录音或使用文字'
		} finally {
			if (request == questionRequest.id) { questionRequest.complete(request); sending.value = false }
		}
	}

	async function restoreHistory() {
		const initialRequest = questionRequest.id
		if (sessionId.value.length == 0) sessionId.value = await ensureVisitorSession()
		const history = await fetchChatHistory(sessionId.value)
		if (destroyed || initialRequest != questionRequest.id || sending.value || messages.value.length > 0 || history.length == 0) return
		messages.value = history.map<ChatMessageItem>((item : ConversationMessage, index : number) : ChatMessageItem => ({
			id: Date.now() + index,
			role: item.role,
			content: item.content,
			kind: item.intentLabel ?? '',
			sources: []
		}))
	}

	function requestClearHistory() {
		if (!canClearHistory.value) return
		uni.showModal({
			title: g('清除对话记录'),
			content: g('将永久删除当前会话中的全部问答记录，此操作无法撤销。'),
			confirmText: g('确认清除'),
			confirmColor: themeColor('error'),
			cancelText: g('取消'),
			success: (result) => {
				if (result.confirm) clearConversationHistory()
			}
		})
	}

	async function clearConversationHistory() {
		if (!canClearHistory.value || sessionId.value.length == 0) return
		clearingHistory.value = true
		try {
			await clearChatHistory(sessionId.value)
			stopNarration()
			messages.value = []
			uni.showToast({ title: g('对话记录已清除'), icon: 'success' })
		} catch (error) {
			console.error('clear chat history failed', error)
			uni.showToast({ title: g('清除失败，请稍后重试'), icon: 'none' })
		} finally {
			clearingHistory.value = false
		}
	}

	function applyPendingPrompt() {
		if (!initialized.value || !pageVisible || destroyed || conversationBusy.value) return
		const prompt = consumeGuidePrompt()
		if (prompt.length == 0) return
		submitQuestion(prompt, false)
	}

	watch(conversationBusy, (busy : boolean) => {
		if (!busy) applyPendingPrompt()
	})

	function toggleNarration() {
		autoNarration.value = !autoNarration.value
		if (!autoNarration.value) stopNarration()
	}

	function resetCaptureFlags() {
		guideAudio.resetMeter()
		recording.value = false
		capturePending.value = false
		finishingRecording.value = false
	}

	function cancelRecording() {
		if ((capturePending.value || recording.value || finishingRecording.value) && pageVisible) guideAudio.cancelled.value = true
		captureCancelled = true
		captureRevision++
		// #ifdef WEB
		browserRecording?.stop(true)
		browserRecording = null
		resetCaptureFlags()
		// #endif
		// #ifndef WEB
		if (recording.value || capturePending.value || finishingRecording.value) {
			finishingRecording.value = true
			recorderManager.value?.stop()
		}
		// #endif
	}

	function captureError(message : string, unavailable : boolean = false) {
		resetCaptureFlags()
		if (!captureCancelled && pageVisible) {
			guideAudio.unavailable.value = unavailable
			voiceError.value = message
		}
	}

	function finishHeldRecording() {
		if (capturePending.value) { cancelRecording(); return }
		if (recording.value && !finishingRecording.value) toggleRecording()
	}

	function toggleRecording() {
		if (!initialized.value || sending.value || capturePending.value || finishingRecording.value || clearingHistory.value) return
		if (recording.value) {
			finishingRecording.value = true
			// #ifdef WEB
			browserRecording?.stop()
			// #endif
			// #ifndef WEB
			recorderManager.value?.stop()
			// #endif
			return
		}
		stopNarration()
		guideAudio.beginAction()
		const captureId = ++captureRevision
		captureCancelled = false
		capturePending.value = true
		// #ifdef WEB
		browserRecording = createWebRecording(() => { if (captureRevision == captureId) { capturePending.value = false; recording.value = true } }, () => {
			if (captureRevision != captureId) return
			recording.value = false
			finishingRecording.value = true
			guideAudio.resetMeter()
		}, async (url : string) => { if (captureRevision == captureId) await submitRecordedVoice(url) }, (message : string, unavailable : boolean) => { if (captureRevision == captureId) captureError(message, unavailable) }, (level : number) => { if (captureRevision == captureId) guideAudio.sample('microphone', level) })
		browserRecording!.start()
		// #endif
		// #ifdef MP-WEIXIN
		if (pcmCapture) {
			recorderManager.value?.start({ duration: 60000, format: 'PCM', sampleRate: 16000, numberOfChannels: 1, frameSize: 2 })
			return
		}
		// #endif
		// #ifndef WEB
		recorderManager.value?.start({ duration: 60000, format: 'mp3', sampleRate: 16000, numberOfChannels: 1, encodeBitRate: 48000 })
		// #endif
	}

	onLoad(async () => {
		// #ifdef MP-WEIXIN
		digitalHumanMode.value = 'live2d'
		setDigitalHumanRenderMode('live2d')
		// #endif
		// #ifndef WEB
		// #ifdef MP-WEIXIN
		recorderManager.value = createWechatRecorder() as RecorderManager
		// #endif
		// #ifndef MP-WEIXIN
		recorderManager.value = uni.getRecorderManager()
		// #endif
		recorderManager.value?.onStart(() => {
			capturePending.value = false
			if (captureCancelled || !pageVisible) { recorderManager.value?.stop(); return }
			recording.value = true
		})
		recorderManager.value?.onStop((result) => {
			resetCaptureFlags()
			if (!captureCancelled && pageVisible) submitRecordedVoice(result.tempFilePath)
		})
		recorderManager.value?.onError((error) => {
			const reason = error.errMsg.toLowerCase()
			// #ifdef MP-WEIXIN
			if (pcmCapture && capturePending.value && !captureCancelled && (reason.indexOf('format') >= 0 || reason.indexOf('pcm') >= 0)) {
				pcmCapture = false
				recorderManager.value?.start({ duration: 60000, format: 'mp3', sampleRate: 16000, numberOfChannels: 1, encodeBitRate: 48000 })
				return
			}
			// #endif
			captureError('麦克风无法使用，请检查录音权限')
			if (!captureCancelled && (reason.indexOf('auth') >= 0 || reason.indexOf('permission') >= 0 || reason.indexOf('denied') >= 0)) guideAudio.unavailable.value = true
		})
		// #ifdef MP-WEIXIN
		recorderManager.value?.onFrameRecorded((level) => {
			if (pcmCapture && !captureCancelled) guideAudio.sample('microphone', level as number)
		})
		recorderManager.value?.onInterruptionBegin(() => { cancelRecording() })
		// #endif
		// #endif
		initialized.value = true
		loadDigitalHumanPreference().then(() => {
			if (destroyed) return
			if (digitalHumanMode.value == 'xfyun') initializeEmbeddedAvatar(false)
			else initializeLive2dAvatar(false)
		})
		try { await restoreHistory() } catch (error) { console.error('restore chat history failed', error) }
		if (!destroyed && pageVisible) applyPendingPrompt()
	})

	// #ifdef APP-ANDROID
	function clearAndroidStageTimer() {
		if (androidStageTimer != null) clearTimeout(androidStageTimer!)
		androidStageTimer = null
	}

	function clearAndroidAttachTimer() {
		if (androidAttachTimer != null) clearTimeout(androidAttachTimer!)
		androidAttachTimer = null
	}

	function attachAndroidStage() {
		if (!androidPageLaidOut || !pageVisible || destroyed || androidStageReady.value || androidAttachTimer != null) return
		// A JS nextTick can precede the native view commit. Keep one full
		// native update between removing the old surface and attaching its URL.
		androidAttachTimer = setTimeout(() => {
			androidAttachTimer = null
			if (!pageVisible || destroyed) return
			androidStageReady.value = true
			if (androidStageRetried && live2dAvatarUrl.value.length == 0) initializeLive2dAvatar(false)
		}, 250)
	}

	function watchAndroidStageStart() {
		clearAndroidStageTimer()
		if (!pageVisible || !hasLive2dSurface.value || live2dAvatarPageLoaded.value || live2dAvatarLoaded.value) return
		// A cold Vapor tab can miss its initial WebView attachment. Retry the
		// view once if neither the document nor its native bridge ever answers.
		const url = live2dAvatarUrl.value
		androidStageTimer = setTimeout(() => {
			androidStageTimer = null
			if (destroyed || !pageVisible || !hasLive2dSurface.value || url != live2dAvatarUrl.value ||
				live2dAvatarPageLoaded.value || live2dAvatarLoaded.value) return
			if (androidStageRetried) {
				live2dAvatarFailed.value = true
				live2dAvatarRuntimeStatus.value = 'Live2D 页面加载失败'
				fallbackLive2dSpeech()
				return
			}
			androidStageRetried = true
			androidStageReady.value = false
			live2dAvatarUrl.value = ''
			live2dWebViewContext = null
			attachAndroidStage()
		}, androidStageRetried ? 20000 : 6000)
	}

	watch(hasLive2dSurface, () => { watchAndroidStageStart() })
	// #endif

	onShow(async () => {
		pageVisible = true
		orbPageActive.value = true
		if (stageLocale != locale.value) {
			stageLocale = locale.value
			resetEmbeddedAvatar(false)
			resetLive2dAvatar()
		}
		// #ifdef APP-ANDROID
		attachAndroidStage()
		if (hasLive2dSurface.value && live2dAvatarPageLoaded.value) {
			live2dWebViewContext?.evalJS('window.scenicLive2dPing && window.scenicLive2dPing()')
		}
		watchAndroidStageStart()
		// #endif
		if (initialized.value) {
			// #ifdef MP-WEIXIN
			digitalHumanMode.value = 'live2d'
			setDigitalHumanRenderMode('live2d')
			// #endif
			await loadDigitalHumanPreference()
			if (!pageVisible || destroyed) return
			if (digitalHumanMode.value == 'xfyun') await initializeEmbeddedAvatar(false)
			else await initializeLive2dAvatar(false)
			applyPendingPrompt()
		}
		syncWeChatLive2dOverlay(true)
	})

	onReady(() => {
		// #ifdef APP-ANDROID
		androidPageLaidOut = true
		attachAndroidStage()
		// #endif
		syncWeChatLive2dOverlay(true)
	})

	onHide(() => {
		// #ifdef APP-ANDROID
		clearAndroidStageTimer()
		clearAndroidAttachTimer()
		// #endif
		pageVisible = false
		orbPageActive.value = false
		if (sending.value) {
			questionRequest.begin()
			sending.value = false
		}
		// #ifdef MP-WEIXIN
		wechatLayoutRevision++
		wechatLive2dVisible.value = false
		// #endif
		cancelRecording()
		stopNarration()
	})

	onUnload(() => {
		destroyed = true
		// #ifdef APP-ANDROID
		clearAndroidStageTimer()
		clearAndroidAttachTimer()
		// #endif
		orbPageActive.value = false
		questionRequest.begin()
		syncRecordingClock(false)
		pageVisible = false
		cancelRecording()
		stopNarration()
		// #ifndef WEB
		recorderManager.value?.offStart()
		recorderManager.value?.offStop()
		recorderManager.value?.offError()
		// #ifdef MP-WEIXIN
		recorderManager.value?.offFrameRecorded()
		recorderManager.value?.offInterruptionBegin()
		// #endif
		// #endif
		embeddedAvatarGeneration += 1
		disposeEmbeddedAvatar()
		interruptLive2dAvatar()

		clearEmbeddedAvatarRevealTimer()
		if (embeddedSpeechResetTimer != null) clearTimeout(embeddedSpeechResetTimer!)
		embeddedSpeechResetTimer = null
		if (wechatLive2dSettleTimer != null) clearTimeout(wechatLive2dSettleTimer!)
		wechatLive2dSettleTimer = null
		avatarWebViewContext = null
	})

  import { getPreferredScenicArea } from '@/stores/guide-preferences.uts'
  import { consumeHistoryIntent, currentGuidePlace, queueMapSpot } from '@/stores/navigation-context.uts'
  import { spotPhoto } from '@/design/scenic-media.uts'
  import { guideStageMinHeight, guideStageMaxHeight, guideStageWindowFraction } from '@/design/palette.uts'
  const panel = ref('')
  const leavingGuide = ref(false)
  const holdingMic = ref(false)
  function setHolding(holding : boolean) { holdingMic.value = holding }
  const sheetPresent = ref(false)
  // Native EditText needs resolved theme colours for both the draft and its hint.
  const questionTextStyle = computed<string>(() => 'color:' + themeColor('text'))
  const questionPlaceholderStyle = computed<string>(() => 'color:' + themeColor('muted'))
  // #ifdef APP
  const nativeSheetStyle = ref('bottom:0px;')
  let keyboardListener : number | null = null
  let keyboardHeight = 0
  let unobstructedBottom = 0
  let initialScreenHeight = 0
  function nativePageBottom() : number {
    const page = messageScrollRef.value?.parentElement
    return page?.getBoundingClientRect().bottom ?? uni.getWindowInfo().windowHeight
  }
  function fitNativeKeyboard() {
    if (keyboardHeight <= 0) { nativeSheetStyle.value = 'bottom:0px;'; return }
    const rotatedBottom = unobstructedBottom + uni.getWindowInfo().screenHeight - initialScreenHeight
    const alreadyMoved = Math.max(0, rotatedBottom - nativePageBottom())
    nativeSheetStyle.value = 'bottom:' + Math.max(0, keyboardHeight - alreadyMoved) + 'px;'
  }
  function detachKeyboard() {
    if (keyboardListener != null) uni.offKeyboardHeightChange(keyboardListener!)
    keyboardListener = null
    keyboardHeight = 0
    nativeSheetStyle.value = 'bottom:0px;'
  }
  function observeTextKeyboard() {
    detachKeyboard()
    unobstructedBottom = nativePageBottom()
    initialScreenHeight = uni.getWindowInfo().screenHeight
    keyboardListener = uni.onKeyboardHeightChange((event) => {
      keyboardHeight = Math.max(0, event.height)
      fitNativeKeyboard()
    })
  }
  watch(panel, (name : string) => { if (name != 'text') detachKeyboard() })
  onResize(fitNativeKeyboard)
  onUnload(detachKeyboard)
  // #endif
  const voiceButtonActive = computed<boolean>(() => orbPageActive.value && !sheetPresent.value && !leavingGuide.value)
  const focusQuestion = computed<boolean>(() => {
    // H5 focuses the inner textarea after saving the trigger for keyboard return.
    // #ifdef WEB
    return false
    // #endif
    // #ifndef WEB
    return panel.value == 'text'
    // #endif
  })
  const panelBody = ref('')
  const areaId = ref<string>(getPreferredScenicArea())
  const suggestions = computed<string[]>(()=>['第一次来怎么玩', areaId.value == 'nianhuawan' ? '拈花塔有什么看点' : '大佛有什么故事', '推荐亲子路线', '哪些地方适合拍照'])
  const placeName = ref('')
  const placeId = ref('')
  const stageInView = ref(true)
  const viewportHeight = ref(uni.getWindowInfo().windowHeight)
  const stageHeight = computed<number>(()=>Math.max(guideStageMinHeight, Math.min(guideStageMaxHeight, Math.round(viewportHeight.value * guideStageWindowFraction))))
  watch(guideBarReady, (ready : boolean) => {
    if (ready) viewportHeight.value = uni.getWindowInfo().windowHeight
  })
  const orbDiameter = computed<number>(()=>viewportWidth.value < 350 ? 62 : 76)
  const areaLabel = computed<string>(()=>g(areaId.value == 'nianhuawan' ? '拈花湾' : '灵山胜境'))
  const locationLabel = computed<string>(()=>placeName.value.length > 0 ? areaLabel.value + ' · ' + placeName.value : areaLabel.value)
  const scenePhoto = computed<string>(()=>{
    const placePhoto=spotPhoto(placeId.value)
    return placePhoto.length>0 ? placePhoto : '/static/destinations/'+areaId.value+'.webp'
  })
  const stageName = computed<string>(()=>{
    if(digitalHuman.value?.engine != digitalHumanMode.value) return g('景区导游')
    const name=digitalHumanTitle.value.split('·')[0].split('（')[0].trim()
    return name.length>0 ? name : g('灵小游')
  })
  const stateLabel=computed<string>(()=>{
    switch(interactionState.value) {
      case 'LISTENING': return g('正在聆听')
      case 'THINKING': return voiceStatusText.value
      case 'SPEAKING': return g('正在讲解')
      case 'PAUSED': return g('播报已暂停')
      case 'RECONNECTING': return g('重新连接中')
      case 'DISABLED': return g('麦克风不可用')
      case 'CANCELLED': return g('已取消')
      case 'ERROR': return g('需要处理')
      default: return g('待机')
    }
  })
  const currentAnswer=computed<string>(()=>{
    for(let i=messages.value.length-1;i>=0;i--) {
      if(messages.value[i].role=='assistant') return messages.value[i].content
    }
    return ''
  })
  const pendingQuestion=computed<string>(()=>{
    const n=messages.value.length
    return sending.value && n>0 && messages.value[n-1].role=='user' ? messages.value[n-1].content : ''
  })
  const isWelcome=computed<boolean>(()=>currentAnswer.value.length==0 && !sending.value && !recording.value && !capturePending.value && voiceError.value.length==0 && activeSubtitle.value.length==0)
  const subtitleLabel=computed<string>(()=>g(isWelcome.value ? '点击或按住说话' : '导游字幕'))
  const subtitleBody=computed<string>(()=>{
    if(recording.value) return g(holdingMic.value ? '松开发送，上滑取消' : '再点一次发送录音')
    if(capturePending.value) return voiceStatusText.value
    if(sending.value && activeSubtitle.value.length==0) return voiceStatusText.value
    if(activeSubtitle.value.length>0) return activeSubtitle.value
    if(currentAnswer.value.length>0) return currentAnswer.value
    if(voiceError.value.length>0) return g('可以继续文字提问')
    return g('今天想怎么玩？')
  })
  const displaySubtitle=computed<string>(()=>{
    if(activeSubtitle.value.length>0) return subtitleBody.value
    const limit=locale.value=='en' ? 180 : 72
    return subtitleBody.value.length>limit ? subtitleBody.value.substring(0,limit)+'…' : subtitleBody.value
  })
  const showFullAnswer=computed<boolean>(()=>currentAnswer.value.length>0 && !sending.value && !recording.value)
  const panelTitle=computed<string>(()=>g(panelBody.value=='history' ? '对话记录' : (panelBody.value=='settings' ? '导游设置' : '文字提问')))
  function openPanel(next:string) {
    if(recording.value || capturePending.value) cancelRecording()
    // #ifdef APP
    if (next == 'text' && panel.value != 'text') observeTextKeyboard()
    // #endif
    sheetPresent.value=true
    panelBody.value=next
    panel.value=next
  }
  function closePanel() { panel.value=''; nextTick(()=>syncWeChatLive2dOverlay(true)) }
  function onNavigationLeave() {
    leavingGuide.value = true
    if (recording.value || capturePending.value || finishingRecording.value || sending.value || playbackState.value != 'IDLE') interruptTurn()
  }
  function toggleGuideMotion() { setReduceMotionPreference(!reduceMotionPreference.value) }
  function releaseSheet() { if(panel.value.length==0) sheetPresent.value=false }
  function readFromHistory(content:string) { closePanel(); readAloud(content) }
  function sendFromSheet() { if(input.value.trim().length==0 || conversationBusy.value) return; closePanel(); sendMessage() }
  function openContextMap() { if(placeId.value.length>0) queueMapSpot(placeId.value); uni.switchTab({url:'/pages/map/index'}) }
  function onSceneScroll(event:UniScrollEvent) { stageInView.value=event.detail.scrollTop<stageHeight.value; handleMessageScroll(event) }
  onShow(()=>{
    leavingGuide.value = false
    areaId.value=getPreferredScenicArea()
    const place=currentGuidePlace(areaId.value)
    placeId.value=place[0];placeName.value=place[1]
    if(consumeHistoryIntent()) openPanel('history')
  })
  onHide(()=>{ panel.value='' })
  onResize(()=>{viewportHeight.value=uni.getWindowInfo().windowHeight})
  // #ifdef APP
  onBackPress((_event):boolean=>{ if(panel.value.length==0) return false;closePanel();return true })
  // #endif


</script>
