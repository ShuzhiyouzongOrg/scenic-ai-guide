<script setup lang="uts">
	import { initializeDesignTheme } from '@/design/theme.uts'
	// #ifdef APP
	import { refreshAppTheme } from '@/design/theme.uts'
	// #endif
	import { initializeDesignMotion, refreshSystemMotion } from '@/design/motion.uts'
	import { initializeAppLocale } from '@/stores/locale.uts'
	// #ifndef WEB
	import { restoreNativeTabLocale } from '@/stores/locale.uts'
	// #endif

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		initializeDesignTheme()
		initializeDesignMotion()
		initializeAppLocale()
		// #ifdef APP
		uni.onAppThemeChange(() => { setTimeout(() => { restoreNativeTabLocale() }, 0) })
		// #endif
		// #ifdef MP-WEIXIN
		uni.onHostThemeChange(() => { setTimeout(() => { restoreNativeTabLocale() }, 0) })
		// #endif
		console.log('App Launch')
	})

	onAppShow(() => {
		// #ifdef APP
		refreshAppTheme()
		// #endif
		refreshSystemMotion()
		// #ifndef WEB
		nextTick(() => { restoreNativeTabLocale() })
		// #endif
		console.log('App Show')
	})

	onAppHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style lang="scss">
	@import '@/uni_modules/rice-ui/libs/style/index.css';

	page {
		background-color: $sg-background;
		color: $sg-text;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
	}

	.rice-theme-light, .rice-theme-dark {
		--rice-primary-color: #{$sg-primary};
		--rice-primary-color-1: #{$sg-inset};
		--rice-text-color: #{$sg-text};
		--rice-text-color-2: #{$sg-muted};
		--rice-border-color: #{$sg-border};
	}

	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}
</style>
