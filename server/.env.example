APP_NAME=Lingshan AI Guide
NODE_ENV=development
HOST=127.0.0.1
PORT=5178
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=replace-with-a-long-random-secret
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
# SQLite database file. Leave unset to let the server use ./data/scenic.sqlite.
# Test/eval scripts ignore this and run against an in-memory database.
SQLITE_PATH=./data/scenic.sqlite
# Default iFlytek interactive-avatar id / voice seeded into the digital-human config.
DEFAULT_AVATAR_ID=cnrmkf0e2000000006
DEFAULT_AVATAR_VCN=x6_jingqudaolannvsheng_mini
# Optional explicit path to the official behaviour analytics Excel.
BEHAVIOR_XLSX=../docs/scenic-materials/景点景区旅游数据行为分析数据.xlsx
DEMO_MODE=true
# Optional source repository and local media-mirror locations for the map-guide migration script.
MAP_GUIDE_SOURCE_DIR=../lingshan-miniapp-rebuild
MAP_GUIDE_MEDIA_OUTPUT_DIR=./data/map-guide-media
# LLM provider: "mock" (offline, no key needed) or "openai" (any OpenAI /chat/completions compatible endpoint)
# For a real cloud model set LLM_PROVIDER=openai and fill the values below.
#   DeepSeek:      LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
#   Qwen/DashScope LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   Moonshot:      LLM_BASE_URL=https://api.moonshot.cn/v1         LLM_MODEL=moonshot-v1-8k
#   OpenAI:        LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.4

# Optional managed RAG enhancement. Keep disabled until all values are configured.
# DashScope uses the workspace-specific Beijing endpoint for qwen3.7-text-embedding
# and qwen3-rerank. Qdrant stores only vectors and non-secret chunk metadata.
RAG_REMOTE_ENABLED=false
RAG_DASHSCOPE_WORKSPACE_ID=
RAG_DASHSCOPE_REGION=cn-beijing
# Optional: paste the API Host shown by Bailian, without a path. This takes precedence over workspace ID.
RAG_DASHSCOPE_API_HOST=
RAG_DASHSCOPE_API_KEY=
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BATCH_SIZE=10
RAG_EMBEDDING_ENDPOINT=
RAG_VECTOR_PROVIDER=qdrant
RAG_QDRANT_URL=
RAG_QDRANT_API_KEY=
RAG_QDRANT_COLLECTION=scenic_knowledge
RAG_DENSE_MIN_SCORE=0.35
RAG_RERANK_PROVIDER=dashscope
RAG_RERANK_MODEL=qwen3-rerank
RAG_RERANK_ENDPOINT=
RAG_RERANK_TIMEOUT_MS=1200
RAG_REMOTE_CANDIDATE_LIMIT=20
RAG_REMOTE_TIMEOUT_MS=3000
RAG_SUBQUERY_TIMEOUT_MS=4500
RAG_REMOTE_MAX_RETRIES=1
RAG_REMOTE_RETAIN_INDEX_VERSIONS=2
RAG_MIN_RULE_SCORE=12
RAG_MIN_BM25_SCORE=0.35
RAG_MIN_QUERY_COVERAGE=0
RAG_TRACE_SAMPLE_RATE=1
# Optional locale/intent threshold overrides, for example:
# {"zh":{"ticket":{"minRuleScore":14}},"th":{"default":{"minQueryCoverage":0.05}}}
RAG_THRESHOLD_PROFILES={}
KNOWLEDGE_ASYNC_INDEXING_ENABLED=false
KNOWLEDGE_INDEX_WORKER_BATCH=1
KNOWLEDGE_INDEX_MAX_ATTEMPTS=3
KNOWLEDGE_INDEX_LEASE_MS=60000
# Optional retrieval A/B experiment. It is disabled by default and therefore
# does not alter the current retrieval path. Use a new experiment ID after
# changing variants or thresholds so historical metrics are not mixed.
RAG_AB_ENABLED=false
RAG_AB_EXPERIMENT_ID=rag-retrieval-v1
RAG_AB_TREATMENT_PERCENT=10
RAG_AB_SALT=replace-with-a-long-random-experiment-salt
RAG_AB_MIN_SAMPLES=50
RAG_AB_MIN_FEEDBACK_SAMPLES=15
RAG_AB_MAX_P95_RATIO=1.5
RAG_AB_MAX_REFUSAL_RATE_INCREASE=0.10
RAG_AB_MAX_ACCEPTANCE_RATE_DROP=0.10
RAG_AB_MAX_COST_RATIO=1.5
# Optional USD prices per one million tokens. Leave 0 to compare token usage
# without reporting a monetary estimate.
RAG_AB_INPUT_COST_PER_MILLION=0
RAG_AB_OUTPUT_COST_PER_MILLION=0
RAG_AB_EMBEDDING_COST_PER_MILLION=0
# Optional cloud document parsing / OCR. Disabled by default. Install the
# official SDK only when enabling this path:
# npm install @alicloud/docmind-api20220711 @alicloud/tea-util
DOCUMENT_PARSER_ENABLED=false
DOCUMENT_PARSER_PROVIDER=aliyun_docmind
DOCUMENT_PARSER_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com
DOCUMENT_PARSER_REGION_ID=cn-hangzhou
DOCUMENT_PARSER_ACCESS_KEY_ID=
DOCUMENT_PARSER_ACCESS_KEY_SECRET=
DOCUMENT_PARSER_TIMEOUT_MS=10000
DOCUMENT_PARSER_POLL_INTERVAL_MS=3000
DOCUMENT_PARSER_MAX_ATTEMPTS=20
DOCUMENT_PARSER_LEASE_MS=120000
DOCUMENT_PARSER_LAYOUT_STEP_SIZE=100
DOCUMENT_PARSER_LLM_ENHANCEMENT=false
DOCUMENT_PARSER_ENHANCEMENT_MODE=VLM
DOCUMENT_PARSER_OUTPUT_FORMAT=markdown
DOCUMENT_PARSER_WORKER_BATCH=1
ASR_PROVIDER=mock
ASR_API_KEY=
XFYUN_ASR_HOST=iat-api.xfyun.cn
XFYUN_ASR_PATH=/v2/iat
XFYUN_ASR_TIMEOUT_MS=45000
TTS_PROVIDER=mock
TTS_API_KEY=
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_TTS_VOICE=x4_xiaoyan

# Controlled iFlytek interactive-avatar Web runtime. The three credential
# values may be omitted to reuse XFYUN_APP_ID/XFYUN_API_KEY/XFYUN_API_SECRET.
# Keep all credential values server-side; clients receive only a short-lived
# signed WebSocket URL through /api/digital-human/web/bootstrap.
XFYUN_AVATAR_APP_ID=
XFYUN_AVATAR_API_KEY=
XFYUN_AVATAR_API_SECRET=
XFYUN_AVATAR_SERVER_URL=wss://avatar.cn-huadong-1.xf-yun.com/v1/interact
XFYUN_AVATAR_SCENE_ID=
XFYUN_AVATAR_SCENE_VERSION=
XFYUN_AVATAR_SESSION_SECRET=replace-with-a-separate-long-random-secret
XFYUN_AVATAR_SESSION_TTL_SECONDS=180

# API key checklist for final competition deployment:
# 1. LLM_API_KEY: required only when LLM_PROVIDER=openai.
# 2. For iFlytek IAT, set ASR_PROVIDER=xfyun and fill XFYUN_APP_ID/XFYUN_API_KEY/XFYUN_API_SECRET.
# 3. For iFlytek TTS, set TTS_PROVIDER=xfyun and reuse the same three server-side credentials.
# 4. ASR_API_KEY/TTS_API_KEY are reserved for future non-iFlytek provider adapters and are not used by the current iFlytek implementation.
# Keep DEMO_MODE=true during rehearsals so the project can fall back to local deterministic answers/audio.
